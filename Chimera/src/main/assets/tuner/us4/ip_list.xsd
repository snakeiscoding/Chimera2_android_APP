<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="SourceType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="UDP" />
            <xs:enumeration value="RTP" />
            <xs:enumeration value="RF1" />
            <xs:enumeration value="RF2" />
            <xs:enumeration value="RF3" />
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="IPv4Address">
        <xs:annotation>
            <xs:documentation>IPv4 address in dot-decimal notation. Equivalent to [0-255].[0-255].[0-255].[0-255]</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="((1?[0-9]?[0-9]|2[0-4][0-9]|25[0-5])\.){3}(1?[0-9]?[0-9]|2[0-4][0-9]|25[0-5])" />
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="ChannelType">
        <xs:attribute name="ip" type="IPv4Address"/>
        <xs:attribute name="port" type="xs:integer"/>
        <xs:attribute name="source" type="SourceType" use="required"/>
        <xs:attribute name="enabled" type="xs:boolean" />
        <xs:attribute name="default" type="xs:boolean" />
        <xs:attribute name="chnumber" type="xs:integer" use="required"/>
        <xs:attribute name="name" type="xs:string" use="required"/>
        <xs:attribute name="major" type="xs:integer" />
        <xs:attribute name="minor" type="xs:integer" />
        <xs:attribute name="logicalNumber" type="xs:integer" />
        <xs:attribute name="programNumber" type="xs:integer" />
        <xs:attribute name="frequency" type="xs:integer" />
        <xs:attribute name="rfBroadcastType" type="xs:string" />
        <xs:attribute name="uuid" type="xs:string" />
    </xs:complexType>
    <xs:element name="IPTVChannels">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Channels">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Channel" type="ChannelType" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>