<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainContainer"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:id="@+id/space0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <Space
        android:layout_width="@dimen/top_bar_button_width"
        android:layout_height="@dimen/top_bar_height"
        android:id="@+id/space"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/dialog_container"
        android:background="@drawable/background_color_slate_blue"


        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/space"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/top_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.05"/>

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:src="@drawable/button_back_1"
            android:scaleType="centerInside"
            android:onClick="onHome"

            android:layout_marginLeft="10dp"
            app:layout_constraintTop_toBottomOf="@id/top_guideline"
            app:layout_constraintLeft_toLeftOf="parent"
            tools:ignore="UsingOnClickInXml" />



        <WebView
            android:id="@+id/message_text_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="40dp"
            android:layout_marginTop="40dp"
            app:layout_constraintWidth_percent=".8"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toTopOf="@id/acceptButton"/>

        <Button
            android:layout_width="0dp"
            android:layout_height="40dp"

            app:layout_constraintWidth_percent=".2"


            android:id="@+id/acceptButton"
            android:background="@color/white"
            android:text="@string/accept_tc"
            android:textSize="22dp"
            android:textColor="#000000"
            android:layout_marginBottom="40dp"

            app:layout_constraintTop_toBottomOf="@id/message_text_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"


            />
