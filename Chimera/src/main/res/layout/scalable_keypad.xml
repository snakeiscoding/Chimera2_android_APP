<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/keypad_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80FFFFFF"
    android:clickable="true"
    android:padding="20dp"
    tools:ignore="HardcodedText">


    <!--The layout for the value and label-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/output_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="1dp"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/key1_text_view"
        app:layout_constraintEnd_toEndOf="@id/key2_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/value_text_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@android:color/white"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.65"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.18" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_text_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:textColor="#808080"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.25"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.82" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--Back button-->
    <View
        android:id="@+id/keypad_backspace_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/keypad_delete_selector"
        app:layout_constraintBottom_toBottomOf="@id/output_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/key3_text_view"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_keypad_delete"
        app:layout_constraintBottom_toBottomOf="@id/keypad_backspace_button"
        app:layout_constraintDimensionRatio="1:0.65"
        app:layout_constraintEnd_toEndOf="@id/keypad_backspace_button"
        app:layout_constraintStart_toStartOf="@id/keypad_backspace_button"
        app:layout_constraintTop_toTopOf="@id/keypad_backspace_button"
        app:layout_constraintWidth_percent="0.1" />

    <!--First row of number keys-->
    <Button
        android:id="@+id/key1_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="1"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toTopOf="@id/key4_text_view"
        app:layout_constraintEnd_toStartOf="@id/key2_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/output_layout" />

    <Button
        android:id="@+id/key2_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="2"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toBottomOf="@id/key1_text_view"
        app:layout_constraintEnd_toStartOf="@id/key3_text_view"
        app:layout_constraintStart_toEndOf="@id/key1_text_view"
        app:layout_constraintTop_toTopOf="@id/key1_text_view" />

    <Button
        android:id="@+id/key3_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="1dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="3"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toBottomOf="@id/key1_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/key2_text_view"
        app:layout_constraintTop_toTopOf="@id/key1_text_view" />

    <!--Second row of number keys-->
    <Button
        android:id="@+id/key4_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="4"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toTopOf="@id/key7_text_view"
        app:layout_constraintEnd_toEndOf="@id/key1_text_view"
        app:layout_constraintStart_toStartOf="@id/key1_text_view"
        app:layout_constraintTop_toBottomOf="@id/key1_text_view" />

    <Button
        android:id="@+id/key5_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="5"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toBottomOf="@id/key4_text_view"
        app:layout_constraintEnd_toEndOf="@id/key2_text_view"
        app:layout_constraintStart_toStartOf="@id/key2_text_view"
        app:layout_constraintTop_toTopOf="@id/key4_text_view" />

    <Button
        android:id="@+id/key6_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="6"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toBottomOf="@id/key4_text_view"
        app:layout_constraintEnd_toEndOf="@id/key3_text_view"
        app:layout_constraintStart_toStartOf="@id/key3_text_view"
        app:layout_constraintTop_toTopOf="@id/key4_text_view" />

    <!--Third row of number keys-->
    <Button
        android:id="@+id/key7_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="7"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toTopOf="@id/key0_text_view"
        app:layout_constraintEnd_toEndOf="@id/key1_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/key4_text_view" />

    <Button
        android:id="@+id/key8_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="8"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toBottomOf="@id/key7_text_view"
        app:layout_constraintEnd_toEndOf="@id/key2_text_view"
        app:layout_constraintStart_toStartOf="@id/key2_text_view"
        app:layout_constraintTop_toTopOf="@id/key7_text_view" />

    <Button
        android:id="@+id/key9_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="9"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toBottomOf="@id/key7_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/key3_text_view"
        app:layout_constraintTop_toTopOf="@id/key7_text_view" />

    <!--Last row-->
    <Button
        android:id="@+id/key0_text_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/keypad_background_selector"
        android:gravity="center"
        android:text="0"
        android:textColor="@android:color/black"
        android:textSize="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/key1_text_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/key7_text_view" />

    <View
        android:id="@+id/keypad_select_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:padding="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/key2_text_view"
        app:layout_constraintTop_toTopOf="@id/key0_text_view" />

    <ImageView
        android:id="@+id/keypad_select_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/keypad_enter_selector"
        app:layout_constraintBottom_toBottomOf="@id/keypad_select_button"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@id/keypad_select_button"
        app:layout_constraintStart_toStartOf="@id/keypad_select_button"
        app:layout_constraintTop_toTopOf="@id/keypad_select_button"
        app:layout_constraintWidth_percent="0.15" />

</androidx.constraintlayout.widget.ConstraintLayout>