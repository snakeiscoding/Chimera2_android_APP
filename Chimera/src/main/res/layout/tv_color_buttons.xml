<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:background="#16FFFFFF"
    android:padding="10dp"
    android:layout_height="wrap_content"
    tools:ignore="RtlHardcoded">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/eng_tv_control_red"
        style="@style/tv_remote_button"
        android:background="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:srcCompat="@drawable/btn_function_red" />


    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/eng_tv_control_green"
        style="@style/tv_remote_button"
        android:background="@null"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_control_red"
        app:layout_constraintLeft_toLeftOf="parent"
        app:srcCompat="@drawable/btn_function_green" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/eng_tv_control_yellow"
        style="@style/tv_remote_button"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_control_green"
        app:layout_constraintLeft_toLeftOf="parent"
        android:background="@null"
        app:srcCompat="@drawable/btn_function_yellow" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/eng_tv_control_blue"
        style="@style/tv_remote_button"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_control_yellow"
        app:layout_constraintLeft_toLeftOf="parent"
        android:background="@null"
        app:srcCompat="@drawable/btn_function_blue" />

</androidx.constraintlayout.widget.ConstraintLayout>