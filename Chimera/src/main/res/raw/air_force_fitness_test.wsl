            while  workoutTimeSec > lookup_value
                i = i + 1
                temp_score = F_55_59_SCORE[i]
                lookup_value = F_55_59_VALUE[i]

        else if AGE > 59
                    i = 0
                    lookup_value = F_OVER_60_VALUE[i]
                    temp_score = F_OVER_60_SCORE[i]
                    while  workoutTimeSec > lookup_value
                        i = i + 1
                        temp_score = F_OVER_60_SCORE[i]
                        lookup_value = F_OVER_60_VALUE[i]
            
        TEST_SCORE_FEMALE = temp_score
    else
        TEST_SCORE = 0

