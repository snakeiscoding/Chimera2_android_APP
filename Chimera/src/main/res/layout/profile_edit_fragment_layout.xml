<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    >

    <!-- Left side bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/edit_sidebar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <RadioGroup
            android:id="@+id/user_type_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            >

            <RadioButton
                android:id="@+id/user_type_offline"
                style="@style/SettingsRadioButtons"
                android:layout_width="197dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:text="@string/offline_user_tc"
                />

            <RadioButton
                android:id="@+id/user_type_xid_update"
                style="@style/SettingsRadioButtons"
                android:layout_width="197dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:text="@string/update_user_tc"/>

            <RadioButton
                android:id="@+id/user_type_online"
                style="@style/SettingsRadioButtons"
                android:layout_width="197dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:text="@string/online_user_tc"
                />

            <RadioButton
                android:id="@+id/user_type_xid_new"
                style="@style/SettingsRadioButtons"
                android:layout_width="171dp"
                android:layout_height="40dp"
                android:layout_margin="6dp"
                android:text="@string/create_tc"
                android:layout_gravity="end"
                />

        </RadioGroup>

        <TextView
            android:id="@+id/user_information_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:maxLines="100"
            android:scrollHorizontally="false"
            android:textSize="16dp"
            android:text=""
            android:textColor="#FFF"
            app:layout_constraintTop_toBottomOf="@+id/user_type_radio_group"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_margin="20dp"
            tools:text="@string/online_user_description_pg"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Edit fields -->
    <TextView
        android:id="@+id/update_passcode"
        style="@style/TextTitle"
        android:textSize="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/passcode_invalid_pg"
        android:textAlignment="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/profile_edit_scroller"
        app:layout_constraintLeft_toLeftOf="@id/profile_edit_scroller"
        app:layout_constraintRight_toRightOf="@id/profile_edit_scroller"
        />

    <ScrollView
        android:id="@+id/profile_edit_scroller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@+id/update_passcode"
        app:layout_constraintLeft_toRightOf="@id/edit_sidebar"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/edit_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <com.jht.androiduiwidgets.edittext.UserTextInput
                app:min_chars="1"
                app:max_chars="65"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:nextFocusForward="@id/register_last_name_secondary"
                android:layout_height="wrap_content"
                app:input_type="text_input"
                app:secondary_id="@id/register_first_name_secondary"
                app:label="@string/first_name_tc"
                android:hint="@string/enter_first_name_tc"
                android:layout_marginTop="15dp"
                android:id="@+id/register_first_name"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/register_xid"
                app:error_message="below"
                />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                app:max_chars="14"
                app:min_chars="10"
                app:secondary_id="@id/register_xid_secondary"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:layout_height="wrap_content"
                app:input_type="number_input"
                app:label="@string/xid_tc"
                android:hint="@string/enter_xid_tc"
                android:layout_marginTop="15dp"
                android:id="@+id/register_xid"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/register_passcode_secondary"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/register_first_name"
                app:layout_constraintBottom_toTopOf="@id/register_email_address"
                app:error_message="below"
                />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                app:min_chars="1"
                app:max_chars="65"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/register_passcode_confirm_secondary"
                android:layout_height="wrap_content"
                app:input_type="email_input"
                app:label="@string/email_tc"
                android:hint="@string/email_address_tc"
                app:secondary_id="@id/register_email_secondary"
                android:layout_marginTop="15dp"
                android:id="@+id/register_email_address"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/register_xid"
                app:layout_constraintBottom_toTopOf="@id/register_birthdate"
                app:error_message="below"
                />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_percent="0.485"
                app:input_type="date"
                android:imeOptions="actionNext"
                app:label="@string/birthdate_tc"
                app:secondary_id="@id/register_birthdate_secondary"
                android:nextFocusForward="@id/register_weight_secondary"
                android:layout_marginTop="15dp"
                android:id="@+id/register_birthdate"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/register_email_address"
                app:layout_constraintBottom_toTopOf="@id/register_weight"
                app:error_message="below"
                />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                app:min_chars="1"
                app:max_chars="65"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                app:input_type="integer_input"
                android:imeOptions="actionDone"
                app:secondary_id="@id/register_weight_secondary"
                app:label="@string/weight_tc"
                android:hint="@string/lbs_lc"
                android:id="@+id/register_weight"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/register_birthdate"
                app:error_message="below"
                />

            <CheckBox
                style="@style/jht_checkbox"
                android:layout_alignParentStart="true"
                android:text="@string/accept_terms_and_condition_tc"
                android:textColor="#f5b324"
                android:textSize="24dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="0dp"
                android:id="@+id/register_accept_tc"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/register_weight"
                />

            <RelativeLayout
                android:id="@+id/user_remove"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="#ffff0000"
                app:layout_constraintWidth_percent="0.243"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/register_accept_tc"
                android:layout_marginTop="15dp"
                android:layout_marginRight="15dp"
                >
<!--                <ImageView-->
<!--                    app:srcCompat="@drawable/ic_close_circle_black"-->
<!--                    android:background="#ffff0000"-->
<!--                    android:tint="#FFF"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="match_parent"-->
<!--                    />-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/delete_user_tc"
                    android:textColor="#FFF"
                    android:gravity="center"
                    android:textSize="24dp"
                    android:textStyle="bold"
                    />
            </RelativeLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/split_guideline"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintGuide_percent="0.50"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:hint="@string/enter_last_name_tc"
                android:imeOptions="actionNext"
                app:input_type="text_input"
                app:label="@string/last_name_tc"
                app:layout_constraintWidth_percent="0.485"
                app:max_chars="65"
                app:min_chars="1"
                app:secondary_id="@id/register_last_name_secondary"
                android:id="@+id/register_last_name"
                app:layout_constraintLeft_toLeftOf="@id/split_guideline"
                app:layout_constraintTop_toTopOf="parent"
                app:error_message="below"
                />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                app:max_chars="4"
                app:min_chars="4"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:nextFocusForward="@id/register_email_secondary"
                android:imeOptions="actionDone"
                app:secondary_id="@id/register_passcode_secondary"
                android:layout_height="wrap_content"
                app:input_type="number_input"
                app:password="true"
                app:label="@string/passcode_tc"
                android:hint="@string/enter_passcode_tc"
                android:layout_marginTop="15dp"
                android:id="@+id/register_passcode"
                app:layout_constraintLeft_toLeftOf="@id/split_guideline"
                app:layout_constraintTop_toBottomOf="@+id/register_last_name"
                app:error_message="below"
                />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                app:max_chars="4"
                app:min_chars="4"
                android:imeOptions="actionNext"
                android:nextFocusForward="@id/register_birthdate_secondary"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:layout_height="wrap_content"
                app:secondary_id="@id/register_passcode_confirm_secondary"
                app:input_type="number_input"
                app:password="true"
                app:label="@string/confirm_passcode_2_tc"
                android:hint="@string/confirm_passcode_tc"
                android:layout_marginTop="15dp"
                android:id="@+id/register_confirm_passcode"
                app:layout_constraintLeft_toLeftOf="@id/split_guideline"
                app:layout_constraintTop_toBottomOf="@+id/register_passcode"
                app:error_message="below"
                />

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/registrationGenderSelector"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="15dp"
                app:label="@string/gender_tc"
                app:layout_constraintBottom_toBottomOf="@+id/register_birthdate"
                app:layout_constraintLeft_toLeftOf="@+id/split_guideline"
                app:layout_constraintTop_toBottomOf="@+id/register_confirm_passcode"
                app:layout_constraintWidth_percent="0.485"
                app:option_height="55dp"
                app:option_popup_constrain_to_anchor="bottom"
                app:option_popup_match_anchor_width="true"
                app:option_popup_width="350dp" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:id="@+id/placeholder2"
                app:layout_constraintLeft_toLeftOf="@id/split_guideline"
                app:layout_constraintTop_toBottomOf="@+id/registrationGenderSelector"
                app:error_message="below"
                android:visibility="invisible"
                />

            <TextView
                android:id="@+id/preferred_units_label_text_view"
                style="@style/TextTitle"
                android:textSize="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/units_tc"
                android:layout_marginTop="5dp"
                app:layout_constraintLeft_toLeftOf="@id/split_guideline"
                app:layout_constraintTop_toTopOf="@id/placeholder2"
                />
            <RadioGroup
                android:id="@+id/units_radio_group"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.485"
                android:layout_height="@dimen/user_text_info_text"
                android:orientation="horizontal"
                app:layout_constraintLeft_toLeftOf="@id/split_guideline"
                app:layout_constraintTop_toBottomOf="@+id/preferred_units_label_text_view"
                android:weightSum="2"
                >
                <RadioButton
                    android:id="@+id/units_metric_radio_button"
                    style="@style/SettingsRadioButtons"
                    android:layout_height="60dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/metric_tc"/>
                <RadioButton
                    android:id="@+id/units_imperial_radio_button"
                    style="@style/SettingsRadioButtons"
                    android:layout_height="60dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/imperial_tc"/>
            </RadioGroup>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/user_accept"
                app:srcCompat="@drawable/check"
                android:tint="#FFF"
                android:background="#3F9C47"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintWidth_percent="0.243"
                android:layout_marginTop="15dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/placeholder2"
                android:layout_marginRight="15dp"
                />

            <ImageView
                android:id="@+id/register_user_spinner"
                style="?android:attr/progressBarStyle"
                android:src="@drawable/icon_spinner"
                android:contentDescription="@null"
                android:layout_margin="20dp"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:layout_constraintWidth_percent="0.243"
                android:layout_marginTop="15dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/units_radio_group"
                android:visibility="gone"
                android:layout_marginRight="15dp"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>