<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <ScrollView
        android:id="@+id/dialog_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#40e6e6e6"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="400dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <CheckBox
                        android:id="@+id/network_ip_settings_dialog_dhcp"
                        style="@style/engCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/dhcp1_ac" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_ip_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="@string/tuner_ip_address_tc" />


                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_subnet_mask"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="@string/subnet_mask_tc" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/mac_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="8dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="@string/tuner_mac_address_tc" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="78dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="8dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="Version" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="400dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">


                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_ip_gateway"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="@string/gateway_tc" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dns1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="DNS 1" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dns2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="DNS 2" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/network_ip_settings_save"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/standard_button"
                        android:text="@string/save_eth0_tc"
                        android:textColor="#FF000000" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/network_ip_settings_cancel"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/standard_button"
                        android:text="@string/cancel_tc"
                        android:textColor="#FF000000" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/reboot"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/standard_button"
                        android:text="@string/reboot_stb_tc"
                        android:textColor="#FF000000" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/factory_reset"
                        android:layout_width="150dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/standard_button"
                        android:text="@string/factory_reset_tc"
                        android:textColor="#FF000000"
                        android:visibility="gone" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
