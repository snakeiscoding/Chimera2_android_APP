settings
    workout_id = 55
    allow_skip_warmup = 1
    allow_skip_workout = 1
    graph_future = 0
    allow_user_goal_changes = 0

input FLOORS_GOAL_START
input GOAL
input START_RESISTANCE
input COOLDOWN_TIME_START
input FLOORS

export RESISTANCE
export GOAL
export GOAL_TYPE
export PREVENT_USER_GOAL_CHANGES

stage "workout"
    interval
        PREVENT_USER_GOAL_CHANGES = 1
        RESISTANCE = START_RESISTANCE
        GOAL_TYPE = GOAL_TYPE_FLOORS_STAGE_CONSTANT
        GOAL = FLOORS_GOAL_START
        
        when STAGE_FLOORS >= GOAL
            interval = interval + 1
            
stage "cooldown"
    interval
        PREVENT_USER_GOAL_CHANGES = 0
        RESISTANCE = 1
        GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
        GOAL = COOLDOWN_TIME_START
        
        when INTERVAL_TIME_MS >= GOAL
            end