<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ui_lcd_update"
    android:layout_width="240dp"
    android:layout_height="320dp"
    android:background="#000000">


    <TextView
        android:id="@+id/update_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Downloading..."
        android:gravity="center"
        android:textSize="20dp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/update_spinner" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/update_spinner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/update_text"
        app:layout_constraintWidth_percent="0.42"
        app:srcCompat="@drawable/ic_p1_spinner" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:srcCompat="@drawable/ic_icon_download_white"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintWidth_percent="0.25"
        app:layout_constraintBottom_toBottomOf="@id/update_spinner"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/update_spinner" />

</androidx.constraintlayout.widget.ConstraintLayout>