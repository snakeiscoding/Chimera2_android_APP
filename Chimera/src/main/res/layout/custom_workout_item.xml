<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/background_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/custom_workout_list_selector"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_item_text"
        app:layout_constraintEnd_toEndOf="@id/delete_button"
        app:layout_constraintStart_toStartOf="@id/custom_workout_item_text"
        app:layout_constraintTop_toTopOf="@id/custom_workout_item_text" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/custom_workout_item_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:hint="@string/my_workout_tc"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="15dp"
        android:text=""
        android:textColor="@color/category_item_text"
        android:textColorHint="@color/category_item_text"
        android:textSize="@dimen/custom_workout_recycler_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="4.75:1"
        app:layout_constraintEnd_toStartOf="@id/delete_button"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75"
        tools:ignore="SpUsage"
        android:clickable="false"
        android:focusable="false"
        android:layout_marginBottom="10dp"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/delete_item_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#00000000"
        app:layout_constraintHeight_percent="0.45"
        android:padding="2dp"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="@id/delete_button"
        app:layout_constraintBottom_toBottomOf="@id/delete_button"
        app:layout_constraintStart_toStartOf="@id/delete_button"
        app:layout_constraintEnd_toEndOf="@id/delete_button"
        app:srcCompat="@drawable/ic_trash_can"
        android:visibility="invisible" />

    <Button
        android:id="@+id/delete_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#00000000"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_item_text"
        app:layout_constraintTop_toTopOf="@id/custom_workout_item_text"
        app:layout_constraintStart_toEndOf="@id/custom_workout_item_text"
        app:layout_constraintEnd_toEndOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>