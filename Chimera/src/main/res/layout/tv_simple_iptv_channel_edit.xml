<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#85000000" >

    <RelativeLayout
        android:id="@+id/dialog_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:background="#40e6e6e6">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:padding="10dp">

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/iptv_channel_address"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/address_tc"
                app:input_type="ip_address_input"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/iptv_channel_port"
                app:layout_constraintTop_toTopOf="parent"
                android:inputType="textNoSuggestions"/>

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/iptv_channel_port"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/port_tc"
                app:input_type="integer_input"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                app:layout_constraintLeft_toRightOf="@id/iptv_channel_address"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:inputType="textNoSuggestions"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/message_dialog_ok"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iptv_channel_address"
                app:layout_constraintRight_toLeftOf="@id/message_dialog_cancel"
                android:background="@drawable/message_dialog_box_button_yes" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/message_dialog_cancel"
                android:background="@drawable/message_dialog_box_button_no"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toRightOf="@id/message_dialog_ok"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iptv_channel_address"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>

</RelativeLayout>
