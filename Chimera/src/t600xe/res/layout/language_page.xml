<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.jht.chimera.ui.machinesetup.MachineSetup">

    <RelativeLayout
        style="@style/jht_standard_container"
        android:layout_height="match_parent"
        android:layout_width="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.48"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/language_selector"
            style="@style/jht_standard_inner_recycle_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF575E65"
            />
    </RelativeLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_height="wrap_content"
        android:layout_width="0dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.45"
        >

        <com.jht.chimera.lib.widget.selector.OptionSelectorItem
            android:id="@+id/machine_setup_timezone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:label="@string/time_zone_tc"
            app:option_options="@array/timezoneDisplay"
            app:option_popup_height="600dp"
            app:option_popup_width="500dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/machine_setup_time_format_option"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="10dp"/>

        <com.jht.chimera.lib.widget.radiogroup.RadioGroup
            android:id="@+id/machine_setup_time_format_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:layout_constraintTop_toBottomOf="@id/machine_setup_timezone"
            app:layout_constraintBottom_toTopOf="@id/machine_setup_current_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            app:label="@string/time_format_tc" />

        <TextView
            android:id="@+id/machine_setup_current_time"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="24dp"
            android:textColor="@android:color/white"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/machine_setup_time_format_option"
            app:layout_constraintBottom_toTopOf="@id/machine_setup_date_format"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="10dp"
            />

        <com.jht.chimera.lib.widget.selector.OptionSelectorItem
            android:id="@+id/machine_setup_date_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:label="@string/dateformat_tc"
            app:layout_constraintTop_toBottomOf="@id/machine_setup_current_time"
            app:layout_constraintBottom_toTopOf="@id/machine_setup_current_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="10dp"
            app:option_popup_width="400dp" />

        <TextView
            android:id="@+id/machine_setup_current_date"
            android:layout_height="wrap_content"
            android:textSize="24dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:layout_width="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/machine_setup_date_format"
            app:layout_constraintBottom_toTopOf="@id/default_units"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
                />

        <com.jht.chimera.lib.widget.radiogroup.RadioGroup
            android:id="@+id/default_units"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:label="@string/units_tc"

            app:layout_constraintTop_toBottomOf="@id/machine_setup_current_date"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.constraintlayout.widget.ConstraintLayout>
