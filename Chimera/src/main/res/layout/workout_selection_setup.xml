<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workout_selection_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/workout_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.63"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/gradient_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/workout_background"
        app:layout_constraintEnd_toEndOf="@id/workout_background"
        app:layout_constraintTop_toTopOf="@id/workout_background"
        app:layout_constraintBottom_toBottomOf="@id/workout_background"
        android:background="@drawable/shield_gradient"
        android:contentDescription="@null"
        />

    <com.jht.chimera.ui.mainapp.goscreen.DiagonalView
        android:id="@+id/diagonal_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:degree="175"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".4909"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical_title_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/workout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Intervals"
        android:textSize="@dimen/workout_title"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toEndOf="@id/vertical_title_guideline"
        app:layout_constraintBottom_toTopOf="@id/workout_text"
        android:textStyle="bold"
        tools:ignore="HardcodedText,SpUsage" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/workout_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Intervals"
        android:textSize="@dimen/workout_description"
        android:paddingBottom="20dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="@id/workout_title"
        app:layout_constraintEnd_toEndOf="@id/stat_setup_2"
        app:layout_constraintBottom_toTopOf="@id/stat_setup_1"
        tools:ignore="HardcodedText,SpUsage" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical_guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.65" />

    <com.jht.chimera.ui.mainapp.goscreen.WorkoutSetup.WorkoutInfoBox
        android:id="@+id/workout_info_box"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/stat_setup_2"
        app:layout_constraintStart_toEndOf="@id/stat_setup_2"
        android:layout_marginStart="20dp"
        android:visibility="visible"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontal_stat_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="227dp" />

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/stat_setup_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintWidth_percent="0.265"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintStart_toStartOf="@id/workout_title"
        app:layout_constraintTop_toBottomOf="@id/horizontal_stat_guideline"
        app:layout_constraintBottom_toTopOf="@id/stat_setup_3"
        android:visibility="visible"/>

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/stat_setup_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintWidth_percent="0.265"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintStart_toEndOf="@id/stat_setup_1"
        app:layout_constraintEnd_toEndOf="@id/vertical_guideline_start"
        app:layout_constraintTop_toTopOf="@id/stat_setup_1"
        app:layout_constraintBottom_toBottomOf="@id/stat_setup_1"
        android:visibility="visible"/>

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/stat_setup_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintEnd_toEndOf="@id/stat_setup_1"
        app:layout_constraintStart_toStartOf="@id/workout_title"
        app:layout_constraintTop_toBottomOf="@id/stat_setup_1"
        app:layout_constraintBottom_toTopOf="@id/stat_setup_5"
        android:visibility="visible"/>

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/stat_setup_4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintWidth_percent="0.265"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintStart_toStartOf="@id/stat_setup_2"
        app:layout_constraintEnd_toEndOf="@id/stat_setup_2"
        app:layout_constraintTop_toTopOf="@id/stat_setup_3"
        app:layout_constraintBottom_toBottomOf="@id/stat_setup_3"
        android:visibility="visible"/>

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/stat_setup_5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintEnd_toEndOf="@id/stat_setup_1"
        app:layout_constraintStart_toStartOf="@id/stat_setup_1"
        app:layout_constraintTop_toBottomOf="@id/stat_setup_3"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="visible"/>

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/stat_setup_6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintWidth_percent="0.265"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintStart_toStartOf="@id/stat_setup_2"
        app:layout_constraintEnd_toEndOf="@id/stat_setup_2"
        app:layout_constraintTop_toTopOf="@id/stat_setup_5"
        app:layout_constraintBottom_toBottomOf="@id/stat_setup_5"
        android:visibility="visible"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/start_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/start_workout_tc"
        android:padding="15dp"
        app:autoSizeTextType="uniform"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/start_selector"
        app:layout_constraintBottom_toBottomOf="@id/stat_setup_5"
        app:layout_constraintDimensionRatio="W,1:3.19"
        app:layout_constraintStart_toEndOf="@id/stat_setup_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.192" />

    <include
        layout="@layout/max_hr_instructions_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintWidth_percent="0.448"
        app:layout_constraintTop_toTopOf="@+id/stat_setup_1"
        app:layout_constraintBottom_toBottomOf="@+id/start_button"
        app:layout_constraintStart_toEndOf="@+id/vertical_title_guideline" />

    <com.jht.chimera.ui.mainapp.goscreen.GenderRadioButton
        android:id="@+id/gender_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:2"
        app:layout_constraintWidth_percent="0.265"
        app:layout_constraintTop_toTopOf="@id/stat_setup_3"
        app:layout_constraintStart_toStartOf="@id/stat_setup_3"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>