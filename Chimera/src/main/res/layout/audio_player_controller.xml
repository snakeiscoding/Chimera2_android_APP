<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context="com.jht.chimera.ui.mymedia.AudioPlayerController">

    <fragment
        android:id="@+id/audio_browser"
        android:name="com.jht.chimera.ui.mymedia.MediaBrowser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent=".40"
        tools:layout="@layout/media_browser"
        tools:ignore="FragmentTagUsage" />

    <fragment
        android:id="@+id/audio_player_view"
        android:name="com.jht.chimera.ui.mymedia.AudioPlayerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/audio_browser"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_min="400dp"
        app:layout_constraintWidth_percent=".60"
        tools:layout="@layout/audio_player_view"
        tools:ignore="FragmentTagUsage"/>

</androidx.constraintlayout.widget.ConstraintLayout>
