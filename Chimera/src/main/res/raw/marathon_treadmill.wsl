settings
    workout_id = 77
    allow_skip_warmup = 0
    allow_skip_workout = 0
    graph_future = 0
    allow_user_goal_changes = 0

input START_SPEED
input START_INCLINE

export SPEED
export INCLINE
export GOAL_TYPE

stage "workout"
    interval
        SPEED = START_SPEED
        INCLINE = START_INCLINE
        GOAL_TYPE = GOAL_TYPE_NONE_CONSTANT