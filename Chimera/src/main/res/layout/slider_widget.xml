<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="horizontal">


        <com.jht.chimera.lib.widget.ScrollViewNoTouch
            android:id="@+id/sliderScrollView"
            android:layout_width="wrap_content"
            android:layout_height="340dp"
            android:layout_marginTop="72dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="80dp"
                    android:layout_height="265dp" />

                <LinearLayout
                    android:id="@+id/sliderNumberButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#40e6e6e6"
                    android:clickable="true"
                    android:orientation="vertical">

                    <com.jht.chimera.lib.widget.selectron.SelectronButton
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="4dp"
                        android:clickable="false"
                        app:drawableBackground="@android:color/transparent"
                        app:drawableIcon="@drawable/ic_keypad_gray"
                        app:iconHeight="20dp"
                        app:iconWidth="20dp" />

                    <TextView
                        android:id="@+id/sliderValueText"
                        android:layout_width="80dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="#ffe6e6e6"
                        android:gravity="center"
                        android:lines="1"
                        android:textColor="#ff000000"
                        android:textSize="28dp"
                        android:textStyle="bold" />
                </LinearLayout>


                <View
                    android:layout_width="80dp"
                    android:layout_height="265dp" />

            </LinearLayout>

        </com.jht.chimera.lib.widget.ScrollViewNoTouch>

        <LinearLayout
            android:layout_width="94dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="472dp"
                android:background="#50808080"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="312dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/sliderwidget_backplate_markers" />

                <LinearLayout
                    android:id="@+id/sliderLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="448dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/sliderPlusButton"
                        android:layout_width="72dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/volume_button_bg"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:tint="#000000"
                        app:srcCompat="@drawable/ic_plus_white" />

                    <com.jht.chimera.lib.widget.slider.VerticalSeekBar
                        android:id="@+id/sliderSeekbar"
                        android:layout_width="94dp"
                        android:layout_height="304dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="44dp"
                        android:splitTrack="false" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/sliderMinusButton"
                        android:layout_width="72dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/volume_button_bg"
                        android:scaleType="fitCenter"
                        android:tint="#000000"
                        app:srcCompat="@drawable/ic_minus_white"
                        android:padding="15dp"/>
                </LinearLayout>


            </RelativeLayout>

            <LinearLayout
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp">

                <!-- This is the text caption box. -->
                <TextView
                    android:id="@+id/sliderBarCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center_horizontal|top"
                    android:maxLines="2"
                    android:textColor="@android:color/white"
                    android:textSize="18dp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>