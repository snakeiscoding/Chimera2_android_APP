<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="140dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    tools:ignore="SpUsage">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/error_code_count_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/error_code_time_stamp_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.40" />
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/error_code_description_guideline"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.60" />


        <CheckBox
            android:id="@+id/select_error"
            style="@style/GeneralEngineeringCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="15dp"
            tools:ignore="RtlHardcoded" />

        <TextView
            android:id="@+id/ec_row_error_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/errorcode_tc"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintLeft_toRightOf="@id/select_error"
            app:layout_constraintRight_toRightOf="@id/error_code_count_guideline"
            app:layout_constraintTop_toTopOf="@id/select_error"
            app:layout_constraintBottom_toBottomOf="@id/select_error" />

        <TextView
            android:id="@+id/ec_row_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/count_tc"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/error_code_count_guideline"
            app:layout_constraintRight_toRightOf="@id/error_code_time_stamp_guideline"
            app:layout_constraintTop_toTopOf="@id/select_error"
            app:layout_constraintBottom_toBottomOf="@id/select_error" />

        <TextView
            android:id="@+id/ec_row_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/date_tc"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/error_code_time_stamp_guideline"
            app:layout_constraintRight_toRightOf="@id/error_code_description_guideline"
            app:layout_constraintTop_toTopOf="@id/select_error"
            app:layout_constraintBottom_toBottomOf="@id/select_error" />

        <TextView
            android:id="@+id/ec_row_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/description_tc"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="@id/error_code_description_guideline"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/select_error"
            app:layout_constraintBottom_toBottomOf="@id/select_error" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>
