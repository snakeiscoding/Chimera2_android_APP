            android:scrollbarThumbVertical="@drawable/listview_vertical_scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/listview_vertical_scrollbar_track"
            android:scrollbarStyle="outsideOverlay"
            android:fadeScrollbars="false"
            android:choiceMode="singleChoice" />

        <ProgressBar
            android:id="@+id/mediaListProgress"
            android:layout_width="100dp"
