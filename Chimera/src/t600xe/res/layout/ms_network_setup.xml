<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/machine_setup_import_wifi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ms_network_wireless_selection_container"
        app:layout_constraintWidth_percent=".3"
        android:layout_marginTop="20dp"
        android:background="@drawable/standard_button"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/import_wifi_settings_tc"
        android:textColor="#FF000000"
        android:singleLine="false"
        android:textSize="18dp"
        app:srcCompat="@drawable/back_button" />


    <RelativeLayout
        style="@style/jht_standard_container"
        android:id="@+id/ms_network_wireless_selection_container"
        android:layout_width="400dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="10dp"
        android:layout_centerInParent="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ms_network_wireless_selection_hidden_container"

        >


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ms_network_wireless_selection"
            style="@style/jht_standard_inner_recycle_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF575E65"
            />
    </RelativeLayout>

    <View
        android:id="@+id/ms_network_wireless_selection_hidden_container"
        android:layout_width="400dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ms_network_wireless_selection_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
