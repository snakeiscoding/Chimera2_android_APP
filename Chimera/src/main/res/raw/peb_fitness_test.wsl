MALE_VALUES_5 = [627, 672, 704, 730, 760, 780, 806, 828, 852, 874, 896, 920, 944, 972, 998, 1035, 1079, 1146, 1239, 7200]
MALE_VALUES_6 = [675, 719, 758, 788, 811, 838, 864, 892, 917, 937, 960, 982, 1010, 1038, 1070, 1105, 1143, 1198, 1310, 7200]
MALE_VALUES_7 = [723, 777, 815, 848, 871, 895, 923, 947, 967, 993, 1015, 1036, 1062, 1097, 1130, 1160, 1196, 1262, 1365, 7200]
MALE_VALUES_8 = [768, 814, 858, 897, 942, 969, 990, 1014, 1044, 1063, 1084, 1108, 1147, 1180, 1208, 1250, 1285, 1355, 1440, 7200]
