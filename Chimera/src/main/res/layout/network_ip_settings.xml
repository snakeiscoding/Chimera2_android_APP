<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#85000000">

    <ScrollView
        android:id="@+id/dialog_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#40e6e6e6"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="400dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <CheckBox
                        android:id="@+id/network_ip_settings_dialog_dhcp"
                        style="@style/engCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="10dp"
                        android:text="@string/dhcp1_ac" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_ip_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="@string/ip_address_tc" />

                    <com.jht.androiduiwidgets.selector.OptionSelectorItem
                        android:id="@+id/network_ip_settings_dialog_subnet_mask"
                        style="@style/GeneralEngineeringOptionSelector"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="10dp"

                        app:label="@string/subnet_mask_tc"
                        app:option_options="@array/subnet_addresses_options"
                        app:option_popup_height="500dp"
                        app:option_popup_width="200dp"
                        app:option_values="@array/subnet_addresses_options" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_ip_gateway"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="@string/gateway_tc" />

                    <TextView
                        style="@style/EngineeringNetworkSettingsHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="5dp"

                        android:gravity="start"
                        android:text="@string/dns_servers_tc" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/network_ip_settings_dialog_dnslist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp" />

                    <ImageButton
                        android:id="@+id/network_ip_settings_dialog_add_dns"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/standard_button"
                        android:contentDescription="@null"
                        android:src="@drawable/icon_plus" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_ip_domain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="Domain" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="400dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <CheckBox
                        android:id="@+id/network_ip_settings_dialog_proxy"
                        style="@style/engCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="10dp"
                        android:text="@string/proxy_tc" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_proxy_pac"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="PAC URL" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_proxy_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="text_input"
                        app:label="@string/host_tc" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/network_ip_settings_dialog_proxy_port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:inputType="textNoSuggestions"
                        app:input_type="integer_input"
                        app:label="@string/port_tc" />

                    <TextView
                        style="@style/EngineeringNetworkSettingsHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="5dp"

                        android:gravity="start"
                        android:text="@string/excludes_tc" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/network_ip_settings_dialog_exclude_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp" />

                    <ImageButton
                        android:id="@+id/network_ip_settings_dialog_add_exclude"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/standard_button"
                        android:contentDescription="@null"
                        android:src="@drawable/icon_plus" />


                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/network_ip_settings_save"
                        android:layout_width="175dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/standard_button"
                        android:text="@string/save_eth0_tc"
                        android:textColor="#FF000000" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/network_ip_settings_reset"
                        android:layout_width="175dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/standard_button"
                        android:text="@string/reset_tc"
                        android:textColor="#FF000000" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <Button
                        android:id="@+id/network_ip_settings_cancel"
                        android:layout_width="175dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/standard_button"
                        android:text="@string/cancel_tc"
                        android:textColor="#FF000000" />
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
