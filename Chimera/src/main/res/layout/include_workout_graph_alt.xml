<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/graphLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias=".5"
        app:layout_constraintVertical_bias=".97"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintHeight_percent=".16"
        android:animateLayoutChanges="true"
        android:visibility="visible"
        >

        <com.jht.chimera.lib.graph.GraphLegendWidget
            android:id="@+id/graph_left_legend_widget"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_vertical|left"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent=".75"
            app:layout_constraintHorizontal_bias=".015"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintWidth_percent=".1" />

        <com.jht.chimera.lib.graph.GraphLegendWidget
            android:id="@+id/graph_top_legend_widget"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_vertical|left"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent=".3"
            app:layout_constraintHorizontal_bias=".6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintWidth_percent=".8" />


        <com.jht.chimera.lib.widget.athena.NewWorkoutGraph
            android:id="@+id/workout_graph"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="visible"

            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent=".65"
            app:layout_constraintHorizontal_bias=".6"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias=".93"
            app:layout_constraintWidth_percent=".8" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/graphExpandContractButton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/icon_chart_hide"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintHeight_percent=".04"
        app:layout_constraintHorizontal_bias=".98"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias=".96" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/workoutModeText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textColor="#30909090"
        android:text="@string/warmup_tc"
        android:textSize="80dp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintHeight_percent=".2"
        app:layout_constraintHorizontal_bias=".5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias=".97" />
    />
</merge>