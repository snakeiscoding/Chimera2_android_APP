<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#85000000">

    <RelativeLayout
        android:id="@+id/dialog_container"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="90dp"
        android:background="#40e6e6e6">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:padding="10dp"
            android:orientation="vertical">
            <TextView
                style="@style/GeneralEngineeringTextHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_service_entry_tc"/>
            <TextView
                style="@style/GeneralEngineeringTextValue"
                android:id="@+id/service_log_entry_service_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"/>
            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/service_log_entry_description"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                app:label="@string/description_tc"
                app:input_type="text_input"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:layout_gravity="center"
                android:gravity="center"
                app:multiline="true"
                android:layout_marginBottom="20dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">
                    <Button
                        android:layout_width="175dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:id="@+id/service_log_entry_create"
                        android:background="@drawable/standard_button"
                        android:textColor="#FF000000"
                        android:text="@string/create_tc" />
                </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                        <Button
                            android:layout_width="175dp"
                            android:layout_height="40dp"
                            android:layout_centerInParent="true"
                            android:id="@+id/service_log_entry_cancel"
                            android:textColor="#FF000000"
                            android:background="@drawable/standard_button"
                            android:text="@string/cancel_tc" />
                    </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
