<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/eng_tv_settings_channel"
        style="@style/GeneralEditTextStringEngineering"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_margin="5dp"
        android:gravity="center"
        app:auto_correct="true" />

    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/eng_tv_settings_name"
        style="@style/GeneralEditTextStringEngineering"
        android:layout_width="@dimen/iptv_channel_name_size"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_margin="5dp"
        android:imeOptions="actionDone"
        android:gravity="center"
        app:auto_correct="true" />


    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/eng_tv_settings_url"
        style="@style/GeneralEditTextStringEngineering"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_margin="5dp"
        android:imeOptions="actionDone"
        android:gravity="center"
        app:auto_correct="true" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/eng_tv_channel_remove"
        style="@style/tv_remote_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@id/eng_tv_default_channel_selector"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/message_dialog_box_button_no" />

</LinearLayout>