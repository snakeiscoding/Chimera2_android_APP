<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ui_workout_left_informative"
    android:layout_width="240dp"
    android:layout_height="320dp"
    android:background="@android:color/black">

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/arrow_up"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintDimensionRatio="1:1"
        app:srcCompat="@drawable/ic_plus_yellow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.02"
        app:layout_constraintTop_toTopOf="parent" />

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/arrow_down"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintDimensionRatio="1:1"
        app:srcCompat="@drawable/ic_minus_yellow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.98"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/lock_circle_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_lock_screen"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@id/lock_circle"
        app:layout_constraintEnd_toEndOf="@id/lock_circle"
        app:layout_constraintTop_toTopOf="@id/lock_circle"
        app:layout_constraintBottom_toBottomOf="@id/lock_circle"
        />

    <ProgressBar
        android:id="@+id/lock_circle"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:max="2000"
        android:progress="0"
        android:progressDrawable="@drawable/ic_lock_circle" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:srcCompat="@drawable/ic_incline_yellow"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintBottom_toTopOf="@id/value"
        app:layout_constraintStart_toStartOf="@id/lock_circle_background"
        app:layout_constraintEnd_toEndOf="@id/lock_circle_background"/>

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="0"
        android:textSize="64dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/lock_circle_background"
        app:layout_constraintStart_toStartOf="@id/lock_circle_background"
        app:layout_constraintEnd_toEndOf="@id/lock_circle_background"
        app:layout_constraintBottom_toBottomOf="@id/lock_circle_background"/>

    <TextView
        android:id="@+id/unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="unit"
        android:textSize="17dp"
        android:textColor="#80FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/value"
        app:layout_constraintStart_toStartOf="@id/lock_circle_background"
        app:layout_constraintEnd_toEndOf="@id/lock_circle_background" />
</androidx.constraintlayout.widget.ConstraintLayout>