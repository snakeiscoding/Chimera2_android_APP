<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messageBoxMainLayout"
    android:layout_width="550dp"
    android:layout_height="match_parent"
    android:background="#33FFFFFF"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#e6e6e6"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.jht.chimera.lib.widget.textview.AutofitTextView
            android:id="@+id/messageBoxTitleTextView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:padding="25dp"
            android:textColor="@android:color/black"
            android:textSize="40sp" />

        <com.jht.chimera.lib.widget.selectron.SelectronButton
            android:id="@+id/messageBoxCloseImageButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:drawableBackground="#e6e6e6"
            app:drawableIcon="@drawable/ic_close_white"
            app:drawableIconTint="#000000"
            app:iconHeight="60dp"
            app:iconWidth="60dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1A1A1A"
        android:orientation="vertical">

        <TextView
            android:id="@+id/messageBoxInfoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginRight="60dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:textSize="20sp" />


        <!-- Image buttons container -->
        <LinearLayout
            android:id="@+id/imageButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Button 0 -->
            <com.jht.chimera.lib.widget.selectron.SelectronButton
                android:id="@+id/imageButton0"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="32dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:drawableBackground="#e1271b" />

            <!-- Button 1 -->
            <com.jht.chimera.lib.widget.selectron.SelectronButton
                android:id="@+id/imageButton1"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                app:drawableBackground="#3f9d47" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>