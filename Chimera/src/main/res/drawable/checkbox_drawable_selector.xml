<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_activated="false"
        android:state_checked="true"
        android:state_pressed="true">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_state_active"/>
                    <stroke android:color="@android:color/black" android:width="2dp" />
                </shape>
            </item>
            <item android:width="36dp" android:height="36dp"
                android:drawable="@drawable/ic_check_black"
                android:gravity="center">
            </item>
        </layer-list>
    </item>

    <item android:state_activated="false"
        android:state_checked="true"
        android:state_pressed="false">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <stroke android:color="@android:color/black" android:width="2dp" />
                </shape>
            </item>
            <item android:width="36dp" android:height="36dp"
                android:drawable="@drawable/ic_check_black"
                android:gravity="center">
            </item>
        </layer-list>
    </item>

    <item android:state_activated="false"
        android:state_checked="false"
        android:state_pressed="true">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_state_active"/>
                    <stroke android:color="@android:color/black" android:width="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_activated="false"
        android:state_checked="false"
        android:state_pressed="false">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <stroke android:color="@android:color/black" android:width="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>


    <item android:state_activated="true"
        android:state_checked="true"
        android:state_pressed="true">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_state_active"/>
                </shape>
            </item>
            <item android:width="36dp" android:height="36dp"
                android:drawable="@drawable/ic_check_black"
                android:gravity="center">
            </item>
        </layer-list>
    </item>

    <item android:state_activated="true"
        android:state_checked="true"
        android:state_pressed="false">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_stat"/>
                </shape>
            </item>
            <item android:width="36dp" android:height="36dp"
                android:drawable="@drawable/ic_check_black"
                android:gravity="center">
            </item>
        </layer-list>
    </item>

    <item android:state_activated="true"
        android:state_checked="false"
        android:state_pressed="true">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_state_active"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_activated="true"
        android:state_checked="false"
        android:state_pressed="false">
        <layer-list>
            <item android:width="40dp" android:height="40dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_stat"/>
                </shape>
            </item>
        </layer-list>
    </item>



</selector>