export INCLINE
export GOAL_TYPE
export GOAL
export INTERVAL_GOAL
export INTERVAL_GOAL_TYPE
export PREVENT_USER_GOAL_CHANGES

// Specific for Sprint8
export NEXT_SPEED
export NEXT_INCLINE
export IS_RAMPING
