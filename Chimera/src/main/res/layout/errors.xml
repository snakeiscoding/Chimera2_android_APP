<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/EngineeringPage">

    <CheckBox
        android:id="@+id/persistent_logs"
        style="@style/GeneralEngineeringCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/persistent_logging_tc"
        tools:ignore="RtlHardcoded" />

    <Button
        android:id="@+id/save_logs_usb"
        style="@style/GeneralEngineeringButton"
        android:layout_width="200dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/save_logs_tc" />

    <Button
        android:id="@+id/logging_options"
        style="@style/GeneralEngineeringButton"
        android:layout_width="200dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/save_logs_usb"
        android:text="@string/logging_options_uc" />

    <TextView
        android:id="@+id/persistent_logs_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/persistent_logs"
        app:layout_constraintBottom_toTopOf="@id/logs_linebreak"
        app:layout_constraintLeft_toLeftOf="@id/persistent_logs"
        android:textSize="18dp"
        tools:ignore="SpUsage" />

    <View
        android:id="@+id/logs_linebreak"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/engineering_line_break"
        app:layout_constraintTop_toBottomOf="@id/logging_options"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"/>

    <Button
        android:id="@+id/delete_logs"
        style="@style/GeneralEngineeringButton"
        android:layout_width="200dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logs_linebreak"
        android:text="@string/delete_tc" />

    <Button
        android:id="@+id/save_error_logs"
        style="@style/GeneralEngineeringButton"
        android:layout_width="200dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logs_linebreak"
        android:text="@string/export_errors_tc" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/delete_logs"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp"
        android:background="#33FFFFFF">
        <com.jht.chimera.ui.machinesettings.pages.error.ErrorLogRow
            android:id="@+id/error_code_header"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="29dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/error_code_log_list"
            style="@style/jht_standard_inner_recycle_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/error_code_header"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
