<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/EngineeringPage"
    android:padding="0dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_source_column"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_wireless_audio_column">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tv_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_tv_icon"
            android:layout_marginTop="20dp"
            android:scaleType="fitCenter"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/tv_icon"
            app:layout_constraintBottom_toBottomOf="@id/tv_icon"
            app:layout_constraintStart_toEndOf="@id/tv_icon"
            android:text="@string/tv_uc"
            android:textSize="25dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:layout_marginStart="5dp"
            tools:ignore="SpUsage" />

        <com.jht.androiduiwidgets.selector.OptionSelectorItem
            android:id="@+id/eng_tv_source_selection"
            style="@style/GeneralEngineeringOptionSelector"
            android:layout_width="300dp"
            app:layout_constraintTop_toBottomOf="@id/tv_icon"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            app:label="@string/source_selection_tc"
            app:option_popup_width="400dp" />


        <Button
            android:id="@+id/eng_tv_check_for_updates"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:padding="10dp"
            android:text="@string/update_from_usb_tc"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_source_selection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <CheckBox
            android:id="@+id/eng_tv_use_cab"
            style="@style/GeneralEngineeringCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_check_for_updates"
            app:layout_constraintStart_toStartOf="parent"
            android:text="@string/cab_uc"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/defaultChannelContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_use_cab"
            app:layout_constraintStart_toStartOf="parent" >

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_tv_default_channel_selector_1"
                style="@style/GeneralEngineeringOptionSelector"
                android:layout_width="300dp"
                app:label="@string/default_tv_channel_tc"
                app:option_popup_width="400dp" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_tv_player_default_channel_input_1"
                style="@style/GeneralEditTextStringEngineering"
                android:layout_width="280dp"
                android:padding="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:layout_gravity="center"
                android:gravity="center"
                app:label="@string/default_tv_channel_tc"
                android:imeOptions="actionDone"
                app:min_value="0" />

        </RelativeLayout>


        <com.jht.androiduiwidgets.selector.OptionSelectorItem
            android:id="@+id/eng_tv_settop_box_selection"
            android:layout_width="300dp"
            app:option_popup_width="300dp"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/defaultChannelContainer"
            android:layout_height="wrap_content"
            app:label="@string/set_top_box_tc"/>

        <Button
            android:id="@+id/eng_stb_tv_import"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_settop_box_selection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:padding="20dp"
            android:text="@string/import_set_top_box_configuration_tc" />


        <com.jht.androiduiwidgets.edittext.UserTextInput
            android:id="@+id/eng_tv_player_over_screen_size"
            style="@style/GeneralEditTextIntEngineering"
            android:padding="0dp"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eng_stb_tv_import"
            android:imeOptions="actionDone"
            app:label="@string/over_scan_size_tc"
            app:min_value="0"
            app:max_value="20"/>

        <com.jht.androiduiwidgets.selector.OptionSelectorItem
            android:id="@+id/eng_tv_player_aspect_ratio"
            style="@style/GeneralEngineeringOptionSelector"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_player_over_screen_size"
            app:label="@string/aspect_ratio_mode_tc"
            app:option_popup_width="400dp" />


    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_wireless_audio_column"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/tv_source_column"
        app:layout_constraintEnd_toStartOf="@id/tv_channel_setup_column">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/remove_tv_icon"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_remote_tv_icon"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="@id/remove_tv_icon"
            app:layout_constraintBottom_toBottomOf="@id/remove_tv_icon"
            app:layout_constraintStart_toEndOf="@id/remove_tv_icon"
            android:text="@string/remote_tv_tc"
            android:textSize="25dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:layout_marginStart="5dp"
            tools:ignore="SpUsage" />

        <CheckBox
            android:id="@+id/eng_remote_tv"
            style="@style/GeneralEngineeringCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/remove_tv_icon"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            android:text="@string/wireless_audio_tc" />

        <com.jht.androiduiwidgets.edittext.UserTextInput
            android:id="@+id/eng_remote_tv_channel"
            style="@style/GeneralEditTextIntEngineering"
            app:layout_constraintTop_toBottomOf="@id/eng_remote_tv"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="300dp"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"

            app:label="@string/wireless_audio_default_channel_tc"
            app:max_value="20"
            app:min_value="1" />

        <com.jht.androiduiwidgets.edittext.UserTextInput
            android:id="@+id/eng_remote_tv_volume"
            style="@style/GeneralEditTextIntEngineering"
            app:layout_constraintTop_toBottomOf="@id/eng_remote_tv_channel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            app:label="@string/wireless_audio_volume_tc"
            app:max_value="100"
            app:min_value="0" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_channel_setup_column"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/tv_wireless_audio_column"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/eng_tv_configure"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:padding="20dp"
            android:text="@string/tv_channel_setup_tc" />

        <CheckBox
            android:id="@+id/eng_tv_use_sap"
            style="@style/GeneralEngineeringCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_configure"
            app:layout_constraintStart_toStartOf="parent"
            android:text="@string/use_sap_channel_list_pg" />

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
