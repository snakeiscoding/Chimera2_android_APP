<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stat_item_split_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewSplitTitle"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:autoSizeMaxTextSize="20dp"
        app:autoSizeMinTextSize="12dp"
        app:autoSizeTextType="uniform"
        android:fontFamily="sans-serif"
        android:gravity="center|top"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingLeft="17dp"
        android:paddingRight="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/calories_uc"
        android:textColor="#666666"
        android:textStyle="bold"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewSplitValue"
        android:layout_width="0dp"
        android:layout_height="35dp"
        app:autoSizeMaxTextSize="35dp"
        app:autoSizeMinTextSize="20dp"
        app:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="0"
        android:textColor="#333333"
        android:textStyle="bold"
        tools:ignore="HardcodedText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintTop_toBottomOf="@id/textViewSplitTitle"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewSplitSubtitle"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:autoSizeMaxTextSize="20dp"
        app:autoSizeMinTextSize="12dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintStart_toStartOf="@id/textViewSplitValue"
        app:layout_constraintEnd_toEndOf="@id/textViewSplitValue"
        app:layout_constraintTop_toBottomOf="@id/textViewSplitValue"
        android:fontFamily="sans-serif"
        android:gravity="center|top"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:text="@string/active_uc"
        android:textColor="#666666"
        android:textStyle="bold"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewSplitValue2"
        android:layout_width="0dp"
        android:layout_height="35dp"
        app:autoSizeMaxTextSize="35dp"
        app:autoSizeMinTextSize="20dp"
        app:autoSizeTextType="uniform"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="0"
        android:textColor="#333333"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.5"
        app:layout_constraintTop_toBottomOf="@id/textViewSplitTitle"
        tools:ignore="HardcodedText" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewSplitSubtitle2"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:autoSizeMaxTextSize="20dp"
        app:autoSizeMinTextSize="12dp"
        app:autoSizeTextType="uniform"
        android:fontFamily="sans-serif"
        android:gravity="center|bottom"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:text="@string/total_uc"
        android:textColor="#666666"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/textViewSplitValue2"
        app:layout_constraintEnd_toEndOf="@id/textViewSplitValue2"
        app:layout_constraintTop_toBottomOf="@id/textViewSplitValue2"/>

    <View
        android:id="@+id/split_stat_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:background="#ff666666"
        app:layout_constraintTop_toBottomOf="@id/textViewSplitTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/textViewSplitSubtitle"
        />

</androidx.constraintlayout.widget.ConstraintLayout>