<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ui_featured_workouts"
    android:layout_width="240dp"
    android:layout_height="320dp"
    android:background="@android:color/black">

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/featured_workout_1_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintWidth_percent="0.92"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/featured_workout_2_button"
        tools:background="@drawable/gradient_sprint_8"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/featured_workout_1_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="@id/featured_workout_1_button"
        app:layout_constraintEnd_toEndOf="@id/featured_workout_1_button"
        app:layout_constraintTop_toTopOf="@id/featured_workout_1_button"
        app:layout_constraintBottom_toBottomOf="@id/featured_workout_1_button"
        tools:srcCompat="@drawable/ic_sprint_8_logo"
        />

    <TextView
        android:id="@+id/featured_workout_1_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:textSize="28sp"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="@id/featured_workout_1_button"
        app:layout_constraintEnd_toEndOf="@id/featured_workout_1_button"
        app:layout_constraintTop_toTopOf="@id/featured_workout_1_button"
        app:layout_constraintBottom_toBottomOf="@id/featured_workout_1_button"
        tools:text="@string/landmarks_tc"
        />

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/featured_workout_2_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintWidth_percent="0.92"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featured_workout_1_button"
        app:layout_constraintBottom_toTopOf="@id/featured_workout_3_button"
        tools:background="@drawable/gradient_ymca"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/featured_workout_2_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="@id/featured_workout_2_button"
        app:layout_constraintEnd_toEndOf="@id/featured_workout_2_button"
        app:layout_constraintTop_toTopOf="@id/featured_workout_2_button"
        app:layout_constraintBottom_toBottomOf="@id/featured_workout_2_button"
        tools:srcCompat="@drawable/ic_ymca_logo"
        />

    <TextView
        android:id="@+id/featured_workout_2_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:textSize="28sp"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="@id/featured_workout_2_button"
        app:layout_constraintEnd_toEndOf="@id/featured_workout_2_button"
        app:layout_constraintTop_toTopOf="@id/featured_workout_2_button"
        app:layout_constraintBottom_toBottomOf="@id/featured_workout_2_button"
        tools:text="@string/landmarks_tc"
        />

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/featured_workout_3_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintWidth_percent="0.92"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featured_workout_2_button"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:background="@drawable/gradient_ifit"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/featured_workout_3_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintStart_toStartOf="@id/featured_workout_3_button"
        app:layout_constraintEnd_toEndOf="@id/featured_workout_3_button"
        app:layout_constraintTop_toTopOf="@id/featured_workout_3_button"
        app:layout_constraintBottom_toBottomOf="@id/featured_workout_3_button"
        tools:srcCompat="@drawable/ic_ifit_logo"
        />

    <TextView
        android:id="@+id/featured_workout_3_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:textSize="28sp"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="@id/featured_workout_3_button"
        app:layout_constraintEnd_toEndOf="@id/featured_workout_3_button"
        app:layout_constraintTop_toTopOf="@id/featured_workout_3_button"
        app:layout_constraintBottom_toBottomOf="@id/featured_workout_3_button"
        tools:text="@string/landmarks_tc"
        />

</androidx.constraintlayout.widget.ConstraintLayout>