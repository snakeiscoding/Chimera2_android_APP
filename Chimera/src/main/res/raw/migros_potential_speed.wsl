settings
    workout_id = 58
    allow_skip_warmup = 1
    allow_skip_workout = 1
    graph_future = 1
    allow_user_goal_changes = 0

input LEVEL
input GOAL
input MIN_SPEED
input MAX_SPEED

export SPEED
export GOAL
export GOAL_TYPE
export PREVENT_USER_GOAL_CHANGES
export INCLINE

TIME_BEGINNER = [4, 1, 4, 1, 4, 1]
TIME_ADVANCED = [4, 4, 3, 4, 3, 4, 3, 4]

intervalDuration = 4

stage "workout"
    PREVENT_USER_GOAL_CHANGES = 1
    GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
    
    currentIntervalType = 0
    SPEED = MIN_SPEED
    intervalDuration = 99 // Large number, gets overwritten in first interval
    
    when INTERVAL_TIME_MS >= intervalDuration * 60000
        // Switching interval, alternate between low and high
        if (currentIntervalType == 0)
            currentIntervalType = 1
            SPEED = MAX_SPEED
        else
            currentIntervalType = 0
            SPEED = MIN_SPEED
            
        interval = interval + 1
    
    
    level "beginner"
        GOAL = 15 * 60 * 1000 // There are 15 minutes of intervals
        setIntervals intervalDuration = TIME_BEGINNER
    
    level "advanced"
        GOAL = 29 * 60 * 1000 // There are 29 minutes of intervals
        setIntervals intervalDuration = TIME_ADVANCED
        

stage "cooldown"
    interval
        SPEED = MIN_SPEED
        GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
        GOAL = 4 * 60 * 1000
        INCLINE = 0

        when INTERVAL_TIME_MS >= GOAL
            end