<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#50808080"/>
                </shape>
            </item>

            <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="12dp">
                <shape android:shape="rectangle">
                    <solid android:color="#000000"/>
                </shape>
            </item>

            <item android:top="13dp" android:left="13dp" android:right="13dp" android:bottom="13dp">
                <shape android:shape="rectangle">
                    <solid android:color="#b3b3b3"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#50808080"/>
                </shape>
            </item>

            <item android:top="12dp" android:left="12dp" android:right="12dp" android:bottom="12dp">
                <shape android:shape="rectangle">
                    <solid android:color="#000000"/>
                </shape>
            </item>

            <item android:top="13dp" android:left="13dp" android:right="13dp" android:bottom="13dp">
                <shape android:shape="rectangle">
                    <solid android:color="#e6e6e6"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>