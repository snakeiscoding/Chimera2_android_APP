<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_settings_window"
    android:background="@drawable/background_color_slate_blue"
    style="@style/EngineeringPage"
    tools:ignore="SpUsage, RtlHardcoded, RtlSymmetry" >

    <include layout="@layout/machine_settings_top_bar"
        android:id="@+id/error_details_top_bar"/>

    <View
        android:id="@+id/error_details_left_bar"
        android:layout_width="80dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/error_details_top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:background="#1E1E1E" />
    
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/error_code_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:srcCompat="@drawable/back_button"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:background="@drawable/standard_button"
        app:tint="@color/standard_button_tint"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="@id/error_details_left_bar"
        app:layout_constraintRight_toRightOf="@id/error_details_left_bar"
        app:layout_constraintTop_toBottomOf="@id/error_details_top_bar"/>
    
    <TextView
        android:id="@+id/error_code_heading"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/white"
        android:textColor="@color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:paddingLeft="30dp"
        app:layout_constraintTop_toBottomOf="@id/error_details_top_bar"
        app:layout_constraintLeft_toRightOf="@id/error_details_left_bar"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/error_code_heading"
        app:layout_constraintLeft_toLeftOf="@id/error_code_heading"
        app:layout_constraintRight_toRightOf="@id/error_code_heading"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scrollbars="vertical"
        android:scrollbarSize="5dp"
        android:scrollbarStyle="outsideInset"
        android:scrollbarTrackVertical="@color/scrollbar_track"
        android:scrollbarThumbVertical="@color/scrollbar_thumb"
        android:fadeScrollbars="false"
        android:background="#99000000"
        android:layout_marginBottom="20dp" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/ec_detail_count_header"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:textStyle="bold"
                android:text="@string/count_tc" />

            <TextView
                android:id="@+id/ec_detail_time_header"
                android:layout_width="265dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toRightOf="@id/ec_detail_count_header"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:textStyle="bold"
                android:text="@string/time_tc" />

            <TextView
                android:id="@+id/ec_detail_details_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toRightOf="@id/ec_detail_time_header"
                app:layout_constraintRight_toRightOf="parent"
                android:layout_marginRight="30dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:textStyle="bold"
                android:text="@string/details_tc" />

            <View
                android:id="@+id/ec_detail_linebreak"
                android:layout_marginTop="15dp"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:background="@drawable/engineering_line_break"
                app:layout_constraintTop_toBottomOf="@id/ec_detail_count_header"
                app:layout_constraintLeft_toLeftOf="@id/ec_detail_count_header"
                app:layout_constraintRight_toRightOf="@id/ec_detail_details_header"/>


            <TextView
                android:id="@+id/ec_detail_count"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ec_detail_linebreak"
                app:layout_constraintLeft_toLeftOf="@id/ec_detail_count_header"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:text="@string/count_tc" />

            <TextView
                android:id="@+id/ec_detail_time"
                android:layout_width="265dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ec_detail_linebreak"
                app:layout_constraintLeft_toLeftOf="@id/ec_detail_time_header"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:text="@string/time_tc" />

            <TextView
                android:id="@+id/ec_detail_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ec_detail_linebreak"
                app:layout_constraintLeft_toLeftOf="@id/ec_detail_details_header"
                app:layout_constraintRight_toRightOf="@id/ec_detail_details_header"
                android:layout_marginTop="20dp"
                android:textColor="@color/white"
                android:textSize="18dp"
                android:text="@string/details_tc" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>