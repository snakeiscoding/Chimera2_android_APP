<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="10dp"
        android:top="10dp">
        <shape>
            <solid android:color="@color/title_bar_background" />
            <corners android:radius="2dp" />
            <stroke
                android:color="@android:color/white"
                android:width="4dp" />
            <size
                android:width="30dp"
                android:height="30dp" />
        </shape>
    </item>

    <item
        android:bottom="10dp"
        android:right="10dp">
        <shape>
            <solid android:color="@color/title_bar_background" />
            <corners android:radius="2dp" />
            <stroke
                android:color="@android:color/white"
                android:width="4dp" />
            <size
                android:width="30dp"
                android:height="30dp" />
        </shape>
    </item>
</layer-list>