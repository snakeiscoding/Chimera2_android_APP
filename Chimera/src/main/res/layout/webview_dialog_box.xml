<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent=".65"
        app:layout_constraintHeight_percent=".6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <View
            android:id="@+id/top_bar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent=".15"
            app:layout_constraintLeft_toLeftOf="@id/dialog_container"
            app:layout_constraintRight_toRightOf="@id/dialog_container"
            app:layout_constraintTop_toTopOf="@id/dialog_container"
            app:layout_constraintBottom_toTopOf="@id/webview_box"
            android:background="#000000"
            ></View>

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintRight_toRightOf="@id/top_bar"
            app:layout_constraintTop_toTopOf="@id/top_bar"
            android:background="@drawable/messagebox_button_close"
            app:layout_constraintHeight_percent=".15"
            />
        <com.jht.chimera.lib.widget.web.WebViewContainer
            android:id="@+id/webview_box"
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintTop_toBottomOf="@id/top_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>