<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_fragment_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_color_slate_blue"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="SpUsage">

    <Space
        android:id="@+id/login_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.05"
        app:layout_constraintHeight_percent="0.12"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/login_type_recycler_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/login_space"
        app:layout_constraintTop_toBottomOf="@id/login_space"
        app:layout_constraintWidth_percent="0.219" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/login_guest_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/default_button_selector1"
        android:text="@string/guest_tc"
        android:textAllCaps="false"
        android:textColor="@android:color/black"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/login_type_recycler_view"
        app:layout_constraintTop_toBottomOf="@id/login_type_recycler_view"
        app:layout_constraintVertical_bias="0.87"
        app:layout_constraintDimensionRatio="4.42:1"
        app:layout_constraintWidth_percent=".132" />

    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/login_user_name_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:label="@string/xid_tc"
        android:hint="@string/enter_xid_2_tc"
        android:imeOptions="actionNext"
        android:layout_marginTop="@dimen/login_user_name_margin_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/login_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/login_type_recycler_view"
        app:layout_constraintWidth_percent=".336"
        app:layout_constraintHorizontal_bias="0.2"/>

    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/login_password_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:label="@string/passcode_tc"
        android:hint="@string/enter_passcode_tc"
        android:imeOptions="actionDone"
        android:layout_marginTop="20dp"
        app:password="true"
        app:layout_constraintTop_toBottomOf="@id/login_user_name_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/login_type_recycler_view"
        app:layout_constraintWidth_percent=".336"
        app:layout_constraintHorizontal_bias="0.2"/>

    <TextView
        android:id="@+id/websocket_qr_code_fail_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="15dp"
        android:gravity="center"
        android:text="@string/qr_code_failure_tc"
        android:visibility="invisible"
        app:autoSizeMaxTextSize="30dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/login_type_recycler_view"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/qr_websocket_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@id/login_type_recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:layout_margin="250dp"
        android:visibility="invisible"
        />


    <ImageView
        android:id="@+id/qr_login_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="@id/login_user_name_input"
        app:layout_constraintStart_toEndOf="@id/login_user_name_input"
        app:layout_constraintBottom_toBottomOf="@id/login_password_input"
        android:visibility="invisible"
        android:layout_marginStart="40dp"
        android:layout_marginTop="35dp"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/login_guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.10" />


    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/login_input_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="login_user_name_input,login_password_input" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/register_button"
        style="@style/TextTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/default_button_selector1"
        android:textAllCaps="false"
        android:text="@string/login_tc"
        app:backgroundTint="#ff00710e"
        app:layout_constraintEnd_toEndOf="@id/login_user_name_input"
        app:layout_constraintTop_toBottomOf="@id/login_input_barrier"
        android:layout_marginTop="20dp"
        app:layout_constraintWidth_percent=".132"
        app:layout_constraintDimensionRatio="4.42:1"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/login_guideline_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.68" />

    <TextView
        android:id="@+id/user_login_error_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/login_failed_message_pg"
        android:textColor="@android:color/holo_red_dark"
        android:textSize="20dp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/login_user_name_input"
        app:layout_constraintStart_toStartOf="@id/login_user_name_input"
        app:layout_constraintTop_toBottomOf="@id/register_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
