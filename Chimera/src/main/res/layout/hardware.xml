<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hardware_main_container"
    style="@style/EngineeringPage">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true">

        <androidx.gridlayout.widget.GridLayout style="@style/EngineeringPageGridLayout">

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_rfid_tag"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/rfid_tag_type_tc"
                app:read_only="true" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_rfid_tag_value"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/rfid_tag_scanned_hex_tc"
                app:read_only="true" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_rfid_tag_value_dec"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/rfid_tag_scanned_dec_tc"
                app:read_only="true" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:layout_columnSpan="@integer/eng_cols_per_page">

                <Button
                    android:id="@+id/eng_hardware_rfid_disassociate"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="200dp"
                    android:layout_centerInParent="true"
                    android:text="@string/disassociate_rfid_tag_tc" />
            </RelativeLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                android:id="@+id/colorTemperature"
                app:columnCount="3"
                app:layout_columnSpan="3">
                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="300dp"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/color_temperature_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">
                    <SeekBar
                        android:id="@+id/eng_hardware_color_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="9500"
                        android:min="3500" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/colorThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            </androidx.gridlayout.widget.GridLayout>

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                app:columnCount="3"
                app:layout_columnSpan="3">

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="300dp"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/backlight_brightness_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">
                    <SeekBar
                        android:id="@+id/eng_hardware_backlight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="100"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/backlightThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/volume_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">

                    <SeekBar
                        android:id="@+id/eng_hardware_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="15"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/volumeThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

            </androidx.gridlayout.widget.GridLayout>

            <!-- Lube belt/chain stuff -->

            <LinearLayout
                android:id="@+id/belt_lube_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnSpan="3"
                android:visibility="visible"
                >

                <!-- For now, belt = treadmill = lube every X kilometers -->

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="20dp"
                    />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="#ffffff"
                    />

                <TextView
                    android:id="@+id/accumulated_distance_since_lube_label"
                    style="@style/SettingsText"
                    android:layout_width="fill_parent"
                    android:text="@string/last_lube_distance_tc"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    >

                    <TextView
                        android:id="@+id/accumulated_distance_since_lube_value"
                        style="@style/SettingsButtonEdit"
                        android:layout_width="300dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/reset_lube_distance_button"
                        style="@style/SettingsButtonReset"
                        android:text="@string/reset_tc"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chain_lube_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnSpan="3"
                android:visibility="visible"
                >

                <!-- For now, chain = climbmill = lube every X hours -->

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="20dp"
                    />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="#ffffff"
                    />

                <TextView
                    android:id="@+id/accumulated_time_since_lube_label"
                    style="@style/SettingsText"
                    android:layout_width="fill_parent"
                    android:text="@string/last_lube_time_tc"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right">

                    <TextView
                        android:id="@+id/accumulated_time_since_lube_value"
                        style="@style/SettingsButtonEdit"
                        android:layout_width="300dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/reset_lube_time_button"
                        style="@style/SettingsButtonReset"
                        android:text="@string/reset_tc"
                        />
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/headphone_count_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headphone_count_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="3">

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_a_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/eng_hardware_headphone_insert_b_label"
                    android:text="@string/console_headphone_count_tc" />

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_b_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/eng_hardware_headphone_insert_a_label"
                    app:layout_constraintRight_toLeftOf="@id/eng_hardware_usb_attach_count_label"
                    android:text="@string/frame_headphone_count_tc" />

                <TextView
                    android:id="@+id/eng_hardware_usb_attach_count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/eng_hardware_headphone_insert_b_label"
                    app:layout_constraintRight_toRightOf="parent"
                    android:text="@string/usb_insertions_tc" />

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_a_label"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_a_label"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_a_label" />

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_b_label"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_b_label"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_b_label" />

                <TextView
                    android:id="@+id/eng_hardware_usb_attach_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_usb_attach_count_label"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_usb_attach_count_label"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_usb_attach_count_label" />

                <Button
                    android:id="@+id/eng_hardware_insert_a_reset"
                    style="@style/GeneralEngineeringButton"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_a"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_a"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_a"
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:text="@string/reset_tc" />

                <Button
                    android:id="@+id/eng_hardware_insert_b_reset"
                    style="@style/GeneralEngineeringButton"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_b"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_b"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_b"
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:text="@string/reset_tc" />

                <Button
                    android:id="@+id/eng_hardware_usb_attach_reset"
                    style="@style/GeneralEngineeringButton"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_usb_attach_count"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_usb_attach_count"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_usb_attach_count"
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:text="@string/reset_tc" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_hardware_erp_mode"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/erp_tc"
                app:option_popup_width="400dp" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_erp_time"
                style="@style/GeneralEditTextStringEngineering"
                android:layout_marginBottom="10dp"
                android:imeOptions="actionDone"
                app:input_type="time_clock"
                app:label="@string/erp_time_tc"
                app:picker_animation="@style/EngTimeHardwareDialogAnimation" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_erp_timeout"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:label="@string/erp_timeout_tc"
                app:max_value="60"
                app:min_value="1"
                app:max_chars="2"
                app:units="time_minutes" />

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_hardware_erp_type"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/options_uc"
                app:option_popup_width="400dp" />
            <Space
                android:id="@+id/eng_hardware_erp_type_space1"
                style="@style/GeneralEngineeringOptionSelector" />
            <Space
                android:id="@+id/eng_hardware_erp_type_space2"
                style="@style/GeneralEngineeringOptionSelector" />

            <RelativeLayout
                android:id="@+id/eng_hardware_fan_line"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_hardware_fan_mode"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/fan_options_tc"
                app:option_popup_width="400dp" />

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                app:columnCount="2"
                app:layout_columnSpan="3">

                <CheckBox
                    android:id="@+id/eng_hardware_key_beeps"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/key_beep_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_countdown_beeps"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/workout_countdown_beep_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_ignore_incline_errors"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/ignore_incline_errors_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_ignore_b_errors"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/ignore_b_level_errors_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_pfc_mode"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/pfc_mode_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_disable_audio"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/disable_audio_tc"/>
            </androidx.gridlayout.widget.GridLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <CheckBox
                android:id="@+id/eng_ant_plus_enabled"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_ant_plus_tc" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_ant_plus_id"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:label="ANT+ Id"
                app:max_value="32767"
                app:min_value="1" />

<!--            <com.jht.androiduiwidgets.edittext.UserTextInput-->
<!--                android:id="@+id/eng_ant_plus_page"-->
<!--                style="@style/GeneralEditTextIntEngineering"-->
<!--                android:imeOptions="actionDone"-->
<!--                app:label="ANT+ Page"-->
<!--                app:max_value="2"-->
<!--                app:min_value="1" />-->
            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_ant_plus_page"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="ANT+ Protocol"
                app:option_popup_width="400dp" />

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <CheckBox
                android:id="@+id/eng_ftms_enabled"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_bt_ftms_tc" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_ftms_name"
                style="@style/GeneralEditTextStringEngineering"
                android:imeOptions="actionDone"
                app:label="BLE Name"
                app:max_chars="10"
                app:min_chars="0" />

            <RelativeLayout
                android:id="@+id/engineering_line_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <CheckBox
                android:id="@+id/eng_hardware_enable_oc"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_over_current_protection_tc" />

            <CheckBox
                android:id="@+id/eng_hardware_gymkit"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_gymkit_tc" />

            <CheckBox
                android:id="@+id/eng_hardware_samsung_watch"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_samsung_watch_tc" />

            <CheckBox
                android:id="@+id/eng_hardware_mfi"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_mfi_tc" />

            <RelativeLayout
                android:id="@+id/eng_hardware_motor_type_line"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_hardware_motor_type"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/motor_type_tc"
                app:option_popup_width="400dp" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_motor_type_value"
                style="@style/GeneralEditTextIntEngineering"
                app:label="  "
                app:read_only="true" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lcb_data_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="@integer/eng_cols_per_page">

                <RelativeLayout
                    android:id="@+id/lcb_data_line_break"
                    style="@style/engineering_line_break"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/lcb_data_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lcb_data_line_break"
                    android:text="@string/raw_lcb_data_tc"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="@dimen/edit_text_label_size" />

                <TextView
                    android:id="@+id/lcb_data_values"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lcb_data_title"
                    android:padding="15dp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="@dimen/jht_setting_title_text_size" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:id="@+id/eng_hardware_haptic_feedback_line_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/eng_hardware_haptic_enable_checkbox"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_haptic_feedback_tc"
                app:layout_columnWeight="1"
                android:visibility="gone" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_haptic_effect_input"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/haptic_effect_tc"
                android:hint="@string/effect_id_no_tc"
                android:layout_marginBottom="20dp"
                android:imeOptions="actionDone"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/eng_hardware_haptic_btn_layout"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_gravity="center_vertical"
                app:layout_columnWeight="1"
                android:visibility="gone" >

                <Button
                    android:id="@+id/eng_hardware_haptic_btn"
                    style="@style/GeneralEngineeringButton"
                    android:text="@string/buzz_tc"
                    android:layout_marginTop="30dp"
                    android:visibility="gone" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/color_picker_dialog_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:visibility="gone"
                android:padding="8dp">

                <RelativeLayout
                    android:id="@+id/eng_hardware_color_picker_line_break_top"
                    style="@style/engineering_line_break"
                    app:layout_columnSpan="@integer/eng_cols_per_page"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/led_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/led_debug_testing_tc"
                    android:textSize="24sp"
                    android:paddingTop="10dp"
                    app:layout_constraintBottom_toTopOf="@id/led_color_selection_recycler_view"
                    app:layout_constraintEnd_toEndOf="@id/seekBarBrightnessLED"
                    app:layout_constraintHorizontal_bias="0.05"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_color_picker_line_break_top" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/led_color_selection_recycler_view"
                    android:layout_width="0dp"
                    app:layout_constraintTop_toBottomOf="@id/led_title_text"
                    android:layout_height="0dp"
                    app:layout_constraintWidth_percent="0.8"
                    app:layout_constraintHeight_percent="0.8"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintStart_toStartOf="@id/led_title_text"/>

                <Button
                    android:id="@+id/reset_LED_colors_button"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:padding="10dp"
                    app:layout_constraintVertical_bias="0.05"
                    app:layout_constraintTop_toTopOf="@id/led_color_selection_recycler_view"
                    android:text="@string/reset_led_tc"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/led_color_selection_recycler_view"/>

                <TextView
                    android:id="@+id/led_brightness_text"
                    android:layout_width="300dp"
                    android:layout_height="30dp"
                    android:text="@string/led_brightness_tc"
                    android:textSize="18sp"
                    app:layout_constraintBottom_toTopOf="@id/eng_hardware_color_picker_line_break_bottom"
                    app:layout_constraintHorizontal_bias="0.05"
                    app:layout_constraintStart_toStartOf="@id/led_title_text"
                    app:layout_constraintTop_toBottomOf="@id/led_color_selection_recycler_view"
                    />

                <SeekBar
                    android:id="@+id/seekBarBrightnessLED"
                    android:layout_width="600dp"
                    android:layout_height="30dp"
                    android:max="100"
                    app:layout_constraintBottom_toBottomOf="@id/led_brightness_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/led_brightness_text"
                    app:layout_constraintTop_toTopOf="@id/led_brightness_text" />

                <RelativeLayout
                    android:id="@+id/eng_hardware_color_picker_line_break_bottom"
                    style="@style/engineering_line_break"
                    app:layout_columnSpan="@integer/eng_cols_per_page"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/seekBarBrightnessLED" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/friction_test_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <RelativeLayout
                    style="@style/engineering_line_break"
                    android:layout_width="match_parent"/>

                <Button
                    android:id="@+id/friction_test_button"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="@string/launch_friction_test_tc"/>

            </LinearLayout>
        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/color_picker"
        android:windowSoftInputMode="adjustPan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
