<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/graphContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_centerHorizontal="true"
    >

    <com.jht.chimera.lib.graph.GraphLegendWidget
        android:id="@+id/va_graph_legend_widget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        />

    <com.jht.chimera.lib.graph.workoutgraph.WorkoutGraphThreaded
        android:id="@+id/va_workout_graph"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginTop="8dp"
        android:layout_toEndOf="@id/va_graph_legend_widget"
        />


</RelativeLayout>