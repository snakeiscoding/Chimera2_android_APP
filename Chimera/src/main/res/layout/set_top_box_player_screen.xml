<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <RelativeLayout
        android:id="@+id/framelayout_hdmi_video_player"
        android:layout_width="640dp"
        android:layout_height="360dp"
        android:layout_marginStart="10dp"
        android:foregroundGravity="clip_horizontal|clip_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <SurfaceView
            android:id="@+id/set_top_box_tv_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </RelativeLayout>


    <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/eng_tv_hdmi_control_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/control_tc"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="265dp"
            android:layout_height="265dp"
            android:layout_marginTop="5dp"
            android:background="@android:color/darker_gray"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/set_top_box_control_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/control_button_selector"
                    app:srcCompat="@drawable/ic_arrow_upward_black_80dp"
                    app:tint="@color/standard_button_tint" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/set_top_box_control_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:background="@drawable/control_button_selector"
                    app:srcCompat="@drawable/ic_arrow_left_black_80dp"
                    app:tint="@color/standard_button_tint" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/set_top_box_control_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:background="@drawable/control_button_selector"
                    app:srcCompat="@drawable/ic_check_green_80dp"
                    app:tint="@color/control_confirm_button_tint" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/set_top_box_control_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/control_button_selector"
                    app:srcCompat="@drawable/ic_arrow_right_black_80dp"
                    app:tint="@color/standard_button_tint" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/set_top_box_control_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/control_button_selector"
                    app:srcCompat="@drawable/ic_arrow_down_black_80dp"
                    app:tint="@color/standard_button_tint" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/set_top_box_control_command_selector"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:layout_weight=".75"
                android:gravity="center_vertical"
                app:option_popup_height="600dp"
                app:option_popup_width="650dp" />

            <Button
                android:id="@+id/set_top_box_go"
                style="@style/standard_button"
                android:layout_width="0dp"
                android:layout_height="59dp"
                android:layout_gravity="center|center_vertical"
                android:layout_marginStart="10dp"
                android:layout_weight=".25"
                android:gravity="center_vertical"
                android:text="@string/go_tc"
                android:textAlignment="center"
                android:textColor="@color/dialog_background"
                android:textSize="24sp" />

        </LinearLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>