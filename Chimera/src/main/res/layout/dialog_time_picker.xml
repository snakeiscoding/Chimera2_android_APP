<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#e6e6e6"
        android:padding="10dp">

        <com.jht.chimera.lib.widget.textview.AutofitTextView
            android:id="@+id/dialogTitleText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="5dp"
            android:text="@string/time_tc"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="26sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1a1a1a00"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <RelativeLayout
            android:layout_width="500dp"
            android:layout_height="430dp">

            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:scaleX="2"
                android:scaleY="2"
                android:timePickerMode="spinner"/>
        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1a1a1a00"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <com.jht.chimera.lib.widget.selectron.SelectronButton
            android:id="@+id/buttonCancel"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            app:drawableBackground="@color/button_red"
            app:drawableIcon="@drawable/ic_close_white"
            app:iconHeight="40dp"
            app:iconWidth="40dp"/>

        <com.jht.chimera.lib.widget.selectron.SelectronButton
            android:id="@+id/buttonOk"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            app:drawableBackground="@color/button_green"
            app:drawableIcon="@drawable/ic_check_white"
            app:iconHeight="40dp"
            app:iconWidth="40dp"/>

    </LinearLayout>

</LinearLayout>
