<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Progress background -->
    <item android:id="@+id/background_2">
        <shape
            android:shape="ring"
            android:useLevel="false"
            android:thicknessRatio="50">
            <solid android:color="#17FCAF1A" />
        </shape>
    </item>

    <item android:id="@+id/progress">
        <rotate
            android:fromDegrees="270"
            android:pivotX="50%"
            android:pivotY="50%"
            android:toDegrees="270">

        <shape
                android:shape="ring"
                android:thicknessRatio="50">
            <gradient
                android:angle="90"
                android:startColor="#FFE55A"
                android:endColor="#F0B323"
                android:type="linear" />
            </shape>

        </rotate>
    </item>
</layer-list>