settings
    workout_id = 36
    allow_skip_warmup = 0
    graph_future = 0
    allow_skip_workout = 1
    allow_user_goal_changes = 0

//// short_name = Army     workout name = fitness_test_army_tm
// treadmill_workout=true     stepper_workout=false     ep_workout=false     climbmill_workout=false     bike_workout=false     ascent_workout=false

input COOLDOWN_TIME_START
input DISTANCE
input SPEED_IN
input GOAL
input GENDER
input AGE
input FRAME_ELEVATION

export INCLINE
export GOAL_TYPE
export SPEED
export GOAL
export TEST_SCORE_MALE
export TEST_SCORE_FEMALE
export ALLOW_PAUSE
export PREVENT_USER_GOAL_CHANGES

stage workout
    PREVENT_USER_GOAL_CHANGES = 1
    GOAL_TYPE = GOAL_TYPE_DISTANCE_STAGE_CONSTANT
    GOAL = 4.82803 // 3 miles
    ALLOW_PAUSE = 0
    
    SPEED = 0.8
    INCLINE = 0
    
    workoutCompleteTime = 0
    interval
        when DISTANCE >= GOAL
            workoutCompleteTime = INTERVAL_TIME_MS
            end

// Cooldown can only be reached by clicking on the cooldown button
stage cooldown
    PREVENT_USER_GOAL_CHANGES = 0
    INCLINE = 0
    GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
    GOAL = COOLDOWN_TIME_START
    SPEED = min(0.6 * SPEED_IN, 6.43738)
    
    interval
        when INTERVAL_TIME_MS >= GOAL
            end

