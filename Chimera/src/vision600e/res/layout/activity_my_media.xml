<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context="com.jht.chimera.ui.mymedia.MyMediaActivity">

    <LinearLayout
        android:id="@+id/ll_menu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical"
        android:background="#444444">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B3333333"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:text="@string/my_media_tc"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />
        <Button
            android:id="@+id/btn_bluetooth"
            android:layout_marginTop="40dp"
            android:drawableLeft="@drawable/ic_bluetooth_blue"
            android:drawablePadding="10dp"
            android:text="@string/bluetooth_pairing_tc"
            android:gravity="left|center_vertical"
            style="@style/MyMediaSourceButton"
            android:textAllCaps="false"
			android:visibility="gone" />

        <Button
            android:id="@+id/btn_usb"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/ic_usb_blue"
            android:drawablePadding="10dp"
            android:text="@string/med_app_usb_tc"
            android:gravity="left|center_vertical"
            style="@style/MyMediaSourceButton"
            android:textAllCaps="false" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_right_side"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7" />

</LinearLayout>
