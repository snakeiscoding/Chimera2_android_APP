<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/selector_item_height"
    android:background="#00FFFFFF">

    <LinearLayout
        android:id="@+id/selector_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_item_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/eng_available_update_version"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="@dimen/selector_item_text_size"
            android:autoSizeTextType="uniform"
            android:background="#00FFFFFF"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:paddingStart="20dp"
            android:textColor="@color/selector_text_color"
            android:textSize="@dimen/selector_item_text_size"
            android:textStyle="bold"
            tools:ignore="SpUsage" />

        <Button
            android:id="@+id/eng_apply_available_update"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:width="200dp"
            android:contentDescription="@null"
            android:text="@string/update_tc"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
