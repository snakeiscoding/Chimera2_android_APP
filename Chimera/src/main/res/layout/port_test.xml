<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hardware_main_container"
    tools:ignore="HardcodedText"
    style="@style/EngineeringPage">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true">

        <androidx.gridlayout.widget.GridLayout style="@style/EngineeringPageGridLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/hr_test_label"
                        style="@style/SettingsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hr_port_tc"
                        android:textSize="@dimen/edit_text_label_size" />

                    <TextView
                        style="@style/SettingsButtonEdit"
                        android:layout_width="10dp"
                        android:layout_height="match_parent"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/hr_test_label_insert_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/edit_text_label_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/hr_port_test_button"
                        style="@style/SettingsButtonReset"
                        android:layout_width="150dp"
                        android:text="@string/port_button_tc" />
                </LinearLayout>
            </LinearLayout>

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>
</RelativeLayout>
