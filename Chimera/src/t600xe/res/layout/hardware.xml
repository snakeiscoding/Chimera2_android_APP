<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hardware_main_container"
    style="@style/EngineeringPage">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true">

        <androidx.gridlayout.widget.GridLayout style="@style/EngineeringPageGridLayout">

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_rfid_tag"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/rfid_tag_type_tc"
                app:read_only="true"
                android:visibility="gone" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_rfid_tag_value"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/rfid_tag_scanned_tc"
                app:read_only="true"
                android:visibility="gone" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:visibility="gone">

                <Button
                    android:id="@+id/eng_hardware_rfid_disassociate"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="200dp"
                    android:layout_centerInParent="true"
                    android:text="@string/disassociate_rfid_tag_tc" />
            </RelativeLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:visibility="gone" />

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                android:id="@+id/colorTemperature"
                app:columnCount="3"
                app:layout_columnSpan="3">
                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="300dp"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/color_temperature_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">
                    <SeekBar
                        android:id="@+id/eng_hardware_color_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="9500"
                        android:min="3500" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/colorThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            </androidx.gridlayout.widget.GridLayout>

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                app:columnCount="3"
                app:layout_columnSpan="3">

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="300dp"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/backlight_brightness_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">

                    <SeekBar
                        android:id="@+id/eng_hardware_backlight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="100"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/backlightThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/volume_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">

                    <SeekBar
                        android:id="@+id/eng_hardware_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="30"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/volumeThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/tv_volume_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">

                    <SeekBar
                        android:id="@+id/eng_hardware_tv_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="100"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/tvVolumeThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

            </androidx.gridlayout.widget.GridLayout>


            <!-- Lube belt/chain stuff -->

            <LinearLayout
                android:id="@+id/belt_lube_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnSpan="3"
                android:visibility="visible"
                >

                <!-- For now, belt = treadmill = lube every X kilometers -->

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="20dp"
                    />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="#ffffff"
                    />

                <TextView
                    android:id="@+id/accumulated_distance_since_lube_label"
                    style="@style/SettingsText"
                    android:layout_width="fill_parent"
                    android:text="@string/last_lube_distance_tc"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    >

                    <TextView
                        android:id="@+id/accumulated_distance_since_lube_value"
                        style="@style/SettingsButtonEdit"
                        android:layout_width="300dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/reset_lube_distance_button"
                        style="@style/SettingsButtonReset"
                        android:text="@string/reset_tc"
                        />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chain_lube_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnSpan="3"
                android:visibility="visible"
                >

                <!-- For now, chain = climbmill = lube every X hours -->

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="20dp"
                    />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="#ffffff"
                    />

                <TextView
                    android:id="@+id/accumulated_time_since_lube_label"
                    style="@style/SettingsText"
                    android:layout_width="fill_parent"
                    android:text="@string/last_lube_time_tc"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right">

                    <TextView
                        android:id="@+id/accumulated_time_since_lube_value"
                        style="@style/SettingsButtonEdit"
                        android:layout_width="300dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/reset_lube_time_button"
                        style="@style/SettingsButtonReset"
                        android:text="@string/reset_tc"
                        />
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/headphone_count_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headphone_count_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="3">

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_headphone_insert_a"
                style="@style/GeneralEditTextIntEngineering"
                android:layout_width="300dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/eng_hardware_headphone_insert_b"
                app:label="@string/console_headphone_count_tc"
                app:read_only="true" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_headphone_insert_b"
                style="@style/GeneralEditTextIntEngineering"
                android:layout_width="300dp"
                app:layout_constraintLeft_toRightOf="@id/eng_hardware_headphone_insert_a"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:label="@string/frame_headphone_count_tc"
                app:read_only="true"
                android:visibility="gone" />

            <Button
                android:id="@+id/eng_hardware_insert_a_reset"
                style="@style/GeneralEngineeringButton"
                app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_a"
                app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_a"
                app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_a"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:text="@string/reset_tc" />

            <Button
                android:id="@+id/eng_hardware_insert_b_reset"
                style="@style/GeneralEngineeringButton"
                app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_b"
                app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_b"
                app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_a"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:text="@string/reset_tc"
                android:visibility="gone" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <com.jht.chimera.lib.widget.selector.OptionSelectorItem
                android:id="@+id/eng_hardware_erp_mode"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/erp_tc"
                app:option_popup_width="400dp" />


            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_erp_time"
                style="@style/GeneralEditTextStringEngineering"
                android:layout_marginBottom="10dp"
                android:imeOptions="actionDone"
                app:input_type="time_clock"
                app:label="@string/erp_time_tc"
                app:picker_animation="@style/EngTimeHardwareDialogAnimation" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_erp_timeout"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:label="@string/erp_timeout_tc"
                app:max_value="60"
                app:min_value="1"
                app:units="time_minutes" />

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                app:columnCount="2"
                app:layout_columnSpan="3">

                <CheckBox
                    android:id="@+id/eng_hardware_key_beeps"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/key_beep_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_countdown_beeps"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/workout_countdown_beep_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_ignore_incline_errors"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/ignore_incline_errors_tc" />

                <CheckBox
                    android:id="@+id/eng_hardware_ignore_b_errors"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/ignore_b_level_errors_tc" />
                <CheckBox
                    android:id="@+id/eng_hardware_pfc_mode"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/pfc_mode_tc" />

            </androidx.gridlayout.widget.GridLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <CheckBox
                android:id="@+id/eng_ant_plus_enabled"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_ant_plus_tc"
                android:visibility="gone" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_ant_plus_id"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:label="ANT+ Id"
                app:max_value="32767"
                app:min_value="1"
                android:visibility="gone" />

<!--            <com.jht.androiduiwidgets.edittext.UserTextInput-->
<!--                android:id="@+id/eng_ant_plus_page"-->
<!--                style="@style/GeneralEditTextIntEngineering"-->
<!--                android:imeOptions="actionDone"-->
<!--                app:label="ANT+ Page"-->
<!--                app:max_value="2"-->
<!--                app:min_value="1" />-->
            <com.jht.chimera.lib.widget.selector.OptionSelectorItem
                android:id="@+id/eng_ant_plus_page"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="ANT+ Protocol"
                app:option_popup_width="400dp"
                android:visibility="gone" />

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/eng_ftms_enabled"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_bt_ftms_tc"
                android:visibility="gone" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_ftms_name"
                style="@style/GeneralEditTextStringEngineering"
                android:imeOptions="actionDone"
                app:label="BLE Name"
                app:max_chars="10"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/eng_hardware_motor_type_line"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/eng_hardware_enable_oc"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_over_current_protection_tc" />

            <com.jht.chimera.lib.widget.selector.OptionSelectorItem
                android:id="@+id/eng_hardware_motor_type"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/motor_type_tc"
                app:option_popup_width="400dp" />



            <!--
            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_motor_type_value"
                style="@style/GeneralEditTextIntEngineering"
                app:label="  "
                app:read_only="true" />
                -->

        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>


</RelativeLayout>
