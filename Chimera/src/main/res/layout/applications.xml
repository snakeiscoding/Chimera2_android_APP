<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"


    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/touch_event_detector"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        ></View>


    <androidx.viewpager.widget.ViewPager
        android:id="@+id/visibleAppsPager"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent=".85"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        >

    </androidx.viewpager.widget.ViewPager>


    <com.jht.androiduiwidgets.viewpager.PageIndicator
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@id/visibleAppsPager"
        app:layout_constraintRight_toRightOf="@id/visibleAppsPager"
        app:layout_constraintBottom_toBottomOf="@id/visibleAppsPager"
        app:view_pager="@id/visibleAppsPager"
        >

    </com.jht.androiduiwidgets.viewpager.PageIndicator>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent=".858"
        app:layout_constraintLeft_toRightOf="@id/visibleAppsPager"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent=".140"
        android:background="@drawable/app_page_drag_background">

        <TextView
            android:id="@+id/inactive_list_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent=".09"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/space5"
            android:background="#50FFFFFF"
            android:text="@string/inactive_tc"
            android:textColor="@color/white"
            android:textSize="28dp"
            android:gravity="center"
            app:layout_constraintVertical_bias="0"/>

        <Space
            android:id="@+id/space5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.0348"
            app:layout_constraintTop_toBottomOf="@id/inactive_list_title"
            app:layout_constraintBottom_toTopOf="@id/hiddenAppsRecyclerView"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hiddenAppsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent=".8752"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/space5"
            app:layout_constraintBottom_toBottomOf="parent"

            ></androidx.recyclerview.widget.RecyclerView>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>