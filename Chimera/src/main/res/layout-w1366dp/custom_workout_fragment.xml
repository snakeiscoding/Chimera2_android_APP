<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:focusableInTouchMode="true">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/workout_segment_parameter_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent=".77" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/loading_overlay_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_gray_tile"
        android:elevation="10dp"
        android:outlineProvider="none"
        android:visibility="gone"
        app:backgroundTint="#222222"
        app:backgroundTintMode="src_over"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/grey_bar"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/gray_textured_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gray_tile"
        app:backgroundTint="#90000000"
        app:backgroundTintMode="src_over" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/custom_workout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_recycler_view_container"
        app:layout_constraintEnd_toStartOf="@id/grey_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/ic_return_white"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/custom_workout_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/custom_workout_title" />

        <TextView
            android:id="@+id/custom_workout_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/custom_workouts_tc"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="28dp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="4:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/back_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_percent=".755" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/custom_workout_recycler_view_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:paddingTop="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/custom_workout_header"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.215">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/custom_workout_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true" />
    </ScrollView>

    <View
        android:id="@+id/grey_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#444444"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/custom_workout_recycler_view_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.004" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/title_edit_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="#00000000"
        android:drawableEnd="@drawable/ic_pencil_edit"
        android:drawablePadding="15dp"
        android:gravity="center_vertical|start"
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:maxLength="30"
        android:text="@string/high_intensity_tc"
        android:textColor="#ffffff"
        android:textSize="30dp"
        android:textStyle="bold"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintStart_toStartOf="@id/custom_workout_parameter_1_color"
        app:layout_constraintTop_toTopOf="parent" />

    <com.jht.chimera.ui.mainapp.goscreen.WorkoutCustom.CustomWorkoutGraph
        android:id="@+id/custom_workout_graph"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_black_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.305"
        app:layout_constraintStart_toStartOf="@id/grey_bar"
        app:layout_constraintWidth_percent="0.68" />

    <TextView
        android:id="@+id/custom_workout_parameter_2_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text=""
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_graph"
        app:layout_constraintEnd_toStartOf="@id/custom_workout_parameter_2_color"
        app:layout_constraintTop_toBottomOf="@id/title_edit_text"
        tools:ignore="SpUsage" />

    <View
        android:id="@+id/custom_workout_parameter_2_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_parameter_2_text"
        app:layout_constraintDimensionRatio="W, 3:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.975"
        app:layout_constraintStart_toEndOf="@id/grey_bar"
        app:layout_constraintTop_toTopOf="@id/custom_workout_parameter_2_text" />

    <TextView
        android:id="@+id/custom_workout_parameter_2_value_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_graph"
        app:layout_constraintStart_toEndOf="@id/custom_workout_graph"
        app:layout_constraintTop_toTopOf="@id/custom_workout_graph"
        app:layout_constraintVertical_bias="0.02"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/custom_workout_parameter_2_value_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_parameter_2_value_3"
        app:layout_constraintStart_toStartOf="@id/custom_workout_parameter_2_value_1"
        app:layout_constraintTop_toBottomOf="@id/custom_workout_parameter_2_value_1"
        app:layout_constraintVertical_chainStyle="spread"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/custom_workout_parameter_2_value_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_parameter_2_value_4"
        app:layout_constraintStart_toStartOf="@id/custom_workout_parameter_2_value_1"
        app:layout_constraintTop_toBottomOf="@id/custom_workout_parameter_2_value_2"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/custom_workout_parameter_2_value_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_graph"
        app:layout_constraintStart_toStartOf="@id/custom_workout_parameter_2_value_1"
        app:layout_constraintTop_toTopOf="@id/custom_workout_graph"
        app:layout_constraintVertical_bias="0.54"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/custom_workout_parameter_1_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text=""
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_graph"
        app:layout_constraintStart_toEndOf="@id/custom_workout_parameter_1_color"
        app:layout_constraintTop_toBottomOf="@id/title_edit_text"
        tools:ignore="SpUsage" />

    <View
        android:id="@+id/custom_workout_parameter_1_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_parameter_1_text"
        app:layout_constraintDimensionRatio="W, 3:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.015"
        app:layout_constraintStart_toEndOf="@id/grey_bar"
        app:layout_constraintTop_toTopOf="@id/custom_workout_parameter_1_text" />

    <TextView
        android:id="@+id/custom_workout_parameter_1_value_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_parameter_2_value_1"
        app:layout_constraintEnd_toStartOf="@id/custom_workout_graph"
        app:layout_constraintTop_toTopOf="@id/custom_workout_parameter_2_value_1"
        app:layout_constraintVertical_chainStyle="spread_inside"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/custom_workout_parameter_1_value_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_parameter_2_value_2"
        app:layout_constraintEnd_toEndOf="@id/custom_workout_parameter_1_value_1"
        app:layout_constraintTop_toTopOf="@id/custom_workout_parameter_2_value_2"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/custom_workout_parameter_1_value_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_parameter_2_value_3"
        app:layout_constraintEnd_toEndOf="@id/custom_workout_parameter_1_value_1"
        app:layout_constraintTop_toTopOf="@id/custom_workout_parameter_2_value_3"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/custom_workout_parameter_1_value_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_parameter_2_value_4"
        app:layout_constraintEnd_toEndOf="@id/custom_workout_parameter_1_value_1"
        app:layout_constraintTop_toTopOf="@id/custom_workout_parameter_2_value_4"
        tools:ignore="HardcodedText,SpUsage" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/custom_workout_previous_index"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#00000000"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_graph"
        app:layout_constraintDimensionRatio="W, 1:1"
        app:layout_constraintEnd_toEndOf="@id/custom_workout_parameter_1_value_1"
        app:layout_constraintTop_toTopOf="@id/custom_workout_graph"
        app:layout_constraintVertical_bias="0.915"
        app:layout_constraintWidth_percent="0.035"
        app:srcCompat="@drawable/ic_previous_arrow" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/custom_workout_next_index"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#00000000"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_graph"
        app:layout_constraintDimensionRatio="W, 1:1"
        app:layout_constraintStart_toStartOf="@id/custom_workout_parameter_2_value_1"
        app:layout_constraintTop_toTopOf="@id/custom_workout_graph"
        app:layout_constraintVertical_bias="0.915"
        app:layout_constraintWidth_percent="0.035"
        app:srcCompat="@drawable/ic_next_arrow" />

    <View
        android:id="@+id/custom_workout_black_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintStart_toEndOf="@id/grey_bar"
        app:layout_constraintTop_toBottomOf="@+id/title_edit_text"
        app:layout_constraintVertical_bias="0.7" />

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/custom_workout_value_selector_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_value_selector_3"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintEnd_toStartOf="@+id/custom_workout_value_selector_2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/grey_bar"
        app:layout_constraintStart_toStartOf="@id/custom_workout_black_background"
        app:layout_constraintTop_toTopOf="@id/custom_workout_black_background"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.217" />

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/custom_workout_value_selector_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_value_selector_1"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintEnd_toStartOf="@+id/workout_segment_parameter_end"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/custom_workout_value_selector_1"
        app:layout_constraintTop_toTopOf="@id/custom_workout_value_selector_1"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.217" />

    <com.jht.androiduiwidgets.pillbox.PillBox
        android:id="@+id/custom_workout_value_selector_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_black_background"
        app:layout_constraintDimensionRatio="H, 2.8:1"
        app:layout_constraintEnd_toEndOf="@id/custom_workout_value_selector_1"
        app:layout_constraintStart_toStartOf="@id/custom_workout_value_selector_1"
        app:layout_constraintTop_toBottomOf="@id/custom_workout_value_selector_1" />

    <View
        android:id="@+id/custom_workout_segment_delete"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/custom_workout_button_selector"
        android:layout_marginTop="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/custom_workout_value_selector_2"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/custom_workout_segment_reset"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/workout_segment_parameter_end"
        app:layout_constraintTop_toTopOf="@+id/custom_workout_value_selector_2" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/delete_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/custom_workout_segment_delete"
        app:layout_constraintDimensionRatio="1.5:1"
        app:layout_constraintEnd_toEndOf="@id/custom_workout_segment_delete"
        app:layout_constraintStart_toStartOf="@id/custom_workout_segment_delete"
        app:layout_constraintTop_toTopOf="@id/custom_workout_segment_delete"
        app:layout_constraintWidth_percent="0.04"
        app:srcCompat="@drawable/ic_trash_can"
        app:tint="#000000" />

    <View
        android:id="@+id/custom_workout_segment_reset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/custom_workout_button_selector"
        app:layout_constraintBottom_toBottomOf="@+id/custom_workout_segment_delete"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/custom_workout_segment_delete"
        app:layout_constraintTop_toTopOf="@+id/custom_workout_segment_delete" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/reset_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@id/delete_icon"
        app:layout_constraintDimensionRatio="1.5:1"
        app:layout_constraintEnd_toEndOf="@id/custom_workout_segment_reset"
        app:layout_constraintStart_toStartOf="@id/custom_workout_segment_reset"
        app:layout_constraintTop_toTopOf="@id/delete_icon"
        app:srcCompat="@drawable/ic_refresh_white"
        app:tint="#000000" />

    <Button
        android:id="@+id/start_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/start_selector"
        android:text="@string/va_go_button_tag_pg"
        android:textColor="@android:color/white"
        android:textSize="23dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="4.4:1"
        app:layout_constraintEnd_toEndOf="@+id/custom_workout_segment_reset"
        app:layout_constraintTop_toBottomOf="@id/custom_workout_black_background"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.2"
        tools:ignore="SpUsage" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/no_wifi_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/start_button"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@id/unable_to_save_workout_text_view"
        app:layout_constraintTop_toTopOf="@id/start_button"
        app:srcCompat="@drawable/ic_icon_wifi_disconnected_goscreen" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/unable_to_save_workout_text_view"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:text="@string/unable_to_save_workout_pg"
        android:textColor="#ffffff"
        android:textSize="18dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/start_button"
        app:layout_constraintEnd_toStartOf="@id/start_button"
        app:layout_constraintTop_toTopOf="@id/start_button"
        tools:ignore="SpUsage" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/total_time_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_time_total_white"
        android:drawablePadding="5dp"
        android:drawableTint="#CCCCCC"
        android:gravity="center"
        android:text="0"
        android:textColor="#CCCCCC"
        android:textSize="14dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/custom_workout_graph"
        app:layout_constraintEnd_toStartOf="@id/custom_workout_parameter_2_text"
        app:layout_constraintStart_toEndOf="@id/custom_workout_parameter_1_text"
        app:layout_constraintTop_toBottomOf="@id/title_edit_text"
        tools:ignore="HardcodedText" />

    <CheckBox
        android:id="@+id/favorite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/title_edit_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_edit_text" />

    <CheckBox
        android:id="@+id/include_cooldown_checkbox"
        style="@style/jht_checkbox_base"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/include_cooldown_tc"
        android:textSize="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/start_button"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/custom_workout_value_selector_1"
        app:layout_constraintTop_toTopOf="@+id/start_button"/>

</androidx.constraintlayout.widget.ConstraintLayout>