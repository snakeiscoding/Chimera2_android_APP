<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_gravity="end"
    app:layout_constraintEnd_toEndOf="parent"
    android:id="@+id/va_item_layout">

    <Space
        android:id="@+id/va_item_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H, 1.35:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/va_item_backround"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent=".916"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="@id/va_item_space"
        app:layout_constraintStart_toStartOf="@id/va_item_space"
        app:layout_constraintTop_toTopOf="@id/va_item_space"
        android:scaleType="centerCrop"
        android:background="#66000000"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/va_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="@id/va_item_backround"
        app:layout_constraintEnd_toEndOf="@id/va_item_backround"
        app:layout_constraintTop_toBottomOf="@id/va_item_backround"
        app:layout_constraintBottom_toBottomOf="@id/va_item_space"
        android:textColor="@android:color/white"
        android:gravity="center"
        />


</androidx.constraintlayout.widget.ConstraintLayout>