<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/workout_summary_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_color_workout_summary">

    <!--Top bar for the summary screen-->
    <View
        android:id="@+id/top_bar_layout"
        android:background="@drawable/welcome_background_bar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/top_bar_height_bordered"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.jht.chimera.lib.widget.button.HomeButton
        android:id="@+id/home_button_image_view"
        android:layout_width="80dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/top_bar_layout"
        app:layout_constraintTop_toTopOf="@id/top_bar_layout"
        />

    <TextView
        android:id="@+id/patriots_suck_results_text_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="@string/workout_title_tc"
        android:textColor="@android:color/white"
        android:textSize="40dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/top_bar_layout"
        app:layout_constraintLeft_toRightOf="@id/home_button_image_view"
        app:layout_constraintTop_toTopOf="@id/top_bar_layout"
        app:layout_constraintHorizontal_bias="0.0" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/summary_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar_layout" />

    <com.jht.androiduiwidgets.viewpager.PageIndicator
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintLeft_toLeftOf="@id/summary_pager"
        app:layout_constraintRight_toRightOf="@id/summary_pager"
        app:layout_constraintBottom_toBottomOf="@id/summary_pager"
        app:view_pager="@id/summary_pager"
        />

    <!-- layout to hold webview -->
    <RelativeLayout
        android:id="@+id/web_survey_section"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="30dp"
        android:background="#20FFFFFF"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>