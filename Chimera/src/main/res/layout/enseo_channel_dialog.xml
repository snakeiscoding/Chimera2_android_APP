<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#85000000" >

    <RelativeLayout
        android:id="@+id/dialog_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:background="#40e6e6e6">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:padding="10dp">

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/channel_number"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/number_tc"
                app:input_type="integer_input"
                app:layout_constraintStart_toStartOf="@id/channel_data1"
                app:layout_constraintTop_toTopOf="parent"
                android:inputType="textNoSuggestions"/>

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/channel_name"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/name_tc"
                app:input_type="text_input"
                app:layout_constraintStart_toStartOf="@id/channel_data2"
                app:layout_constraintTop_toTopOf="parent"
                android:inputType="textNoSuggestions"/>

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/channel_protocol"
                style="@style/GeneralEngineeringOptionSelector"
                android:layout_width="320dp"
                app:layout_constraintStart_toStartOf="@id/channel_path"
                app:layout_constraintTop_toTopOf="parent"
                app:label="@string/protocol_tc"
                app:option_options="@array/iptv_protocols"
                app:option_popup_width="400dp" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/channel_data1"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/address_tc"
                app:input_type="text_input"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/channel_data2"
                app:layout_constraintTop_toBottomOf="@id/channel_name"
                android:inputType="textNoSuggestions"/>

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/channel_data2"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/port_tc"
                app:input_type="integer_input"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@id/channel_data1"
                app:layout_constraintEnd_toStartOf="@id/channel_path"
                app:layout_constraintTop_toBottomOf="@id/channel_name"
                android:inputType="textNoSuggestions"/>

            <CheckBox
                style="@style/GeneralEngineeringCheckBox"
                android:id="@+id/channel_deinterlace"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:text="@string/deinterlace_tc"
                app:layout_constraintStart_toStartOf="@id/channel_protocol"
                app:layout_constraintEnd_toEndOf="@id/channel_protocol"
                app:layout_constraintBottom_toBottomOf="@id/channel_data2"
                android:visibility="gone"  />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/channel_path"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/path_tc"
                app:input_type="text_input"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@id/channel_data2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/channel_name"
                android:inputType="textNoSuggestions"
                android:visibility="invisible"/>

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/channel_rf_broadcast"
                style="@style/GeneralEngineeringOptionSelector"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/channel_protocol"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/channel_data1"
                app:label="@string/rf_broadcast_tc"
                app:option_popup_width="400dp"
                android:visibility="invisible" />

            <Button
                android:id="@+id/dialog_confirm_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:layout_marginTop="22dp"
                app:layout_constraintStart_toStartOf="@id/channel_data1"
                app:layout_constraintEnd_toEndOf="@id/channel_data2"
                app:layout_constraintTop_toBottomOf="@id/channel_data1"
                android:background="@drawable/message_dialog_box_button_yes" />

            <Button
                android:id="@+id/dialog_cancel_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/message_dialog_box_button_no"
                android:layout_marginBottom="22dp"
                android:layout_marginTop="22dp"
                app:layout_constraintTop_toBottomOf="@id/channel_data1"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="@id/channel_data2"
                app:layout_constraintEnd_toEndOf="@id/channel_rf_broadcast"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</RelativeLayout>
