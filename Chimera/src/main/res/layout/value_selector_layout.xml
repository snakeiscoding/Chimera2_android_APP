<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/caption_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Exercise Value"
        android:textSize="16dp"
        android:paddingBottom="5dp"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/stat_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText,SpUsage" />

    <View
        android:id="@+id/stat_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,3.6:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/caption_text"
        />


    <Button
        android:id="@+id/minus_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_minus_selector"
        app:layout_constraintBottom_toBottomOf="@id/stat_background"
        app:layout_constraintDimensionRatio="W, 1:1"
        app:layout_constraintEnd_toStartOf="@id/keypad_button"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".23"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/stat_background" />

    <View
        android:id="@+id/keypad_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#1A1A1A"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/minus_button"
        app:layout_constraintEnd_toStartOf="@id/plus_button"
        app:layout_constraintStart_toEndOf="@id/minus_button"
        app:layout_constraintTop_toTopOf="@id/minus_button"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".49"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/value_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        app:autoSizeTextType="uniform"
        android:text="00:32:00"
        android:textColor="#FFF4F4F4"
        app:layout_constraintBottom_toBottomOf="@id/keypad_button"
        app:layout_constraintEnd_toStartOf="@id/keypad_button"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".4"
        app:layout_constraintStart_toEndOf="@id/keypad_button"
        app:layout_constraintTop_toTopOf="@id/keypad_button"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".45"
        tools:ignore="HardcodedText" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="@id/keypad_button"
        app:layout_constraintTop_toTopOf="@id/keypad_button"
        app:layout_constraintStart_toStartOf="@id/keypad_button"
        app:layout_constraintBottom_toBottomOf="@id/keypad_button"
        app:layout_constraintHorizontal_bias="0.96"
        app:layout_constraintVertical_bias="0.08"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".03"
        app:layout_constraintDimensionRatio="W, 1:1"
        android:background="@drawable/ic_edit_box"
        />

    <Button
        android:id="@+id/plus_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_plus_selector"
        app:layout_constraintBottom_toBottomOf="@id/minus_button"
        app:layout_constraintDimensionRatio="W, 1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/keypad_button"
        app:layout_constraintTop_toTopOf="@id/minus_button" />

</merge>