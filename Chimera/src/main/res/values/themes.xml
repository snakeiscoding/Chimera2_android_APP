<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ChimeraTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <!-- Base application theme. -->
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@style/MyAnimation.Window</item>

        <!-- Standard Selector Item -->
        <item name="standard_selector_item_main_container">@style/standard_selector_item_main_container</item>
        <item name="standard_selector_item_text">@style/standard_selector_item_text</item>

        <!-- Value Update Panel -->
        <item name="top_bar_background">@style/top_bar_background</item>
        <item name="left_right_background">@style/left_right_background</item>
        <item name="left_right_value_text">@style/left_right_value_text</item>
        <item name="left_right_unit_text">@style/left_right_unit_text</item>
        <item name="next_increment_label_text">@style/next_increment_label_text</item>
        <item name="countdown_label_text">@style/countdown_label_text</item>

        <!-- Tread Sense Top Panel -->
        <item name="tread_sense_background">@style/tread_sense_bar_background</item>

    </style>

    <style name="EngineeringScreenTheme" parent="@style/ChimeraTheme">
        <!-- The theme for the Engineering Screen should always use the matrix look and feel.
             Override any UI component that will have a non matrix look and feel here -->

        <!-- Standard Selector Item -->
        <item name="standard_selector_item_main_container">@style/engineering_screen_standard_selector_item_main_container</item>
        <item name="standard_selector_item_text">@style/engineering_screen_standard_selector_item_text</item>
    </style>
</resources>