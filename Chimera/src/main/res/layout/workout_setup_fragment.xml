<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setupFragment_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DF000000">

    <ImageView
        android:id="@+id/setup_fragment_close_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/ic_close"
        app:layout_constraintBottom_toTopOf="@id/setup_fragment_container_background"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".04"
        app:layout_constraintHorizontal_bias=".985"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/setup_fragment_close_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:text="@string/close_program_uc"
        android:textColor="#CCCCCC"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toBottomOf="@id/setup_fragment_close_icon"
        app:layout_constraintEnd_toStartOf="@id/setup_fragment_close_icon"
        app:layout_constraintTop_toTopOf="@id/setup_fragment_close_icon" />

    <ImageView
        android:id="@+id/setup_fragment_container_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CCCCCCCC"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent=".82"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent=".92" />


    <View
        android:id="@+id/fragment_content_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#353638"
        app:layout_constraintEnd_toEndOf="@id/setup_fragment_container_background"
        app:layout_constraintStart_toStartOf="@id/setup_fragment_container_background"
        app:layout_constraintTop_toTopOf="@id/setup_fragment_container_background"
        app:layout_constraintBottom_toBottomOf="@id/setup_fragment_container_background"
        android:layout_margin="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CUSTOM PROGRAM SETUP AS PER \n CONTENT PARTNER’S SPECIFICATIONS"
        android:textColor="@android:color/white"
        android:textSize="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center"
        tools:ignore="HardcodedText,SpUsage" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/setup_fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/fragment_content_background"
        app:layout_constraintBottom_toBottomOf="@id/fragment_content_background"
        app:layout_constraintStart_toStartOf="@id/fragment_content_background"
        app:layout_constraintEnd_toEndOf="@id/fragment_content_background"/>


</androidx.constraintlayout.widget.ConstraintLayout>