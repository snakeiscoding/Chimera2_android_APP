<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/nonVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/popupViewLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:visibility="visible"
        android:onClick="onHidePopup"
        tools:ignore="UsingOnClickInXml">

        <com.jht.chimera.lib.widget.selectron.SelectronButton
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentTop="true"
            android:layout_margin="0dp"
            android:clickable="true"
            android:onClick="onHidePopup"
            tools:ignore="UsingOnClickInXml"
            app:drawableBackground="@android:color/transparent"
            app:drawableIcon="@drawable/ic_close_white"
            app:drawableIconTint="#000000"/>

        <com.jht.chimera.ui.mainapp.PopupWebView
            android:id="@+id/popupView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="40dp"/>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/videoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>