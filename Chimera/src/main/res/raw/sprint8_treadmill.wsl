settings
    workout_id = 18
    allow_skip_warmup = 0
    allow_skip_workout = 1
    graph_future = 1
    allow_user_goal_changes = 0

input RAMP_RATE_SPEED
input RAMP_RATE_INCLINE
input SPEED_IN
input INCLINE_IN
input LEVEL

