# Auto-detect text files and enforce LF line endings in the repo.
# All platforms (Windows, Mac, Linux) will check out files with LF.
* text=auto eol=lf

# Windows batch scripts must retain CRLF to function
*.bat text eol=crlf

# Binary files — do not apply text conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.mov binary
*.wav binary
*.mp3 binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.apk binary
*.bin binary
*.exe binary
*.so binary
*.zip binary
*.gz binary
*.tar binary
*.keystore binary
*.jks binary
*.imx binary

# LFS-tracked files
Deploy/assets/landmark.zip filter=lfs diff=lfs merge=lfs -text
Deploy/assets/media/** filter=lfs diff=lfs merge=lfs -text
Deploy/assets/sprint8/** filter=lfs diff=lfs merge=lfs -text
Deploy/chimera_assets/landmarks/** filter=lfs diff=lfs merge=lfs -text
Deploy/chimera_assets/sprint8/** filter=lfs diff=lfs merge=lfs -text
Deploy/chimera_tpa/*.apk filter=lfs diff=lfs merge=lfs -text
Deploy/chimera_touch_panel/*.apk filter=lfs diff=lfs merge=lfs -text
Deploy/chimera_touch_panel_athena/*.apk filter=lfs diff=lfs merge=lfs -text
Deploy/chimera_assets/virtual_active/** filter=lfs diff=lfs merge=lfs -text
Deploy/chimera_rfid3/update.bin filter=lfs diff=lfs merge=lfs -text

# Merge strategies
parker2-changelog.txt merge=union
