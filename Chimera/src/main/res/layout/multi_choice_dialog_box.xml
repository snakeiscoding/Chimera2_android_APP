<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/dialog_container"
        app:layout_constraintHeight_percent=".7"
        app:layout_constraintWidth_percent=".5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/dialog_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="#80585353"></View>

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/dialog_title"

            app:layout_constraintHeight_percent=".2"
            app:layout_constraintWidth_percent=".97"

            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/outer_container"
            app:layout_constraintVertical_chainStyle="packed"
            android:background="#e6e6e6"
            android:textSize="30dp"
            android:textColor="#333333"
            android:gravity="left|center_vertical"

            app:layout_constraintVertical_bias="0.5"
            />

        <View
            android:id="@+id/outer_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dialog_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent=".7"
            app:layout_constraintWidth_percent=".97"
            android:background="#ff000000"
            ></View>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/upgrade_items"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="@id/outer_container"
            app:layout_constraintRight_toLeftOf="@id/upgrade_message"
            app:layout_constraintTop_toTopOf="@id/outer_container"
            app:layout_constraintHeight_percent=".5"
            android:background="@android:color/transparent"
           >

        </androidx.recyclerview.widget.RecyclerView>

        <TextView
            android:id="@+id/upgrade_message"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toRightOf="@id/upgrade_items"
            app:layout_constraintRight_toRightOf="@id/outer_container"
            app:layout_constraintTop_toTopOf="@id/outer_container"
            android:gravity="center"
            app:layout_constraintHeight_percent=".5"
            android:background="@android:color/transparent"
            android:textColor="@android:color/white"
            />

        <View
            android:id="@+id/button0_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="@id/upgrade_items"
            app:layout_constraintRight_toRightOf="@id/upgrade_items"
            app:layout_constraintTop_toBottomOf="@id/upgrade_items"
            app:layout_constraintBottom_toBottomOf="@id/outer_container"
            app:layout_constraintVertical_bias="0"
            android:background="#80000000"
            app:layout_constraintHeight_percent=".2"
            ></View>

        <ImageButton
            android:id="@+id/button0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/standard_button_selector"
            android:scaleType="center"
            app:layout_constraintHeight_percent=".15"
            app:layout_constraintWidth_percent=".2"
            app:layout_constraintLeft_toLeftOf="@id/button0_container"
            app:layout_constraintRight_toRightOf="@id/button0_container"
            app:layout_constraintTop_toTopOf="@id/button0_container"
            app:layout_constraintBottom_toBottomOf="@id/button0_container"
            app:layout_constraintVertical_bias=".5"
            />

        <TextView
            android:id="@+id/text_button0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:background="#00000000"
            android:textStyle="bold"
            android:textColor="@color/dialog_background"
            app:layout_constraintHeight_percent=".15"
            app:layout_constraintWidth_percent=".25"
            app:layout_constraintLeft_toLeftOf="@id/button0_container"
            app:layout_constraintRight_toRightOf="@id/button0_container"
            app:layout_constraintTop_toTopOf="@id/button0_container"
            app:layout_constraintBottom_toBottomOf="@id/button0_container"
            app:layout_constraintVertical_bias=".5"/>



        <View
            android:id="@+id/button1_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="@id/upgrade_message"
            app:layout_constraintRight_toRightOf="@id/upgrade_message"
            app:layout_constraintTop_toBottomOf="@id/upgrade_message"
            app:layout_constraintBottom_toBottomOf="@id/outer_container"
            app:layout_constraintVertical_bias="0"
            android:background="#80000000"
            app:layout_constraintHeight_percent=".2"
            ></View>


        <ImageButton
            android:id="@+id/button1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="center"
            android:background="@drawable/standard_button_selector"
            app:layout_constraintHeight_percent=".15"
            app:layout_constraintWidth_percent=".2"
            app:layout_constraintLeft_toLeftOf="@id/button1_container"
            app:layout_constraintRight_toRightOf="@id/button1_container"
            app:layout_constraintTop_toTopOf="@id/button1_container"
            app:layout_constraintBottom_toBottomOf="@id/button1_container"
            app:layout_constraintVertical_bias=".5"
            />

        <TextView
            android:id="@+id/text_button1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:background="#00000000"
            android:textStyle="bold"
            android:textColor="@color/dialog_background"
            app:layout_constraintHeight_percent=".15"
            app:layout_constraintWidth_percent=".25"
            app:layout_constraintLeft_toLeftOf="@id/button1_container"
            app:layout_constraintRight_toRightOf="@id/button1_container"
            app:layout_constraintTop_toTopOf="@id/button1_container"
            app:layout_constraintBottom_toBottomOf="@id/button1_container"
            app:layout_constraintVertical_bias=".5"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>