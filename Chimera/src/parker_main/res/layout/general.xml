<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/EngineeringPage">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true">

        <androidx.gridlayout.widget.GridLayout
            style="@style/EngineeringPageGridLayout"
            app:columnCount="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnWeight="1">

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_accumulated_distance"
                    style="@style/GeneralEditTextMeasurementEngineering"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="0dp"
                    android:layout_marginBottom="20dp"
                    android:imeOptions="actionDone"
                    app:decimal_format="0.00"
                    app:label="@string/accumulated_distance_tc"
                    app:input_type="double_input"
                    app:max_chars="20"
                    app:max_value="@integer/max_accumulated_distance_miles"
                    app:min_value="@integer/min_accumulated_distance"
                    app:units="distance" />

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_accumulated_floors"
                    style="@style/GeneralEditTextIntEngineering"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="0dp"
                    android:imeOptions="actionDone"
                    app:decimal_format="0"
                    app:input_resolution="1.0"
                    app:label="@string/floor_climbed_tc"
                    app:max_chars="20"
                    app:max_value="@integer/max_accumulated_floors"
                    app:min_value="@integer/min_accumulated_floors"
                    app:units="floors" />
            </LinearLayout>

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_accumulated_time"
                style="@style/GeneralEditTextEngineering"
                android:imeOptions="actionDone"
                android:inputType="time"
                app:input_type="time_input_hhmm_to_s"
                app:label="@string/accumulated_time_tc"
                app:max_value="@integer/max_accumulated_time"
                app:min_value="@integer/min_accumulated_time"
                app:max_chars="9"
                app:rounding_mode="floor"
                app:units="time_hours" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_columnSpan="3">

                <Button
                    android:id="@+id/eng_reset_accumulators"
                    style="@style/GeneralEngineeringButton"
                    android:text="@string/reset_tc" />
            </RelativeLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="3" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_gen_console_serial_number"
                style="@style/GeneralEditTextStringCapsEngineering"
                android:imeOptions="actionDone"
                app:auto_correct="true"
                app:label="@string/console_serial_number_tc"
                app:max_chars="@integer/max_serial_number_chars" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_gen_frame_serial_number"
                style="@style/GeneralEditTextStringCapsEngineering"
                android:imeOptions="actionDone"
                app:label="@string/frame_serial_number_tc"
                app:max_chars="@integer/max_serial_number_chars" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_gen_club_id"
                android:visibility="gone"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:label="@string/club_id_tc"
                app:max_chars="5"
                app:max_value="65535"
                app:min_value="0" />

            <RelativeLayout
                style="@style/engineering_line_break"
                android:visibility="gone"
                app:layout_columnSpan="3" />

            <CheckBox
                android:id="@+id/eng_demo_mode"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/demo_mode_tc" />

            <CheckBox
                android:id="@+id/eng_out_of_order"
                android:visibility="gone"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/out_of_order_tc" />

            <CheckBox
                android:id="@+id/eng_show_setup_wizard"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/show_setup_wizard_tc" />

            <RelativeLayout
                style="@style/engineering_line_break"
                android:visibility="gone"
                app:layout_columnSpan="3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_columnSpan="3"
                android:weightSum="3"
                app:layout_gravity="center_vertical"
                >
                <CheckBox
                    android:id="@+id/eng_require_pin_checkbox"
                    style="@style/GeneralEngineeringCheckBox"
                    android:text="@string/require_pin_pg"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    />

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_gen_pin_number_input"
                    style="@style/GeneralEditTextIntEngineering"
                    android:imeOptions="actionDone"
                    app:label="@string/pin_number_tc"
                    app:input_type="integer_input"
                    app:max_chars="@integer/max_pin_chars"
                    app:min_chars="@integer/max_pin_chars"
                    app:min_value="0"
                    app:max_value="9999"
                    android:layout_weight="1"
                    />
            </LinearLayout>

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_gen_screen_timeout"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/screen_timeout_in_seconds_tc"
                app:option_popup_width="400dp" />

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_dapi_env"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/dapi_env_tc"
                app:option_popup_width="400dp" />


            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_gen_reboot_inactive_time"
                android:visibility="gone"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:label="@string/reboot_inactive_time_tc"
                app:max_value="6"
                app:min_value="1"
                app:units="time_hours" />

            <RelativeLayout
                android:id="@+id/restore_line_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_columnSpan="3">

                <Button
                    android:id="@+id/eng_restore_defaults"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="300dp"
                    android:layout_marginRight="10dp"
                    android:text="@string/restore_defaults_tc" />

                <Button
                    android:id="@+id/eng_restore_factory_defaults"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="300dp"
                    android:text="@string/factory_reset_tc" />
            </LinearLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnWeight="1">

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:text="@string/software_version_history_tc" />

                <TextView
                    android:id="@+id/eng_software_package_version"
                    style="@style/GeneralEngineeringTextValue"
                    android:singleLine="false" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnWeight="1">

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:text="@string/firmware_version_tc" />

                <TextView
                    android:id="@+id/eng_software_firmware_version"
                    style="@style/GeneralEngineeringTextValue"
                    android:singleLine="false" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnWeight="1">

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:text="@string/app_versions_pg" />

                <TextView
                    android:id="@+id/eng_software_app_versions"
                    style="@style/GeneralEngineeringTextValue"
                    android:singleLine="false" />
            </LinearLayout>



        </androidx.gridlayout.widget.GridLayout>
    </ScrollView>


</RelativeLayout>