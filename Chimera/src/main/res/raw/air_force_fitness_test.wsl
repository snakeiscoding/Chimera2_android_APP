            lookup_value = M_OVER_60_VALUE[i]
            temp_score = M_OVER_60_SCORE[i]
            while  workoutTimeSec > lookup_value
                i = i + 1
                temp_score = M_OVER_60_SCORE[i]
                lookup_value = M_OVER_60_VALUE[i]

        TEST_SCORE_MALE = temp_score

    
        if AGE <= 24
