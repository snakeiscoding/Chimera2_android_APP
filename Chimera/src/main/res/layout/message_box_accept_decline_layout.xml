<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/messageBoxMainLayout"
              android:layout_width="500dp"
              android:layout_height="match_parent"
              android:background="#33FFFFFF"
              android:orientation="vertical"
              android:padding="10dp">

    <LinearLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#e6e6e6"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.jht.chimera.lib.widget.textview.AutofitTextView
            android:id="@+id/messageBoxTitleTextView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:padding="25dp"
            android:textColor="@android:color/black"
            android:textSize="30dp"/>

        <com.jht.chimera.lib.widget.selectron.SelectronButton
            android:id="@+id/messageBoxCloseImageButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:drawableBackground="#e6e6e6"
            app:drawableIcon="@drawable/ic_close_white"
            app:drawableIconTint="#000000"
            app:iconHeight="60dp"
            app:iconWidth="60dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1A1A1A"
        android:orientation="vertical">

        <TextView
            android:id="@+id/messageBoxInfoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:padding="15dp"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="20dp"/>


        <!-- Image buttons container -->
        <LinearLayout
            android:id="@+id/imageButtonsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:visibility="visible">

            <!-- Button 0 -->
            <com.jht.chimera.lib.widget.selectron.SelectronButton
                android:id="@+id/imageButton0"
                android:layout_width="200dp"
                android:layout_height="80dp"
                android:layout_gravity="end|top"
                android:layout_margin="10dp"
                android:visibility="visible"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="22dp"
                app:drawableBackground="#e1261c"/>

            <!-- Button 1 -->
            <com.jht.chimera.lib.widget.selectron.SelectronButton
                android:id="@+id/imageButton1"
                android:layout_width="200dp"
                android:layout_height="80dp"
                android:layout_gravity="end|top"
                android:layout_margin="10dp"
                android:visibility="visible"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:text="@string/accept_tc"
                android:textSize="22dp"
                app:drawableBackground="#3f9c47"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>