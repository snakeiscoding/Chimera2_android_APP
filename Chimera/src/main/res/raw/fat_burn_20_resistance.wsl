settings
    workout_id = 49
    allow_skip_warmup = 1
    allow_skip_workout = 1
    graph_future = 1
    allow_user_goal_changes = 1

input LEVEL
input TIME_GOAL_START
input COOLDOWN_TIME_START
input GOAL

export RESISTANCE
export GOAL_TYPE
export GOAL
export INCLINE

stage "workout"
    GOAL = TIME_GOAL_START
    GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
    INCLINE = 0
    
    totalIntervals = 16
    lastSetInterval = 0
    intervalCompletionTime = 0
    
    when STAGE_TIME_MS >= (GOAL - intervalCompletionTime) / (totalIntervals - interval) + intervalCompletionTime
        interval = interval + 1
    
    when lastSetInterval != interval
        intervalCompletionTime = STAGE_TIME_MS
        lastSetInterval = interval

    level 1
        LEVEL_1_RESISTANCE = [1, 4, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 4, 1]
        setIntervals RESISTANCE = LEVEL_1_RESISTANCE
    level 2
        LEVEL_2_RESISTANCE = [1, 4, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 4, 1]
        setIntervals RESISTANCE = LEVEL_2_RESISTANCE
    level 3
        LEVEL_3_RESISTANCE = [3, 5, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 8, 5, 3]
        setIntervals RESISTANCE = LEVEL_3_RESISTANCE
    level 4
        LEVEL_4_RESISTANCE = [3, 6, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 6, 3]
        setIntervals RESISTANCE = LEVEL_4_RESISTANCE
    level 5
        LEVEL_5_RESISTANCE = [4, 6, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 6, 4]
        setIntervals RESISTANCE = LEVEL_5_RESISTANCE
    level 6
        LEVEL_6_RESISTANCE = [4, 8, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 8, 4]
        setIntervals RESISTANCE = LEVEL_6_RESISTANCE
    level 7
        LEVEL_7_RESISTANCE = [5, 8, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 8, 5]
        setIntervals RESISTANCE = LEVEL_7_RESISTANCE
    level 8
        LEVEL_8_RESISTANCE = [5, 9, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 9, 5]
        setIntervals RESISTANCE = LEVEL_8_RESISTANCE
    level 9
        LEVEL_9_RESISTANCE = [6, 9, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 11, 9, 6]
        setIntervals RESISTANCE = LEVEL_9_RESISTANCE
    level 10
        LEVEL_10_RESISTANCE = [6, 10, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 10, 6]
        setIntervals RESISTANCE = LEVEL_10_RESISTANCE
    level 11
        LEVEL_11_RESISTANCE = [8, 10, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 13, 8, 10]
        setIntervals RESISTANCE = LEVEL_11_RESISTANCE
    level 12
        LEVEL_12_RESISTANCE = [8, 11, 14, 14, 14, 14, 14, 14, 14, 14, 14, 14, 14, 14, 11, 8]
        setIntervals RESISTANCE = LEVEL_12_RESISTANCE
    level 13
        LEVEL_13_RESISTANCE = [9, 11, 14, 14, 14, 14, 14, 14, 14, 14, 14, 14, 14, 14, 11, 9]
        setIntervals RESISTANCE = LEVEL_13_RESISTANCE
    level 14
        LEVEL_14_RESISTANCE = [9, 13, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 13, 9]
        setIntervals RESISTANCE = LEVEL_14_RESISTANCE
    level 15
        LEVEL_15_RESISTANCE = [10, 13, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 13, 10]
        setIntervals RESISTANCE = LEVEL_15_RESISTANCE
    level 16
        LEVEL_16_RESISTANCE = [10, 14, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 14, 10]
        setIntervals RESISTANCE = LEVEL_16_RESISTANCE
    level 17
        LEVEL_17_RESISTANCE = [11, 14, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 16, 14, 11]
        setIntervals RESISTANCE = LEVEL_17_RESISTANCE
    level 18
        LEVEL_18_RESISTANCE = [11, 15, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 18, 15, 11]
        setIntervals RESISTANCE = LEVEL_18_RESISTANCE
    level 19
        LEVEL_19_RESISTANCE = [13, 15, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 19, 15, 13]
        setIntervals RESISTANCE = LEVEL_19_RESISTANCE
    level 20
        LEVEL_20_RESISTANCE = [14, 19, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 19, 14]
        setIntervals RESISTANCE = LEVEL_20_RESISTANCE

stage "cooldown"
    interval
        GOAL = COOLDOWN_TIME_START
        GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
        RESISTANCE = 1
        INCLINE = 0
            
        when INTERVAL_TIME_MS >= GOAL
            end
