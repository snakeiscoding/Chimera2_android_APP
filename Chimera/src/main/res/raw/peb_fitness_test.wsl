settings
    workout_id = 37
    allow_skip_warmup = 1
    graph_future = 0
    allow_skip_workout = 1
    allow_user_goal_changes = 0

input COOLDOWN_TIME_START
input DISTANCE
input SPEED_IN
input GOAL
input GENDER
input AGE

export INCLINE
export GOAL_TYPE
export SPEED
export GOAL
export TEST_SCORE_MALE
export TEST_SCORE_FEMALE
export ALLOW_PAUSE

stage workout
    GOAL_TYPE = GOAL_TYPE_DISTANCE_STAGE_CONSTANT
    GOAL = 2.41402 // 1.5 miles
    ALLOW_PAUSE = 0
    
    SPEED = 0.8
    INCLINE = 0
    
    workoutCompleteTime = 0
    interval
        when DISTANCE >= GOAL
            workoutCompleteTime = INTERVAL_TIME_MS
            end

// Cooldown can only be reached by clicking on the cooldown button
stage cooldown
    INCLINE = 0
    GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
    GOAL = COOLDOWN_TIME_START
    SPEED = min(0.6 * SPEED_IN, 6.43738)
    
    interval
        when INTERVAL_TIME_MS >= GOAL
            end


// Values for peb test scores
MALE_VALUES_1 = [568, 596, 617, 634, 649, 664, 679, 693, 707, 720, 736, 752, 770, 790, 813, 841, 878, 928, 1015, 7200]
MALE_VALUES_2 = [574, 604, 625, 643, 661, 677, 690, 705, 720, 736, 752, 770, 789, 811, 838, 868, 907, 959, 1042, 7200]
MALE_VALUES_3 = [588, 622, 647, 667, 685, 702, 718, 735, 752, 770, 789, 810, 831, 856, 885, 918, 960, 1015, 1093, 7200]
