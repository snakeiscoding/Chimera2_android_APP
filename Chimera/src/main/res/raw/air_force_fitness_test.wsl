onStop
    if workoutCompleteTime > 0
        workoutTimeSec = workoutCompleteTime / 1000
        temp_score = 0
        if AGE <= 24
            i = 0  
            lookup_value = M_UNDER_25_VALUE[i]
            temp_score = M_UNDER_25_SCORE[i]
            while  workoutTimeSec > lookup_value 
                i = i + 1  
                temp_score = M_UNDER_25_SCORE[i]
                lookup_value = M_UNDER_25_VALUE[i]
    
        else if AGE > 24 && AGE <= 29
            i = 0  
            lookup_value = M_25_29_VALUE[i]
            temp_score = M_25_29_SCORE[i]
            while  workoutTimeSec > lookup_value 
                i = i + 1  
                temp_score = M_25_29_SCORE[i]
                lookup_value = M_25_29_VALUE[i]
    
        else if AGE > 29 && AGE <= 34
