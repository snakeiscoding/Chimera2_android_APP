settings
    workout_id = 14
    allow_skip_warmup = 1
    allow_skip_workout = 1
    graph_future = 0
    allow_user_goal_changes = 1

input DISTANCE_GOAL_START
input GOAL
input START_RESISTANCE
input COOLDOWN_TIME_START
input DISTANCE

export RESISTANCE
export GOAL
export GOAL_TYPE

stage "workout"
    interval
        RESISTANCE = START_RESISTANCE
        GOAL_TYPE = GOAL_TYPE_DISTANCE_STAGE_CONSTANT
        GOAL = DISTANCE_GOAL_START

        when STAGE_DISTANCE >= GOAL
            interval = interval + 1

stage "cooldown"
    interval
        RESISTANCE = 1
        GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
        GOAL = COOLDOWN_TIME_START

        when INTERVAL_TIME_MS >= GOAL
            end