<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:paddingBottom="5dp"
    android:background="#40000000">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/toggle_teamviewer_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/close_teamviewer_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/teamviewer_controls_label"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_constraintVertical_weight="2"
        android:layout_marginBottom="1dp"
        android:layout_marginEnd="1dp"
        app:srcCompat="@drawable/tm_icon_switch"
        android:background="@drawable/button_teamviewer"
        android:scaleType="centerInside"
        android:padding="5dp"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/close_teamviewer_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/toggle_teamviewer_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/toggle_teamviewer_button"
        app:layout_constraintBottom_toBottomOf="@id/toggle_teamviewer_button"
        app:srcCompat="@drawable/ic_close_black_80dp"
        android:scaleType="centerInside"
        android:padding="5dp"
        android:background="@drawable/button_teamviewer"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/teamviewer_controls_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toggle_teamviewer_button"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/button_teamviewer"
        android:text="@string/teamviewer_controls_tc"
        android:gravity="center"
        app:layout_constraintVertical_weight="1"
        app:autoSizeTextType="uniform"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:maxLines="1"
        android:textColor="#ff202020"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/left_arrow_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/teamviewer_controls_label"
        app:layout_constraintTop_toTopOf="@id/teamviewer_controls_label"
        app:layout_constraintBottom_toBottomOf="@id/teamviewer_controls_label"
        app:layout_constraintEnd_toEndOf="@id/teamviewer_controls_label"
        app:srcCompat="@drawable/icon_team_viewer_up"
        app:layout_constraintHorizontal_bias="0.01"
        app:layout_constraintWidth_percent="0.05"
        app:layout_constraintDimensionRatio="2:1"
        />

</androidx.constraintlayout.widget.ConstraintLayout>