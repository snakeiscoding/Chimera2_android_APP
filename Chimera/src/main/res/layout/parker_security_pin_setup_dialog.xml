<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/pin_setup_parker">

    <RelativeLayout
        android:id="@+id/security_pin_setup_window"
        android:layout_width="750dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/security_pin_dialog_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ic_security_pin_back_up"
            android:layout_width="50dp"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/security_pin_dialog_back_button"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/keypad_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/safety_pin_dialog_keypad_margin"
                android:text="@string/enter_your_security_pin_tc"
                android:textColor="@color/white"
                android:textSize="@dimen/safety_pin_dialog_title_text_size" />

            <LinearLayout
                android:id="@+id/et_pin_boxes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                >
                <EditText
                    android:id="@+id/pinInput1"
                    android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                    android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@color/white"
                    android:layout_marginEnd="@dimen/safety_pin_dialog_edit_text_margin" />
                <EditText
                    android:id="@+id/pinInput2"
                    android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                    android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@color/white"
                    android:layout_marginEnd="@dimen/safety_pin_dialog_edit_text_margin" />
                <EditText
                    android:id="@+id/pinInput3"
                    android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                    android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@color/white" />
                <EditText
                    android:id="@+id/pinInput4"
                    android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                    android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@color/white"
                    android:layout_marginStart="@dimen/safety_pin_dialog_edit_text_margin" />
            </LinearLayout>

            <com.jht.chimera.ui.DigitalSafetyPinKeypad
                android:id="@+id/pin_keypad"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginBottom="@dimen/safety_pin_dialog_keypad_margin" />
        </LinearLayout>


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>