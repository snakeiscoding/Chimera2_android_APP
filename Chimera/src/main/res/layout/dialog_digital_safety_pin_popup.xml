<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/pin_popup_background"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="@dimen/safety_pin_dialog_border"
        >

        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/safety_pin_dialog_title_text_size"
            android:text="@string/safety_pin_instructions_pg"
            android:layout_marginTop="@dimen/safety_pin_dialog_title_text_margin"
            />

        <TextView
            android:id="@+id/incorrect_pin_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/button_red"
            android:textSize="@dimen/safety_pin_dialog_error_text_size"
            android:text="@string/safety_pin_error_pg"
            android:layout_marginTop="@dimen/safety_pin_dialog_title_text_margin"
            android:layout_marginBottom="@dimen/safety_pin_dialog_title_text_margin"
            android:visibility="invisible"
            tools:visibility="visible"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <EditText
                android:id="@+id/otpET1"
                android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                android:inputType="number"
                android:maxLength="1"
                android:gravity="center"
                android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@color/white"
                android:layout_marginEnd="@dimen/safety_pin_dialog_edit_text_margin"
                android:editable="false"
                />
            <EditText
                android:id="@+id/otpET2"
                android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                android:inputType="number"
                android:maxLength="1"
                android:gravity="center"
                android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@color/white"
                android:layout_marginEnd="@dimen/safety_pin_dialog_edit_text_margin"
                android:editable="false"
                />
            <EditText
                android:id="@+id/otpET3"
                android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                android:inputType="number"
                android:maxLength="1"
                android:gravity="center"
                android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@color/white"
                android:editable="false"
                />
            <EditText
                android:id="@+id/otpET4"
                android:layout_width="@dimen/safety_pin_dialog_edit_text_width"
                android:layout_height="@dimen/safety_pin_dialog_edit_text_height"
                android:inputType="number"
                android:maxLength="1"
                android:gravity="center"
                android:textSize="@dimen/safety_pin_dialog_edit_text_size"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="@color/white"
                android:layout_marginStart="@dimen/safety_pin_dialog_edit_text_margin"
                android:editable="false"
                />
        </LinearLayout>

        <com.jht.chimera.ui.DigitalSafetyPinKeypad
            android:id="@+id/pin_keypad"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/safety_pin_dialog_keypad_margin"
            android:layout_marginBottom="@dimen/safety_pin_dialog_keypad_margin" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>