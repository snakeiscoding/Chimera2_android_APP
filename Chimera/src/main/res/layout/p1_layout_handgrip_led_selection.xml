<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_handgrip_led_selection"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title_header_text"
        android:text="@string/select_led_tc"
        android:textColor="@color/white"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="30sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/title_header_description"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/title_header_description"
        android:text="@string/select_led_message_tc"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_header_text"
        app:layout_constraintBottom_toTopOf="@id/basic_led"/>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/basic_led"
        android:background="@drawable/p1_item_selector"
        app:layout_constraintWidth_percent="0.15"
        app:layout_constraintDimensionRatio="1:1.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/none_led"
        app:layout_constraintTop_toBottomOf="@id/title_header_text"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/basic_led_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/p1_basic_led"
        app:layout_constraintStart_toStartOf="@id/basic_led"
        app:layout_constraintEnd_toEndOf="@id/basic_led"
        app:layout_constraintTop_toTopOf="@id/basic_led"
        app:layout_constraintBottom_toBottomOf="@id/basic_led" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/basic_led_text"
        android:text="@string/basic_tc"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="18sp"
        android:paddingTop="10dp"
        app:layout_constraintStart_toStartOf="@id/basic_led"
        app:layout_constraintEnd_toEndOf="@id/basic_led"
        app:layout_constraintTop_toBottomOf="@id/basic_led"/>

