<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/va_item_layout">

    <Space
        android:id="@+id/landmarks_item_space"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintDimensionRatio="W, 1:1.48"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/landmarks_item_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent=".757"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintWidth_percent="0.981"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintEnd_toEndOf="@id/landmarks_item_space"
        app:layout_constraintStart_toStartOf="@id/landmarks_item_space"
        app:layout_constraintTop_toTopOf="@id/landmarks_item_space"
        android:scaleType="centerCrop"
        android:background="#66000000"
        />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/landmarks_item_background"
        app:layout_constraintEnd_toEndOf="@id/landmarks_item_background"
        app:layout_constraintTop_toBottomOf="@id/landmarks_item_background"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#D8000000"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/landmarks_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        app:layout_constraintStart_toStartOf="@id/landmarks_item_background"
        app:layout_constraintEnd_toEndOf="@id/landmarks_item_background"
        app:layout_constraintTop_toBottomOf="@id/landmarks_item_background"
        app:layout_constraintBottom_toTopOf="@id/landmarks_item_goal"
        android:textColor="@android:color/white"
        android:gravity="center"
        tools:ignore="SpUsage" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/landmarks_item_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14dp"
        android:text="99 Floors"
        app:layout_constraintStart_toStartOf="@id/landmarks_item_space"
        app:layout_constraintEnd_toEndOf="@id/landmarks_item_space"
        app:layout_constraintTop_toBottomOf="@id/landmarks_item_title"
        app:layout_constraintBottom_toBottomOf="@id/landmarks_item_space"
        android:textColor="@android:color/white"
        android:gravity="center"
        tools:ignore="HardcodedText,SpUsage" />

</androidx.constraintlayout.widget.ConstraintLayout>