<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workout_selection_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:splitMotionEvents="false"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/target_training_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/gradient_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/target_training_background"
        app:layout_constraintEnd_toEndOf="@id/target_training_background"
        app:layout_constraintTop_toTopOf="@id/target_training_background"
        app:layout_constraintBottom_toBottomOf="@id/target_training_background"
        android:background="@drawable/shield_gradient"
        android:contentDescription="@null"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/vertical_title_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/workout_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/target_training_tc"
        android:textSize="48dp"
        android:paddingBottom="10dp"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toEndOf="@id/vertical_title_guideline"
        app:layout_constraintBottom_toTopOf="@id/workout_text"
        android:textStyle="bold"
        tools:ignore="HardcodedText,SpUsage" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/workout_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/target_training_info_pg"
        android:textSize="28dp"
        android:paddingBottom="20dp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintWidth_percent="0.785"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="@id/workout_title"
        app:layout_constraintBottom_toBottomOf="@id/target_training_background"
        tools:ignore="HardcodedText,SpUsage" />

    <RelativeLayout
        android:id="@+id/target_training_workout_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/background_gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/target_training_background"
        app:layout_constraintBottom_toBottomOf="parent">

    </RelativeLayout>



</androidx.constraintlayout.widget.ConstraintLayout>