<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ff191919"
    android:padding="20dp">

    <TextView
        android:id="@+id/workout_info_level"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:text=""
        android:textSize="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"
        android:textColor="@color/white"/>

    <TextView
        android:id="@+id/stat1_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/workout_info_level"
        app:layout_constraintStart_toStartOf="@id/workout_info_level"
        app:layout_constraintEnd_toEndOf="@id/workout_info_level"
        android:textSize="16dp"
        android:autoSizeTextType="uniform"
        android:text=""
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="start|center_vertical"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/stat1_average_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/workout_info_level"
        app:layout_constraintEnd_toStartOf="@id/stat1_max_label"
        app:layout_constraintTop_toBottomOf="@id/stat1_title"
        android:text="@string/average_tc"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="14dp"
        android:autoSizeTextType="uniform"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/stat1_max_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/stat1_average_label"
        app:layout_constraintEnd_toEndOf="@id/workout_info_level"
        app:layout_constraintTop_toTopOf="@id/stat1_average_label"
        app:layout_constraintBottom_toBottomOf="@id/stat1_average_label"
        android:text="@string/max_tc"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="14dp"
        android:autoSizeTextType="uniform"
        android:layout_marginStart="3dp"/>

    <TextView
        android:id="@+id/stat1_average"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/stat1_average_label"
        app:layout_constraintEnd_toEndOf="@id/stat1_average_label"
        app:layout_constraintTop_toBottomOf="@id/stat1_average_label"
        android:layout_marginTop="3dp"
        android:text="-"
        android:textSize="14dp"
        android:textColor="#ffd3d3d3"
        android:autoSizeTextType="uniform"/>

    <TextView
        android:id="@+id/stat1_max"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@id/stat1_max_label"
        app:layout_constraintEnd_toEndOf="@id/stat1_max_label"
        app:layout_constraintTop_toTopOf="@id/stat1_average"
        app:layout_constraintBottom_toBottomOf="@id/stat1_average"
        android:text="-"
        android:textSize="14dp"
        android:textColor="#ffd3d3d3"
        android:autoSizeTextType="uniform"/>

    <View
        android:id="@+id/stat_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ff808080"
        app:layout_constraintTop_toBottomOf="@id/stat1_average"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/stat2_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/stat_divider"
        app:layout_constraintStart_toStartOf="@id/workout_info_level"
        app:layout_constraintEnd_toEndOf="@id/workout_info_level"
        android:textSize="16dp"
        android:autoSizeTextType="uniform"
        android:text=""
        android:gravity="start|center_vertical"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/stat2_average_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/workout_info_level"
        app:layout_constraintEnd_toStartOf="@id/stat2_max_label"
        app:layout_constraintTop_toBottomOf="@id/stat2_title"
        android:text="@string/average_tc"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14dp"
        android:autoSizeTextType="uniform"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/stat2_max_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/stat2_average_label"
        app:layout_constraintEnd_toEndOf="@id/workout_info_level"
        app:layout_constraintTop_toTopOf="@id/stat2_average_label"
        app:layout_constraintBottom_toBottomOf="@id/stat2_average_label"
        android:text="@string/max_tc"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="14dp"
        android:autoSizeTextType="uniform"
        android:layout_marginStart="3dp"/>

    <TextView
        android:id="@+id/stat2_average"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/stat2_average_label"
        app:layout_constraintEnd_toEndOf="@id/stat2_average_label"
        app:layout_constraintTop_toBottomOf="@id/stat2_average_label"
        android:layout_marginTop="3dp"
        android:text="-"
        android:textSize="14dp"
        android:textColor="#ffd3d3d3"
        android:autoSizeTextType="uniform"/>

    <TextView
        android:id="@+id/stat2_max"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/stat2_max_label"
        app:layout_constraintEnd_toEndOf="@id/stat2_max_label"
        app:layout_constraintTop_toTopOf="@id/stat2_average"
        app:layout_constraintBottom_toBottomOf="@id/stat2_average"
        android:text="-"
        android:textSize="14dp"
        android:textColor="#ffd3d3d3"
        android:autoSizeTextType="uniform"/>


</androidx.constraintlayout.widget.ConstraintLayout>