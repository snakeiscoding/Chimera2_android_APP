            else
                NEXT_RESISTANCE = LEVEL_9_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_9_INCLINE[interval + 1]

        onLevelSwap
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_9_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_9_INCLINE[interval + 1]
    level 10
        setIntervals RESISTANCE = LEVEL_10_RESISTANCE
        setIntervals INCLINE = LEVEL_10_INCLINE
        when interval != nextSpeedInterval
            nextSpeedInterval = interval
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_10_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_10_INCLINE[interval + 1]

        onLevelSwap
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_10_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_10_INCLINE[interval + 1]
    level 11
        setIntervals RESISTANCE = LEVEL_11_RESISTANCE
        setIntervals INCLINE = LEVEL_11_INCLINE
        when interval != nextSpeedInterval
            nextSpeedInterval = interval
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_11_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_11_INCLINE[interval + 1]

        onLevelSwap
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_11_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_11_INCLINE[interval + 1]
    level 12
        setIntervals RESISTANCE = LEVEL_12_RESISTANCE
        setIntervals INCLINE = LEVEL_12_INCLINE
        when interval != nextSpeedInterval
            nextSpeedInterval = interval
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_12_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_12_INCLINE[interval + 1]

        onLevelSwap
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_12_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_12_INCLINE[interval + 1]
    level 13
        setIntervals RESISTANCE = LEVEL_13_RESISTANCE
        setIntervals INCLINE = LEVEL_13_INCLINE
        when interval != nextSpeedInterval
            nextSpeedInterval = interval
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_13_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_13_INCLINE[interval + 1]

        onLevelSwap
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
                NEXT_INCLINE = 0
            else
                NEXT_RESISTANCE = LEVEL_13_RESISTANCE[interval + 1]
                NEXT_INCLINE = LEVEL_13_INCLINE[interval + 1]
    level 14
        setIntervals RESISTANCE = LEVEL_14_RESISTANCE
        setIntervals INCLINE = LEVEL_14_INCLINE
        when interval != nextSpeedInterval
            nextSpeedInterval = interval
            if (interval == 14) // If this is the sprint before cooldown
                NEXT_RESISTANCE = 2
