<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#85000000" >

    <RelativeLayout
        android:id="@+id/dialog_container"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="90dp"
        android:background="#40e6e6e6">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:padding="10dp">


            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/tv_channel_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:label="@string/number_tc"
                app:input_type="text_input"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:inputType="textNoSuggestions"/>

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/tv_channel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:label="@string/name_tc"
                app:input_type="text_input"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_channel_number"
                android:inputType="textNoSuggestions"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/message_dialog_ok"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_channel_name"
                app:layout_constraintHorizontal_chainStyle="spread"
                android:background="@drawable/message_dialog_box_button_yes"
                app:layout_constraintEnd_toStartOf="@id/message_dialog_cancel" />
            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/message_dialog_cancel"
                android:background="@drawable/message_dialog_box_button_no"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_channel_name"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@id/message_dialog_ok"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>

</RelativeLayout>
