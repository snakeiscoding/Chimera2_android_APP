<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <!-- Calendar view -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calendar_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/calendar_guideline_middle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/calendar_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/day_label_table">

            <ImageView
                android:id="@+id/previous_month_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:layout_margin="24dp"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/month_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_arrow_left_white"
                />

            <TextView
                android:id="@+id/month_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="January, 2020"
                android:gravity="center"
                android:textSize="36dp"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/next_month_button"
                app:layout_constraintStart_toEndOf="@id/previous_month_button"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/next_month_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/month_name"
                app:layout_constraintEnd_toEndOf="parent"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@drawable/ic_arrow_right_white"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/day_label_table"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="0dp"
            android:columnCount="7"
            app:layout_constraintTop_toBottomOf="@+id/calendar_heading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/sunday_column_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="S"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.14" />
            <TextView
                android:id="@+id/monday_column_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.14"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/sunday_column_label"
                android:text="M"/>
            <TextView
                android:id="@+id/tuesday_column_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.14"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/monday_column_label"
                android:text="T"/>
            <TextView
                android:id="@+id/wednesday_column_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.14"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tuesday_column_label"
                android:text="W"/>
            <TextView
                android:id="@+id/thursday_column_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.14"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/wednesday_column_label"
                android:text="T"/>
            <TextView
                android:id="@+id/friday_column_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.14"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/thursday_column_label"
                android:text="F"/>
            <TextView
                android:id="@+id/saturday_column_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.14"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/friday_column_label"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="S"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/calendar_recycler"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_gravity="center"
            android:layout_marginTop="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="20dp"
            android:columnCount="7"
            android:rowCount="5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/day_label_table" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- The border -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/calendar_guideline_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/calendar_workout_split" />

    <View
        android:id="@+id/grey_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.004"
        app:layout_constraintStart_toEndOf="@id/calendar_guideline_middle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#2EFFFFFF"
        />

    <!-- Workout List -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/list_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="#E0000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/grey_bar"
        >

        <!-- Should we match padding with calendar_heading or create a guideline both headings can constrain to? -->
        <!-- TextView
            android:id="@+id/workout_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/black_white_text"
            android:text="@string/workouts_tc"
            android:textAlignment="center"
            android:textSize="24dp"
            android:padding="@dimen/calendar_workout_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" /-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/workout_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constrainedHeight="true"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/calendar_workout_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This is the CALENDAR fragment"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/-->

</androidx.constraintlayout.widget.ConstraintLayout>