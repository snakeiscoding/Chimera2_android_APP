<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    android:background="#26FFFFFF"
    android:padding="10dp"
    tools:ignore="HardcodedText">
    <Button
        android:id="@+id/tv_player_remote_button_1"
        style="@style/tv_remote_button"
        android:text="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="RtlHardcoded" />

    <Button
        android:id="@+id/tv_player_remote_button_2"
        style="@style/tv_remote_button"
        android:layout_marginLeft="10dp"
        android:text="2"
        app:layout_constraintLeft_toRightOf="@id/tv_player_remote_button_1"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="RtlHardcoded" />

    <Button
        android:id="@+id/tv_player_remote_button_3"
        style="@style/tv_remote_button"
        android:layout_marginLeft="10dp"
        android:text="3"
        app:layout_constraintLeft_toRightOf="@id/tv_player_remote_button_2"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="RtlHardcoded" />

    <Button
        android:id="@+id/tv_player_remote_button_4"
        style="@style/tv_remote_button"
        android:text="4"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_1"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_1" />

    <Button
        android:id="@+id/tv_player_remote_button_5"
        style="@style/tv_remote_button"
        android:text="5"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_2"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_2" />

    <Button
        android:id="@+id/tv_player_remote_button_6"
        style="@style/tv_remote_button"
        android:text="6"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_3"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_3" />

    <Button
        android:id="@+id/tv_player_remote_button_7"
        style="@style/tv_remote_button"
        android:text="7"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_4"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_4" />

    <Button
        android:id="@+id/tv_player_remote_button_8"
        style="@style/tv_remote_button"
        android:text="8"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_5"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_5" />

    <Button
        android:id="@+id/tv_player_remote_button_9"
        style="@style/tv_remote_button"
        android:text="9"
        android:layout_marginTop="10dp"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_6"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_6" />

    <Button
        android:id="@+id/tv_player_remote_button_dash"
        style="@style/tv_remote_button"
        android:layout_marginTop="10dp"
        android:text="-"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_7"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_7" />

    <Button
        android:id="@+id/tv_player_remote_button_0"
        style="@style/tv_remote_button"
        android:layout_marginTop="10dp"
        android:text="0"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_8"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_8" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/tv_player_remote_button_enter"
        style="@style/tv_remote_button"
        android:padding="5dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_9"
        app:layout_constraintTop_toBottomOf="@id/tv_player_remote_button_9"
        app:srcCompat="@drawable/ic_check_green_80dp" />
</androidx.constraintlayout.widget.ConstraintLayout>

