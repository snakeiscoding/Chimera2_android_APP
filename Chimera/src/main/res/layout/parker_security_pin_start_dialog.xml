<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="750dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/security_pin_start_window"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/security_pin_dialog_background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="90dp"
            android:paddingBottom="80dp">

            <TextView
                android:id="@+id/tx_security_pin_start_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/pin_setup_start_question_pg"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tx_security_pin_start_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingTop="10dp"
                android:paddingStart="80dp"
                android:paddingEnd="80dp"
                android:lineSpacingExtra="5dp"
                android:textSize="16sp"
                android:text="@string/pin_setup_start_info_pg"
                android:textColor="@color/white" />

            <LinearLayout
                android:id="@+id/security_pin_start_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingTop="60dp"
                android:paddingBottom="25dp">

                <Button
                    android:id="@+id/bt_maybe_later"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="50dp"
                    android:background="#446278"
                    android:text="@string/maybe_later_button_tc"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

                <Button
                    android:id="@+id/bt_setup"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:background="#446278"
                    android:text="@string/setup_button_tc"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>