<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heart_rate_layout_root_new"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerHorizontal="true"
    android:background="@drawable/activity_crosshatch_background"
    android:orientation="vertical">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
      />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/hGuidelineBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.425" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent=".6366"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/targetBPMTitle"

        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="start"

        android:text="@string/target_bpm_uc"
        android:textColor="#6D6D6D"
        android:textSize="30sp"
        android:textStyle="bold"
        android:includeFontPadding="false"

        app:autoSizeMaxTextSize="30dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/hGuidelineBottom"

        app:layout_constraintHeight_percent="0.04913"
        app:layout_constraintVertical_bias=".355"
        app:layout_constraintHorizontal_bias=".03"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/targetBPMValue"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="left"

        android:textColor="#B5B5B5"
        android:textSize="300sp"
        android:textStyle="bold"
        android:text="000"
        android:includeFontPadding="false"

        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="300dp"

        app:layout_constraintHeight_percent="0.3"

        app:layout_constraintHorizontal_bias="0.025"
        app:layout_constraintVertical_bias="1"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf= "parent"
        app:layout_constraintBottom_toTopOf="@id/hGuidelineBottom"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/currentBPMLabel"
        android:visibility="visible"

        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="right"
        android:layout_gravity="right"

        android:text="@string/current_bpm_uc"
        android:textStyle="bold"
        android:textColor="#6D6D6D"
        android:textSize="30sp"
        android:textAlignment="textEnd"
        android:includeFontPadding="false"

        app:autoSizeMaxTextSize="30dp"
        app:autoSizeTextType="uniform"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.97"
        app:layout_constraintEnd_toEndOf="@+id/currentBPMValueText"
        app:layout_constraintHeight_percent="0.04913"
        app:layout_constraintVertical_bias=".355"

        app:layout_constraintBottom_toTopOf="@id/hGuidelineBottom"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/currentBPMValueText"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="end"

        android:text="000"
        android:textColor="#B5B5B5"
        android:textSize="300sp"
        android:textStyle="bold"
        android:includeFontPadding="false"

        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="300sp"

        app:layout_constraintHeight_percent="0.3"

        app:layout_constraintVertical_bias="1"

        app:layout_constraintHorizontal_bias="0.97"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/hGuidelineBottom"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:id="@+id/submaximal_bpm_layout"
        android:layout_height="wrap_content"
        android:layout_width="400dp"
        android:layout_marginLeft="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias=".07"
        android:orientation="vertical"
        android:visibility="gone"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|left"
            android:text="@string/min_bpm_uc"
            android:textColor="#80a0a0a0"
            android:textSize="16dp"
            />
        <!--android:textSize="@dimen/heartRateTextSize"-->

        <TextView
            android:id="@+id/minBPMValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="---"
            android:gravity="center_vertical|left"
            android:textColor="#ffb5b5b5"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:textSize="56dp"
            />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/max_bpm_uc"
            android:gravity="center_vertical|left"
            android:textColor="#80a0a0a0"
            android:textSize="16dp"
            />
        <!--android:textSize="@dimen/heartRateTextSize"-->

        <TextView
            android:id="@+id/maxBPMValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="---"
            android:gravity="center_vertical|left"
            android:textColor="#ffb5b5b5"
            android:textStyle="bold"
            tools:ignore="HardcodedText"
            android:textSize="56dp"
            />

    </LinearLayout>


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fiveZonesBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/base_ring_back"
        android:visibility="visible"

        app:layout_constraintVertical_bias="0.37"
        app:layout_constraintWidth_percent="0.7476"
        app:layout_constraintHeight_percent="0.24"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/threeZonesBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/fiveZonesBackground"
        app:layout_constraintStart_toStartOf="@id/fiveZonesBackground"
        app:layout_constraintEnd_toEndOf="@id/fiveZonesBackground"
        app:layout_constraintTop_toTopOf="@id/fiveZonesBackground" />


    <include layout="@layout/include_bluetooth_button"
        android:id="@+id/bluetooth_pair_layout"
        android:visibility="gone"

        android:layout_width="0dp"
        android:layout_height="0dp"

        app:layout_constraintHeight_percent="0.0677"
        app:layout_constraintWidth_percent="0.19916"

        app:layout_constraintVertical_bias="0.433"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.jht.chimera.lib.widget.streamingimageview.StreamingImageView
        android:id="@+id/wavyLinesImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/heart_app_lines_00"
        app:baseFilename="lines_"
        app:basePath="/sdcard/jht/heart_strings"
        app:endIndex="80"
        app:fileExtension=".png"
        app:fps="18"
        app:frameIdFieldWidth="2"
        app:layout_constraintWidth_percent="0.76"
        app:layout_constraintHeight_percent="0.33"

        app:layout_constraintVertical_bias="0.23"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:speed="1.3"
        app:startIndex="0"
        app:useFileCache="true" />

    <com.jht.chimera.lib.widget.streamingimageview.StreamingImageView
        android:id="@+id/heartImageView"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:src="@drawable/heart_app_heart_00"
        app:baseFilename="heart_"
        app:basePath="/sdcard/jht/heart"
        app:endIndex="30"
        app:fileExtension=".png"
        app:fps="20"
        app:frameIdFieldWidth="2"
        app:layout_constraintDimensionRatio="3.5:5"

        app:layout_constraintHeight_percent="0.8133"
        app:layout_constraintVertical_bias="0.13"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:speed="1.0"
        app:startIndex="0"
        app:useFileCache="true" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/threeZones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/heart_app_target_training_zones"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/fiveZones"
        app:layout_constraintLeft_toLeftOf="@id/fiveZones"
        app:layout_constraintRight_toRightOf="@id/fiveZones"
        app:layout_constraintTop_toTopOf="@id/fiveZones" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fiveZones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/heart_app_zones_new"
        android:visibility="visible"
        app:layout_constraintWidth_percent="0.7625"
        app:layout_constraintHeight_percent="0.2"

        app:layout_constraintVertical_bias="0.57"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/zone0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/heart_app_zone0_new"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/fiveZones"
        app:layout_constraintLeft_toLeftOf="@id/fiveZones"
        app:layout_constraintRight_toRightOf="@id/fiveZones"
        app:layout_constraintTop_toTopOf="@id/fiveZones" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/zone1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/heart_app_zone1_new"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/fiveZones"
        app:layout_constraintLeft_toLeftOf="@id/fiveZones"
        app:layout_constraintRight_toRightOf="@id/fiveZones"
        app:layout_constraintTop_toTopOf="@id/fiveZones" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/zone2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/heart_app_zone2_new"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/fiveZones"
        app:layout_constraintLeft_toLeftOf="@id/fiveZones"
        app:layout_constraintRight_toRightOf="@id/fiveZones"
        app:layout_constraintTop_toTopOf="@id/fiveZones" />

    <androidx.appcompat.widget.AppCompatImageView

        android:id="@+id/zone3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/heart_app_zone3_new"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/fiveZones"
        app:layout_constraintLeft_toLeftOf="@id/fiveZones"
        app:layout_constraintRight_toRightOf="@id/fiveZones"
        app:layout_constraintTop_toTopOf="@id/fiveZones" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/zone4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/heart_app_zone4_new"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/fiveZones"
        app:layout_constraintLeft_toLeftOf="@id/fiveZones"
        app:layout_constraintRight_toRightOf="@id/fiveZones"
        app:layout_constraintTop_toTopOf="@id/fiveZones" />


    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/heartRateTotalTime"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center_vertical"
        app:layout_constraintVertical_bias="0.002"
        android:text=""
        android:textColor="#80a0a0a0"
        android:textSize="16sp"
        app:autoSizeMaxTextSize="16sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/workout_graph"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bpmView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/heartrate_marker"
        app:layout_constraintWidth_percent="0.0114"
        app:layout_constraintHeight_percent="0.0459"
        app:layout_constraintVertical_bias="0.25"
        app:layout_constraintStart_toStartOf="@id/fiveZones"
        app:layout_constraintTop_toTopOf="@id/fiveZones"
        app:layout_constraintBottom_toBottomOf="@id/fiveZones"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/currentMaxHRText"

        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="left"

        android:textColor="#B5B5B5"
        android:textSize="40dp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:text="@string/max_hr_tc"

        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="40dp"

        app:layout_constraintHeight_percent="0.10"

        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintVertical_bias=".1"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/hGuidelineBottom"
        app:layout_constraintStart_toStartOf="parent" />

    <include layout="@layout/include_workout_graph_heart_rate" />
</androidx.constraintlayout.widget.ConstraintLayout>