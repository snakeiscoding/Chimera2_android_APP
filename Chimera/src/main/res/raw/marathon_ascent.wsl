settings
    workout_id = 77
    allow_skip_warmup = 0
    allow_skip_workout = 0
    graph_future = 0
    allow_user_goal_changes = 0

input START_RESISTANCE
input START_INCLINE

export RESISTANCE
export INCLINE
export GOAL_TYPE

stage "workout"
    interval
        RESISTANCE = START_RESISTANCE
        INCLINE = START_INCLINE
        GOAL_TYPE = GOAL_TYPE_NONE_CONSTANT