<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/standard_button_selector"
              android:orientation="horizontal">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtStringItem"
        style="@style/SettingsButton"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:textSize="18dp"
        app:autoSizeMaxTextSize="18dp"/>

    <com.jht.chimera.lib.widget.selectron.SelectronButton
        android:id="@+id/btnInfo"
        android:layout_width="@dimen/settings_button_height"
        android:layout_height="@dimen/settings_button_height"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:drawableBackground="@android:color/transparent"
        app:drawableIcon="@drawable/ic_info_white"
        app:drawablePressState="@android:color/transparent"
        app:iconHeight="45dp"
        app:iconWidth="45dp"
    />


</LinearLayout>