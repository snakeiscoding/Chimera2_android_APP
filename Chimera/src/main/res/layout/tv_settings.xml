<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_settings_window"
    android:background="@drawable/background_color_slate_blue"
    style="@style/EngineeringPage"
    tools:ignore="SpUsage, RtlHardcoded, RtlSymmetry" >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/eng_tv_channel_settings"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_channel_setup_back"
        app:layout_constraintEnd_toStartOf="@id/eng_tv_player_surface_container" >


        <Button
            android:id="@+id/eng_tv_import_channels_usb"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/eng_tv_export_channels_usb"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/import_channel_list_from_usb_tc" />


        <Button
            android:id="@+id/eng_tv_export_channels_usb"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toEndOf="@id/eng_tv_import_channels_usb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/export_channel_list_to_usb_tc" />

        <Button
            android:id="@+id/eng_tv_import_from_tuner"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_import_channels_usb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/import_from_tuner_tc" />

        <Button
            android:id="@+id/eng_tv_upgrade_km4"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_import_from_tuner"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/update_from_usb_tc" />


        <Button
            android:id="@+id/eng_tv_sknet_get_channels"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/eng_tv_sknet_scan"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:layout_marginStart="20dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/get_channels_tc" />


        <Button
            android:id="@+id/eng_tv_sknet_scan"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toEndOf="@id/eng_tv_sknet_get_channels"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/scan_tc" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/tv_channel_import_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="eng_tv_import_from_tuner,eng_tv_export_channels_usb,eng_tv_import_channels_usb,eng_tv_upgrade_km4,eng_tv_sknet_get_channels,eng_tv_sknet_scan" />

        <!--

        <Button
            android:id="@+id/eng_tv_check_for_updates"
            style="@style/GeneralEngineeringButton"
            android:layout_width="wrap_content"
            android:padding="10dp"
            android:text="@string/update_from_usb_tc"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_import_from_tuner"
            app:layout_constraintStart_toEndOf="@id/eng_tv_channel_list_container"/>
    -->
        <RelativeLayout
            android:id="@+id/eng_tv_default_channel_container"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tv_channel_import_barrier"
            app:layout_constraintBottom_toTopOf="@id/eng_tv_channel_list_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_tv_default_channel_selector"
                style="@style/GeneralEngineeringOptionSelector"
                android:layout_width="300dp"
                android:paddingEnd="0dp"
                android:paddingTop="0dp"
                android:paddingStart="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:padding="0dp"
                android:layout_margin="0dp"
                app:label="@string/default_tv_channel_tc"
                app:option_popup_width="400dp" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_tv_player_default_channel_input"
                style="@style/GeneralEditTextStringEngineering"
                android:layout_width="300dp"
                android:padding="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:layout_gravity="center"
                android:gravity="center"
                app:label="@string/default_tv_channel_tc"
                android:imeOptions="actionDone"
                app:min_value="0" />
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/eng_tv_channel_list_container"
            style="@style/jht_standard_container"
            android:layout_width="350dp"
            android:layout_height="0dp"
            android:background="#FF575E65"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_default_channel_container"
            app:layout_constraintBottom_toTopOf="@id/eng_stb_command_list_container"
            tools:ignore="RtlSymmetry">
            <androidx.recyclerview.widget.RecyclerView
                style="@style/jht_standard_inner_recycle_container"
                android:id="@+id/eng_tv_channel_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/eng_stb_command_list_container"
            android:layout_width="350dp"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eng_tv_channel_list_container"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_stb_command_option"
                android:layout_width="260dp"
                app:option_popup_width="300dp"
                android:layout_marginTop="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread"
                android:layout_height="wrap_content"
                app:label="command list"/>

            <Button
                android:id="@+id/eng_stb_command_go"
                style="@style/GeneralEngineeringButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="right"
                app:layout_constraintStart_toEndOf="@id/eng_stb_command_option"
                app:layout_constraintHorizontal_chainStyle="spread"
                android:layout_centerInParent="false"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="280dp"
                android:padding="10dp"
                android:text="@string/go_tc" />
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/eng_tv_player_surface_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foregroundGravity="clip_horizontal|clip_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_settings_eng_keypad"
        app:layout_constraintStart_toEndOf="@id/eng_tv_channel_settings"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintDimensionRatio="16:9"
        tools:ignore="RtlHardcoded">

        <TextureView
            android:id="@+id/eng_tv_player_texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <SurfaceView
            android:id="@+id/eng_tv_player_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextureView
            android:id="@+id/eng_vlc_player_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.jht.iptvplayer.SubtitleBitmapView
            android:id="@+id/eng_tv_subtitles_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <RelativeLayout
        android:id="@+id/tv_surface_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/eng_tv_player_surface_container"
        app:layout_constraintTop_toTopOf="@id/eng_tv_player_surface_container"
        app:layout_constraintLeft_toLeftOf="@id/eng_tv_player_surface_container"
        app:layout_constraintRight_toRightOf="@id/eng_tv_player_surface_container"
        android:background="#ff000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/enseo_splash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foregroundGravity="clip_horizontal|clip_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_settings_eng_keypad"
        app:layout_constraintStart_toEndOf="@id/eng_tv_channel_settings"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintDimensionRatio="16:9"
        android:src="@drawable/enseo"
        android:background="#ff000000"
        android:scaleType="center"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/tv_keypad_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="tv_settings_eng_keypad,tv_settings_eng_extended_controls" />

    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/eng_tv_sknet_target_address"
        style="@style/GeneralEditTextStringIpAddressEngineering"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_player_surface_container"
        app:layout_constraintStart_toStartOf="@id/eng_tv_player_surface_container"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="300dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:layout_height="wrap_content"
        app:label="Target Address" />

    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/eng_tv_sknet_target_port"
        style="@style/GeneralEditTextIntEngineering"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_player_surface_container"
        app:layout_constraintStart_toEndOf="@id/eng_tv_sknet_target_address"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:layout_marginLeft="100dp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        app:label="Target Port" />


    <com.jht.chimera.lib.widget.tv.TVKeypad
        android:id="@+id/tv_settings_eng_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_settings_eng_extended_controls"
        app:layout_constraintStart_toStartOf="@id/eng_tv_player_surface_container"/>

    <com.jht.chimera.lib.widget.tv.TVExtendedControls
        android:id="@+id/tv_settings_eng_extended_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintEnd_toEndOf="@id/eng_tv_player_surface_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_settings_eng_keypad" />

    <com.jht.chimera.lib.widget.tv.TVColorButtons
        android:id="@+id/tv_channel_setup_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintRight_toRightOf="@id/eng_tv_player_surface_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/tv_settings_eng_extended_controls" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/tv_channel_setup_back"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:srcCompat="@drawable/back_button"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:background="@drawable/standard_button"
        app:tint="@color/standard_button_tint"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <Button
        android:id="@+id/eng_tv_enseo_legacy"
        style="@style/GeneralEngineeringButton"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_player_surface_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/eng_tv_player_surface_container"
        app:layout_constraintEnd_toStartOf="@id/eng_tv_enseo_initialize"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/enseo_enable_legacy_tc" />

    <Button
        android:id="@+id/eng_tv_enseo_initialize"
        style="@style/GeneralEngineeringButton"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_player_surface_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/eng_tv_enseo_legacy"
        app:layout_constraintEnd_toStartOf="@id/eng_tv_enseo_complete"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/initialize_tc" />


    <Button
        android:id="@+id/eng_tv_enseo_complete"
        style="@style/GeneralEngineeringButton"
        android:layout_width="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/eng_tv_player_surface_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/eng_tv_enseo_initialize"
        app:layout_constraintEnd_toEndOf="@id/eng_tv_player_surface_container"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/export_channels_to_tuner" />


</androidx.constraintlayout.widget.ConstraintLayout>