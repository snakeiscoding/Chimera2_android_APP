<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">


    <FrameLayout
        android:id="@+id/tv_player_surface_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foregroundGravity="clip_horizontal|clip_vertical">

        <TextureView
            android:id="@+id/tv_player_texture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <SurfaceView
            android:id="@+id/tv_player_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextureView
            android:id="@+id/vlc_player_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <com.jht.iptvplayer.SubtitleBitmapView
            android:id="@+id/tv_subtitles_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00ffffff" />

    </FrameLayout>

    <RelativeLayout
        android:id="@+id/tv_surface_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ff000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/enseo_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/enseo"
        android:background="#ff000000"
        android:scaleType="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/closed_caption_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_stats_window"
        android:visibility="gone"
        android:layout_marginBottom="80dp"
        android:background="#000000"
        android:textSize="36dp"
        android:padding="10dp"
        android:textColor="@color/white" />

    <com.jht.chimera.lib.widget.statbar.StatOverlay
        android:id="@+id/tv_stats_window"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,2.5:1"
        android:background="#00ffff00"
        android:layout_marginLeft="225dp"
        android:layout_marginRight="225dp"
        android:layout_marginBottom="30dp"/>

    <Space
        android:id="@+id/km4_channel_info_box"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_user_interface"
        android:layout_width="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/km4_channel_info_box"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tv_controls_layout"
            android:layout_width="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="20dp"
            android:background="#BF000000"
            android:layout_height="match_parent">


            <RelativeLayout
                android:id="@+id/tv_player_channel_selector_container"
                style="@style/jht_standard_container"
                android:layout_width="400dp"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:layout_marginLeft="20dp"
                android:layout_marginBottom="100dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="RtlHardcoded">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tv_player_channel_selector"
                    style="@style/jht_standard_inner_recycle_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FF575E65" />
            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/tv_player_remote_close_1"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="#00FFFFFF"
                app:srcCompat="@drawable/ic_close_white" />

            <com.jht.chimera.lib.widget.tv.TVAppKeypad
                android:id="@+id/tv_keypad_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_player_remote_close_1" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/tv_channel_change_barrier_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="right"
                app:constraint_referenced_ids="tv_keypad_buttons,tv_player_channel_selector_container"/>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/tv_channel_change_barrier_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tv_keypad_buttons,tv_player_channel_selector_container"/>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/tv_channel_change_barrier_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="left"
                app:constraint_referenced_ids="tv_keypad_buttons,tv_player_channel_selector_container"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/tv_player_remote_close_2"
                android:layout_width="50dp"
                android:layout_height="60dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:layout_constraintLeft_toLeftOf="@id/tv_player_remote_button_row"
                app:layout_constraintRight_toRightOf="@id/tv_player_remote_button_row"
                app:layout_constraintTop_toTopOf="parent"
                android:paddingBottom="10dp"
                android:background="#00ffffff"
                app:srcCompat="@drawable/ic_close_white" />


            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/tv_channel_close_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tv_player_remote_close_2,tv_player_remote_close_1"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tv_player_remote_button_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toRightOf="@id/tv_channel_change_barrier_right"
                app:layout_constraintTop_toBottomOf="@id/tv_channel_close_barrier"
                android:layout_marginTop="0dp"
                android:layout_marginLeft="20dp"
                >

                <LinearLayout
                    android:id="@+id/tv_player_channel_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#26FFFFFF"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:gravity="center"
                    android:padding="10dp"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_player_channel_up"
                        style="@style/tv_app_remote_button"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:padding="15dp"
                        app:srcCompat="@drawable/ic_arrow_up_black" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        app:srcCompat="@drawable/ic_icon_channel"/>
                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_player_channel_down"
                        style="@style/tv_app_remote_button"
                        android:adjustViewBounds="true"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/ic_arrow_down_black" />

                </LinearLayout>

                <LinearLayout

                    android:id="@+id/tv_player_additional_remote_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#26FFFFFF"
                    app:layout_constraintLeft_toLeftOf="@id/tv_player_channel_change"
                    app:layout_constraintTop_toBottomOf="@id/tv_player_channel_change"
                    android:layout_marginTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_player_last_channel"
                        style="@style/tv_app_remote_button"
                        android:padding="15dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="10dp"
                        app:srcCompat="@drawable/ic_icon_previous_channels" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_player_closed_captioning"
                        style="@style/tv_app_remote_button"
                        android:layout_marginTop="10dp"
                        android:padding="15dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_icon_cc" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_player_sap"
                        style="@style/tv_app_remote_button"
                        app:srcCompat="@drawable/ic_audio_track"
                        android:scaleType="fitCenter"
                        android:padding="12dp"
                        android:layout_marginTop="10dp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_remote_info"
                        style="@style/tv_app_remote_button"
                        android:layout_marginTop="10dp"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        app:layout_constraintLeft_toLeftOf="@id/eng_tv_control_left"
                        app:layout_constraintTop_toBottomOf="@id/eng_tv_control_left"
                        app:srcCompat="@drawable/button_info_navigation" />


                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_remote_guide"
                        style="@style/tv_app_remote_button"
                        android:layout_marginTop="10dp"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        app:layout_constraintLeft_toLeftOf="@id/eng_tv_control_left"
                        app:layout_constraintTop_toBottomOf="@id/eng_tv_control_left"
                        app:srcCompat="@drawable/ic_tv_icon_guide"
                        android:visibility="gone"/>

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/tv_remote_back"
                        style="@style/tv_app_remote_button"
                        android:layout_marginTop="10dp"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        app:layout_constraintLeft_toLeftOf="@id/eng_tv_control_left"
                        app:layout_constraintTop_toBottomOf="@id/eng_tv_control_left"
                        app:srcCompat="@drawable/ic_tv_icon_back" />


                </LinearLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>



            <LinearLayout
                android:id="@+id/tv_player_volume_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#26FFFFFF"
                app:layout_constraintLeft_toLeftOf="@id/tv_channel_change_barrier_left"
                app:layout_constraintRight_toRightOf="@id/tv_channel_change_barrier_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_channel_change_barrier_bottom"
                android:gravity="center"
                android:padding="10dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/tv_player_volume_down"
                    style="@style/tv_app_remote_button"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_arrow_left_black_80dp" />
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    app:srcCompat="@drawable/ic_icon_tv_vol"/>
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/tv_player_volume_up"
                    style="@style/tv_app_remote_button"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    app:srcCompat="@drawable/ic_arrow_right_black_80dp" />
            </LinearLayout>

            <!--
            <LinearLayout
                android:id="@+id/tv_player_jp_closed_captioning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#26FFFFFF"
                app:layout_constraintLeft_toRightOf="@id/tv_player_volume_change"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_channel_change_barrier_bottom"
                app:layout_constraintRight_toRightOf="@id/tv_channel_change_barrier_right"
                android:gravity="center"
                android:padding="10dp"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/tv_player_jp_closed_caption_button"
                    style="@style/tv_app_remote_button"
                    android:padding="15dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_icon_cc" />
            </LinearLayout>
-->
        </androidx.constraintlayout.widget.ConstraintLayout>


        <com.jht.chimera.lib.widget.button.FullscreenButton
            android:id="@+id/tv_player_expand"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="20dp"
            app:drawableIconTint="@android:color/white"

            app:drawableBackground="#00000000"
            app:drawablePressState="#303030"
            app:iconWidth="60dp"
            app:iconHeight="60dp"
            />

        <ImageButton
            android:id="@+id/tv_player_stat_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentDescription="@null"
            android:padding="25dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/tv_stat_toggle"
            app:layout_constraintTop_toTopOf="@id/tv_player_expand"
            app:layout_constraintBottom_toBottomOf="@id/tv_player_expand"
            app:layout_constraintRight_toLeftOf="@id/tv_player_expand" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/dolby_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:scaleType="centerInside"
        android:layout_gravity="right"
        android:layout_marginTop="80dp"
        android:layout_marginRight="10dp"
        android:background="#000000"
        android:src="@drawable/dolby_audio_white"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>