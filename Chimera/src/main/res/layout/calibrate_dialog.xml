<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#85000000"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/dialog_container"
        app:layout_constraintHeight_percent=".4"
        app:layout_constraintWidth_percent=".4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="#40e6e6e6">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:background="#ff000000">

            <TextView
                android:id="@+id/calibrate_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#FFE6E6E6"
                android:gravity="center"
                android:padding="10dp"
                android:textColor="@android:color/black"
                app:autoSizeMaxTextSize="30dp"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@id/calibrate_dialog_message"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                tools:ignore="SpUsage" />

            <TextView
                android:id="@+id/calibrate_dialog_message"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:textSize="22dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toTopOf="@id/calibrate_dialog_button"
                app:layout_constraintTop_toBottomOf="@id/calibrate_dialog_title"
                android:layout_margin="10dp"
                android:gravity="center"
                app:layout_constraintHeight_percent=".4"
                app:layout_constraintVertical_bias="0"
                android:textColor="@android:color/white"
                tools:ignore="SpUsage" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/calibrate_dialog_button"
                app:layout_constraintTop_toBottomOf="@id/calibrate_dialog_message"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="20dp"
                style="@style/GeneralEngineeringButton"
                android:text="" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>