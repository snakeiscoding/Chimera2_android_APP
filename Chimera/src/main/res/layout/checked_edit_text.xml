<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/checked_edit_box_layout"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="left"
              android:orientation="vertical">
    <RelativeLayout
        android:id="@+id/edit_box_only_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/checked_edit_box"
            style="@style/TextEntry"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="text"
        />

        <com.jht.chimera.lib.widget.selectron.SelectronButton
            android:id="@+id/checked_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:focusable="false"
            android:clickable="false"
            app:drawableBackground="@android:color/transparent"/>

        <TextView
            android:id="@+id/checked_edit_end_text_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/checked_edit_box"
            android:layout_toLeftOf="@id/checked_image"
            android:focusable="false"
            android:padding="10dp"
            android:textColor="#666666"
            android:textSize="22dp"
        />

    </RelativeLayout>

    <TextView
        android:id="@+id/error_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#ff0014"
        android:gravity="center_vertical|left"
        android:focusable="false"
        android:padding="5dp"
        android:textColor="@android:color/white"
        android:textSize="20dp"
        android:visibility="gone"/>

</LinearLayout>