<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#85000000" >

    <RelativeLayout
        android:id="@+id/dialog_container"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="35dp"
        android:background="#40e6e6e6">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:padding="10dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/network_dialog_ssid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:label="@string/network_ssid_tc"
                    app:input_type="text_input"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone" />
            </RelativeLayout>

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/network_dialog_security"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:label="@string/security_tc"
                app:option_popup_width="400dp"
                app:option_options="@array/hidden_security_type"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" >
                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/network_dialog_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:label="@string/password_tc"
                    app:input_type="text_input"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone" />
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <CheckBox
                    style="@style/jht_checkbox"
                    android:id="@+id/network_dialog_show_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_password_tc" />
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">
                    <Button
                        android:layout_width="175dp"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:id="@+id/network_dialog_connect"
                        android:background="@drawable/standard_button"
                        android:textColor="#FF000000"
                        android:text="@string/connect_tc" />
                </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">
                        <Button
                            android:layout_width="175dp"
                            android:layout_height="40dp"
                            android:layout_centerInParent="true"
                            android:id="@+id/network_dialog_cancel"
                            android:textColor="#FF000000"
                            android:background="@drawable/standard_button"
                            android:text="@string/cancel_tc" />
                    </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
