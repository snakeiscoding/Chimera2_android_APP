<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/selector_item_height"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="5dp">

    <LinearLayout
        android:id="@+id/tv_channel_list_channel_info_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_item_background"
        android:orientation="horizontal"
        android:paddingStart="@dimen/selector_item_text_margin"
        tools:ignore="RtlSymmetry">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_channel_list_channel_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="@string/no_channel_info_tc"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:gravity="center"
            android:textColor="@color/selector_text_color"
            android:textSize="@dimen/selector_item_text_size"
            android:autoSizeMaxTextSize="@dimen/selector_item_text_size"
            android:autoSizeTextType="uniform"
            android:textStyle="bold"
            tools:ignore="SpUsage"
            tools:targetApi="o" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/tv_channel_list_edit_channel"
            android:layout_width="@dimen/selector_item_height"
            android:layout_height="@dimen/selector_item_height"
            app:srcCompat="@drawable/ic_edit_black"
            android:background="#00ffffff"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/tv_channel_list_delete_channel"
            android:layout_width="@dimen/selector_item_height"
            android:layout_height="@dimen/selector_item_height"
            app:srcCompat="@drawable/icon_x"
            android:background="#00ffffff"/>

        <CheckBox
            android:id="@+id/tv_channel_enabled"
            style="@style/selector_checkbox"
            android:layout_marginRight="10dp"
            android:layout_gravity="center"
            tools:ignore="RtlHardcoded" />


    </LinearLayout>
    <Button
        android:id="@+id/tv_channel_new_button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_item_background"
        android:textColor="@color/selector_text_color"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/add_channel_tc"/>

</RelativeLayout>
