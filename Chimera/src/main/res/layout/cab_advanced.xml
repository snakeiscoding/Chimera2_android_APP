<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#85000000" >

    <RelativeLayout
        android:id="@+id/dialog_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="90dp"
        android:background="#40e6e6e6">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#ff000000"
            android:padding="10dp">



            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/cab_volume"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/volume_tc"
                app:input_type="integer_input"
                android:layout_marginTop="20dp"
                app:min_value="0"
                app:max_value="15"
                app:max_chars="2"
                app:default_value="15"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@id/cab_volume_gain"
                app:layout_constraintTop_toTopOf="parent"
                android:inputType="textNoSuggestions"/>

            <Button
                android:id="@+id/cab_volume_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/GeneralEngineeringButton"
                android:text="@string/set_tc"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/cab_volume"
                app:layout_constraintLeft_toLeftOf="@id/cab_volume"
                app:layout_constraintRight_toRightOf="@id/cab_volume"/>

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/cab_volume_gain"
                style="@style/GeneralEngineeringOptionSelector"
                android:layout_width="300dp"
                android:paddingEnd="0dp"
                android:paddingTop="0dp"
                android:paddingStart="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:padding="0dp"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                app:label="Volume Gain"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toRightOf="@id/cab_volume"
                app:layout_constraintRight_toLeftOf="@id/cab_stb_setting"
                app:option_popup_width="400dp"
                app:option_options="@array/cab_setting"/>

            <Button
                android:id="@+id/cab_volume_gain_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/GeneralEngineeringButton"
                android:text="@string/set_tc"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/cab_volume_gain"
                app:layout_constraintLeft_toLeftOf="@id/cab_volume_gain"
                app:layout_constraintRight_toRightOf="@id/cab_volume_gain"/>

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/cab_stb_setting"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:label="@string/volume_tc"
                app:input_type="integer_input"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="20dp"
                app:min_value="0"
                app:max_value="99"
                app:max_chars="2"
                app:default_value="0"
                android:layout_marginRight="20dp"
                app:layout_constraintLeft_toRightOf="@id/cab_volume_gain"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:inputType="textNoSuggestions"/>

            <Button
                android:id="@+id/cab_stb_set"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/GeneralEngineeringButton"
                android:text="@string/set_tc"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/cab_stb_setting"
                app:layout_constraintLeft_toLeftOf="@id/cab_stb_setting"
                app:layout_constraintRight_toRightOf="@id/cab_stb_setting"/>



            <CheckBox
                android:id="@+id/DATA_CAB_CLOSED_CAPTIONING_BOOL"
                style="@style/GeneralEngineeringCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/closed_captioning_tc"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cab_stb_set" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/message_dialog_ok"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/DATA_CAB_CLOSED_CAPTIONING_BOOL"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread"
                android:background="@drawable/message_dialog_box_button_yes"
                app:layout_constraintRight_toRightOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>

</RelativeLayout>
