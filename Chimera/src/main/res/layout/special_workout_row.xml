<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/special_workout_row"
    android:paddingTop="10dp"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/eng_special_workout_name"
        style="@style/GeneralEngineeringTextValue"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/eng_special_workout_remove" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/eng_special_workout_remove"
        style="@style/tv_remote_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/message_dialog_box_button_no" />

</androidx.constraintlayout.widget.ConstraintLayout>
