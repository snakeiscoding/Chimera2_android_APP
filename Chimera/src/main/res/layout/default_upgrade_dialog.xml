<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/dialog_container"
        app:layout_constraintHeight_percent=".5"
        app:layout_constraintWidth_percent=".5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/dialog_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="#40e6e6e6"></View>

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/dialog_title"

            app:layout_constraintHeight_percent=".2"
            app:layout_constraintWidth_percent=".97"

            app:layout_constraintLeft_toLeftOf="@id/dialog_border"
            app:layout_constraintRight_toRightOf="@id/dialog_border"
            app:layout_constraintTop_toTopOf="@id/dialog_border"
            app:layout_constraintBottom_toBottomOf="@id/upgrade_message"
            app:layout_constraintVertical_bias="0.1"
            android:background="@android:color/white"
            android:textSize="35dp"
            android:textColor="@android:color/black"
            android:gravity="center"
            />

        <TextView
            android:id="@+id/upgrade_message"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="@id/dialog_title"
            app:layout_constraintRight_toRightOf="@id/dialog_title"
            app:layout_constraintBottom_toBottomOf="@id/dialog_button"
            app:layout_constraintTop_toBottomOf="@id/dialog_title"
            android:gravity="center"
            app:layout_constraintHeight_percent=".5"
            app:layout_constraintVertical_bias="0"
            android:background="#bb000000"
            android:textColor="@android:color/white"
            />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="@id/upgrade_message"
            app:layout_constraintRight_toRightOf="@id/upgrade_message"
            app:layout_constraintTop_toBottomOf="@id/upgrade_message"
            app:layout_constraintBottom_toBottomOf="@id/dialog_border"

            app:layout_constraintVertical_bias="0"


            android:background="#bb000000"

            app:layout_constraintHeight_percent=".2"></View>


        <Button
            android:id="@+id/dialog_button"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent=".15"
            app:layout_constraintWidth_percent=".25"
            app:layout_constraintLeft_toLeftOf="@id/upgrade_message"
            app:layout_constraintRight_toRightOf="@id/upgrade_message"
            app:layout_constraintTop_toBottomOf="@id/upgrade_message"
            app:layout_constraintBottom_toBottomOf="@id/dialog_border"
            app:layout_constraintVertical_bias=".3"
            android:text="@string/ok_uc"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>