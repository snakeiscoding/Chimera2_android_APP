<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/top_bar_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/left_background_view"
        style="?attr/left_right_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/top_bar_next_value_percentage" />

    <TextView
        android:id="@+id/left_value_text_view"
        style="?attr/left_right_value_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="60"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/left_background_view"
        app:layout_constraintEnd_toStartOf="@id/left_unit_text_view"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@id/left_background_view"
        app:layout_constraintTop_toTopOf="@id/left_background_view"
        tools:ignore="HardcodedText,SpUsage" />

    <TextView
        android:id="@+id/left_unit_text_view"
        style="?attr/left_right_unit_text"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="3dp"
        android:gravity="center"
        android:text="@string/mph_lc"
        android:textColor="@android:color/black"
        app:layout_constraintBottom_toBottomOf="@id/left_value_text_view"
        app:layout_constraintEnd_toEndOf="@id/left_background_view"
        app:layout_constraintStart_toEndOf="@id/left_value_text_view"
        app:layout_constraintTop_toTopOf="@id/left_value_text_view" />

    <TextView
        android:id="@+id/left_label_text_view"
        style="?attr/next_increment_label_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:text="@string/next_incline_uc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_background_view"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/right_background_view"
        style="?attr/left_right_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/top_bar_next_value_percentage" />

    <TextView
        android:id="@+id/right_value_text_view"
        style="?attr/left_right_value_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="7"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/right_background_view"
        app:layout_constraintEnd_toStartOf="@id/right_unit_text_view"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@id/right_background_view"
        app:layout_constraintTop_toTopOf="@id/right_background_view"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/right_unit_text_view"
        style="?attr/left_right_unit_text"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="3dp"
        android:gravity="center"
        android:text="%"
        android:textColor="@android:color/black"
        app:layout_constraintBottom_toBottomOf="@id/right_value_text_view"
        app:layout_constraintEnd_toEndOf="@id/right_background_view"
        app:layout_constraintStart_toEndOf="@id/right_value_text_view"
        app:layout_constraintTop_toTopOf="@id/right_value_text_view"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/right_label_text_view"
        style="?attr/next_increment_label_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:text="@string/next_resistance_uc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/right_background_view"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/countdown_text_view"
        style="?attr/countdown_label_text"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

</androidx.constraintlayout.widget.ConstraintLayout>