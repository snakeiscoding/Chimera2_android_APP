<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <com.jht.androiduiwidgets.edittext.UserTextInput
            android:id="@+id/machine_setup_console_serial_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:imeOptions="actionNext"
            app:auto_correct="true"
            app:edit_width="280dp"
            app:label="@string/console_serial_number_tc"
            app:max_chars="@integer/max_serial_number_chars"
            app:textfilter="allcaps|digits" />

        <com.jht.androiduiwidgets.edittext.UserTextInput
            android:id="@+id/machine_setup_frame_serial_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:imeOptions="actionDone"
            app:auto_correct="true"
            app:edit_width="280dp"
            app:label="@string/frame_serial_number_tc"
            app:max_chars="@integer/max_serial_number_chars"
            app:textfilter="allcaps|digits" />

        <com.jht.androiduiwidgets.edittext.UserTextInput
            android:id="@+id/machine_setup_club_id"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:imeOptions="actionDone"
            app:auto_correct="true"
            app:edit_width="280dp"
            app:input_type="integer_input"
            app:label="@string/club_id_tc"
            app:max_chars="5"
            app:min_value="0"
            app:max_value="65535"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/machine_setup_import_serial_numbers"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/standard_button"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/import_serial_numbers_tc"
        android:textColor="#FF000000"
        android:textSize="18dp"
        app:srcCompat="@drawable/back_button"
        tools:ignore="SpUsage" />

    <Space
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_lcb_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#aaffffff"
        android:textStyle="bold"
        android:layout_gravity="right"
        android:textSize="16dp"
        android:layout_margin="10dp"
        tools:ignore="HardcodedText" />

</LinearLayout>
