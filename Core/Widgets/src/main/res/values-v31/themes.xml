<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- hide the splash icon when spinning up the new process (API 31+) -->
    <style name="Theme.NoSplash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent</item>
    </style>
</resources>