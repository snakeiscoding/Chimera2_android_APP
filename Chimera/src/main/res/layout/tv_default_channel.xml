<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    tools:ignore="SpUsage, RtlHardcoded, RtlSymmetry" >

    <com.jht.androiduiwidgets.selector.OptionSelectorItem
        android:id="@+id/tv_channel_setup_default_selector"
        style="@style/GeneralEngineeringOptionSelector"
        android:layout_width="match_parent"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingStart="0dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:padding="0dp"
        app:label="@string/default_tv_channel_tc"
        app:option_popup_width="400dp" />

    <com.jht.androiduiwidgets.edittext.UserTextInput
        android:id="@+id/tv_channel_setup_default_entry"
        style="@style/GeneralEditTextStringEngineering"
        android:layout_width="match_parent"
        android:padding="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        app:label="@string/default_tv_channel_tc"
        android:imeOptions="actionDone"
        app:min_value="0" />

</RelativeLayout>