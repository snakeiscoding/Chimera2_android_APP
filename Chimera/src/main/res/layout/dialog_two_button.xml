<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#bb000000"
    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="20dp"
        android:background="#88444444"
        android:orientation="vertical"
        >

        <com.jht.chimera.lib.widget.textview.AutofitTextView
            android:id="@+id/titleMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical|left"
            android:padding="10dp"
            android:text=" --- "
            android:textColor="#FFF"
            android:textSize="24dp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="#222"
            >

            <com.jht.chimera.lib.widget.selectron.SelectronButton
                android:id="@+id/leftButton"
                android:layout_width="100dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:textAlignment="center"
                app:drawableBackground="@color/button_red"
                app:drawableIcon="@drawable/ic_close_white"
                app:iconHeight="40dp"
                app:iconWidth="40dp"
                />

            <com.jht.chimera.lib.widget.selectron.SelectronButton
                android:id="@+id/rightButton"
                android:layout_width="100dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:textAlignment="center"
                app:drawableBackground="@color/button_green"
                app:drawableIcon="@drawable/ic_check_white"
                app:iconHeight="40dp"
                app:iconWidth="40dp"
                />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>