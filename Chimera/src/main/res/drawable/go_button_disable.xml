<?xml version="1.0" encoding="UTF-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Drop shadow (second is added when clicked) -->
  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
      <gradient android:type="radial"
          android:centerColor="#000000"
          android:endColor="@android:color/transparent"
          android:startColor="#ffffff"
          android:gradientRadius="50%"/>
      <padding android:bottom="10dp" android:left="5dp" android:right="5dp" android:top="2.5dp" />
    </shape>
  </item>

  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
      <gradient android:type="radial"
          android:centerColor="#000000"
          android:endColor="@android:color/transparent"
          android:startColor="#ffffff"
          android:gradientRadius="50%"/>
      <padding android:bottom="10dp" android:left="5dp" android:right="5dp" android:top="2.5dp" />
    </shape>
  </item>

  <!-- Button -->
  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
      <solid android:color="@android:color/white" />
      <!--<size android:width="184dp" android:height="184dp" />-->
    </shape>
  </item>

  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
      <stroke android:width="8dp" android:color="@android:color/transparent" />
      <solid android:color="#002c0c" />
    </shape>
  </item>

  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
      <stroke android:color="@android:color/transparent" android:width="14dp"/>
      <solid android:color="#009b13" />
    </shape>
  </item>

  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
      <stroke android:color="@android:color/transparent" android:width="18dp" />
      <gradient android:startColor="#FcFFFD" android:endColor="#06AA25" android:angle="270" />
    </shape>
  </item>

  <item>
    <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
      <stroke android:color="@android:color/transparent" android:width="22dp" />
      <gradient android:startColor="#2f5c34" android:endColor="#2f6c34" android:angle="270" />
    </shape>
  </item>


</layer-list>