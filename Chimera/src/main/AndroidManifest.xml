        <!-- TODO remove android:supportsRtl once Andy fixes va parser-->

        <!-- Could be useful for profiling -->
        <!--<profileable android:shell="true" />-->

        <!-- taskAffinity is just a name for dedicated android UI activity stack that is created by starting with new task flag, it does not need to match process -->
        <!-- It appears whichever stack or "taskAffinity" splash starts becomes the "home" stack -->

        <!-- SPLASH APP -->
        <!-- If we give splash and blank mainapp taskAffinity, then anything bailing to the launcher should just go back to our app. However do we want that? What if bail was unexpected? -->
        <!--  Keeping last UI as the launcher can make android home button more predictable, but we do not use android home button -->
        <!-- If we give splash and blank own taskAffinity, then if something bails to the launcher there is a window for our UI flow to take action before we fail over to splash? -->
        <!--  Falling back to blank as the launcher can make transitions a little smoother when an app bails to launcher -->
        <activity
            android:name="com.jht.splashapp.SplashScreenActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|keyboardHidden|screenSize|locale|layoutDirection|touchscreen"
            android:process="com.jht.splashapp"
            android:taskAffinity="com.jht.mainapp"
            android:exported="true"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.HOME" />
            </intent-filter>
        </activity>
        <!-- BOOT_COMPLETED seems to always start after splash app so not needed?
        <receiver
            android:name="com.jht.splashapp.ServiceStarter"
            android:process="com.jhtp.splashapp">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        -->
        <!-- Blank cleans up transition, but can also act as a catch if an app crashes. Keep it with splash screen -->
        <activity
