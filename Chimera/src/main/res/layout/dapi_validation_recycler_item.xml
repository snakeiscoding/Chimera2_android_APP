<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/command"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="32dp"
        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="32dp"
        android:maxLines="1"
        android:gravity="start|center_vertical"
        android:background="#5B6770"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/dapiResult"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dapiResult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textColor="#FFFFFF"
        android:textSize="32dp"
        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="32dp"
        android:maxLines="1"
        android:background="#5B6770"
        android:gravity="start|center_vertical"
        app:layout_constraintLeft_toRightOf="@id/command"
        app:layout_constraintRight_toRightOf="@id/fieldsResult"
        app:layout_constraintTop_toTopOf="@id/command"
        app:layout_constraintBottom_toBottomOf="@id/command"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/fieldsResult"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:textColor="#FFFFFF"
        android:textSize="32dp"
        app:autoSizeTextType="uniform"
        app:autoSizeMaxTextSize="32dp"
        android:maxLines="1"
        android:background="#5B6770"
        android:gravity="start|center_vertical"
        app:layout_constraintLeft_toRightOf="@id/dapiResult"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/command"
        app:layout_constraintBottom_toBottomOf="@id/command"/>

    <TextView
        android:id="@+id/error_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#C1C5C8"
        android:textColor="#000000"
        android:textSize="32dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/command"
        app:layout_constraintLeft_toLeftOf="@id/command"
        app:layout_constraintRight_toRightOf="@id/fieldsResult"/>

</androidx.constraintlayout.widget.ConstraintLayout>