<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stat_item_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/stat_item_bg"
    android:padding="5dp">

    <androidx.constraintlayout.widget.Group
        android:id="@+id/default_stat_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        app:constraint_referenced_ids="value_text_box, title_text_box" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/value_text_box"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="10"
        android:textColor="#333333"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="@dimen/stat_item_text_size"
        app:autoSizeTextType="uniform"
        tools:ignore="HardcodedText" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title_text_box"
        android:layout_width="0dp"
        android:layout_height="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="48dp"
        app:autoSizeMaxTextSize="16dp"
        app:autoSizeMinTextSize="12dp"
        app:autoSizeTextType="uniform"
        android:fontFamily="sans-serif"
        android:gravity="center|top"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:text="TEST_TEXT"
        android:textColor="#666666"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <ViewStub
        android:id="@+id/split_stat_view_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/stat_item_split_view"/>

    <ViewStub
        android:id="@+id/evolt_stat_view_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/stat_item_view_evolt"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/stat_view_top_right_image_view"
        android:layout_width="15dp"
        android:layout_height="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="invisible"
        app:srcCompat="@drawable/ic_stack"/>

    <ImageView
        android:id="@+id/icon_image_view"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerInside"/>

</androidx.constraintlayout.widget.ConstraintLayout>