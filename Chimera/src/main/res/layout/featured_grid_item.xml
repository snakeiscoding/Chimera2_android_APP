<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/grid_item_layout">

    <ImageView
        android:id="@+id/grid_item_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        app:layout_constraintDimensionRatio="1.54:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/grid_item_background_disabled"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/tiers_disabled"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/grid_item_background"
        app:layout_constraintStart_toStartOf="@id/grid_item_background"
        app:layout_constraintEnd_toEndOf="@id/grid_item_background"
        app:layout_constraintBottom_toBottomOf="@id/grid_item_background"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/grid_item_text"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:lineSpacingMultiplier="1.2"
        android:maxLines="2"
        android:textColor="#CCCCCC"
        android:textSize="16dp"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grid_item_background"
        tools:ignore="SpUsage" />
</androidx.constraintlayout.widget.ConstraintLayout>