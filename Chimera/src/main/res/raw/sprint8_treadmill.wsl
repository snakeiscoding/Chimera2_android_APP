stage "warmup"
    PREVENT_USER_GOAL_CHANGES = 1
    SPEED = 0.80467
    INCLINE = 0
    GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
    GOAL = 3 * 60 * 1000
    INTERVAL_GOAL_TYPE = GOAL_TYPE_TIME_CONSTANT
    INTERVAL_GOAL = 3 * 60 * 1000
    IS_SPRINTING = 0
    
    // When it is time to ramp
    when IS_RAMPING != 1 && ((INTERVAL_TIME_MS >= GOAL - (abs(NEXT_SPEED - SPEED_IN) / RAMP_RATE_SPEED) * 1000) || (INTERVAL_TIME_MS >= GOAL - (abs(NEXT_INCLINE - INCLINE_IN) / RAMP_RATE_INCLINE) * 1000))
        SPEED = NEXT_SPEED
        INCLINE = NEXT_INCLINE
        IS_RAMPING = 1
        
    when INTERVAL_TIME_MS >= GOAL
        IS_RAMPING = 0
        interval = interval + 1
    
    level 1
        interval
            NEXT_SPEED = LEVEL_1_SPEED[0]
            NEXT_INCLINE = LEVEL_1_INCLINE[0]

        onLevelSwap
            NEXT_SPEED = LEVEL_1_SPEED[0]
            NEXT_INCLINE = LEVEL_1_INCLINE[0]
    level 2
        interval
            NEXT_SPEED = LEVEL_2_SPEED[0]
            NEXT_INCLINE = LEVEL_2_INCLINE[0]

        onLevelSwap
            NEXT_SPEED = LEVEL_2_SPEED[0]
            NEXT_INCLINE = LEVEL_2_INCLINE[0]
    level 3
