settings
    workout_id = 35
    allow_skip_warmup = 1
    graph_future = 1
    allow_skip_workout = 1
    allow_user_goal_changes = 0

input COOLDOWN_TIME_START
input DISTANCE
input SPEED_IN
input GOAL
input GENDER
input AGE

export INCLINE
export GOAL_TYPE
export SPEED
export GOAL
export TEST_SCORE_MALE
export TEST_SCORE_FEMALE
export ALLOW_PAUSE
export PREVENT_USER_GOAL_CHANGES

stage workout
    GOAL_TYPE = GOAL_TYPE_DISTANCE_STAGE_CONSTANT
    GOAL = 2.41402 // 1.5 miles
    ALLOW_PAUSE = 0
    
    SPEED = 0.8
    INCLINE = 0
    PREVENT_USER_GOAL_CHANGES = 1
    
    workoutCompleteTime = 0
    interval
        when STAGE_DISTANCE >= GOAL
            workoutCompleteTime = INTERVAL_TIME_MS
            end

// Cooldown can only be reached by clicking on the cooldown button
stage cooldown
    INCLINE = 0
    GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
    GOAL = COOLDOWN_TIME_START
    SPEED = min(0.6 * SPEED_IN, 6.43738)
    PREVENT_USER_GOAL_CHANGES = 0
    
    interval
        when INTERVAL_TIME_MS >= GOAL
            end

