<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/EngineeringPage">


    <TextView
        android:id="@+id/experimental_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/experimental_warning_pg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="20dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpUsage" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#90000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/experimental_warning" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/experimental_warning"
        tools:ignore="HardcodedText">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/experimental_analytics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                tools:ignore="RtlHardcoded"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <CheckBox
                    android:id="@+id/enable_analytics"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enable Analytics Per Workout" />

                <Button
                    android:id="@+id/export_analytics"
                    style="@style/GeneralEngineeringButton"
                    android:layout_marginLeft="20dp"
                    android:layout_width="100dp"
                    android:text="Export"
                    tools:ignore="RtlHardcoded" />

                <Button
                    android:id="@+id/reset_analytics"
                    style="@style/GeneralEngineeringButton"
                    android:layout_marginLeft="20dp"
                    android:layout_width="100dp"
                    android:text="Reset"
                    tools:ignore="RtlHardcoded" />

                <Button
                    android:id="@+id/view_analytics"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="100dp"
                    android:layout_marginLeft="20dp"
                    android:text="View"
                    tools:ignore="RtlHardcoded" />


            </LinearLayout>

            <CheckBox
                android:id="@+id/force_downgrade_updates_checkbox"
                style="@style/GeneralEngineeringCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:text="Updates Downgrade"
                app:layout_constraintLeft_toLeftOf="@id/experimental_analytics"
                app:layout_constraintTop_toBottomOf="@id/experimental_analytics" />

            <Button
                android:id="@+id/clear_updates"
                style="@style/GeneralEngineeringButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Clear update service"
                android:layout_marginLeft="20dp"
                app:layout_constraintLeft_toRightOf="@id/force_downgrade_updates_checkbox"
                app:layout_constraintTop_toTopOf="@id/force_downgrade_updates_checkbox"
                app:layout_constraintBottom_toBottomOf="@id/force_downgrade_updates_checkbox"/>

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_max_workout_time"
                style="@style/GeneralEditTextIntEngineering"
                android:layout_height="wrap_content"
                android:layout_width="400dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:imeOptions="actionDone"
                app:label="Warranty Overriding Max Workout Time"
                app:input_type="integer_input"
                app:max_value="6000"
                app:min_value="@integer/min_workout_time"
                app:max_chars="4"
                app:units="time_minutes"
                app:layout_constraintLeft_toLeftOf="@id/force_downgrade_updates_checkbox"
                app:layout_constraintTop_toBottomOf="@id/force_downgrade_updates_checkbox"
                />

            <LinearLayout
                android:id="@+id/experimental_bandwidth"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toLeftOf="@id/experimental_analytics"
                app:layout_constraintTop_toBottomOf="@id/eng_max_workout_time">

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_bandwidth_web_page"
                    style="@style/GeneralEditTextStringEngineering"
                    android:imeOptions="actionDone"
                    android:layout_width="600dp"
                    app:input_type="url_input"
                    app:label="@string/bandwidth_test_tc" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/enable_egym"
                        android:visibility="gone"
                        style="@style/GeneralEngineeringCheckBox"
                        android:layout_marginTop="5dp"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="eGym" />

                    <TextView
                        android:id="@+id/egym_update_time_label"
                        style="@style/GeneralEngineeringTextHeading"
                        android:layout_marginStart="30dp"
                        android:layout_gravity="center_vertical"
                        android:text="@string/automatic_update_tc" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/egym_update_time"
                        style="@style/GeneralEditTextStringEngineering"
                        android:layout_marginStart="20dp"
                        android:layout_width="200dp"
                        app:input_type="time_clock"
                        app:picker_animation="@style/EngTimeUpdateDialogAnimation" />
                </LinearLayout>


                <com.jht.androiduiwidgets.selector.OptionSelectorItem
                    android:id="@+id/egym_environment"
                    style="@style/GeneralEngineeringOptionSelector"
                    app:label="eGym Environment"
                    android:layout_width="600dp"
                    android:layout_marginTop="20dp"
                    app:option_popup_width="400dp" />

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_hdmi_error_threshold"
                    style="@style/GeneralEditTextIntEngineering"
                    android:imeOptions="actionDone"
                    android:layout_width="600dp"
                    app:input_type="integer_input"
                    app:max_value="5"
                    app:min_value="1"
                    app:label="HDMI Error Threshold" />

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_deinterlace_skip_frame"
                    style="@style/GeneralEditTextIntEngineering"
                    android:imeOptions="actionDone"
                    android:layout_width="600dp"
                    app:input_type="integer_input"
                    app:max_value="5"
                    app:min_value="0"
                    app:label="Deinterlace Skip Frame Count" />

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_recent_workout_app_limit"
                    style="@style/GeneralEditTextIntEngineering"
                    android:imeOptions="actionDone"
                    android:layout_width="600dp"
                    app:input_type="integer_input"
                    app:max_value="15"
                    app:min_value="1"
                    app:label="Recent Workout App Limit" />

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_distance_precision"
                    style="@style/GeneralEditTextIntEngineering"
                    android:imeOptions="actionDone"
                    android:layout_width="0dp"
                    app:layout_constraintLeft_toLeftOf="@id/enable_analytics"
                    app:layout_constraintTop_toBottomOf="@id/eng_recent_workout_app_limit"
                    app:layout_constraintWidth_percent="0.45"
                    app:input_type="integer_input"
                    android:layout_marginTop="20dp"
                    app:max_value="3"
                    app:min_value="0"
                    app:label="Distance Display Precision" />

                <com.jht.androiduiwidgets.selector.OptionSelectorItem
                    android:id="@+id/eng_iptv_player_type"
                    style="@style/GeneralEngineeringOptionSelector"
                    android:layout_width="600dp"
                    app:label="IPTV Player Type"
                    app:option_popup_width="400dp" />

                <CheckBox
                    android:id="@+id/show_stb_command_list_checkbox"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp"
                    android:text="Show STB Command List" />
            </LinearLayout>


            <RelativeLayout
                android:id="@+id/analytics_line_break"
                style="@style/engineering_line_break"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/experimental_bandwidth"
                app:layout_constraintBottom_toTopOf="@id/custom_passcode_layout"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/custom_passcode_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/analytics_line_break"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toTopOf="@id/passcode_line_break">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/custom_passcode_checkbox_and_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="@id/custom_passcode_layout"
                    app:layout_constraintBottom_toTopOf="@id/custom_passcode_entry_and_confirmation"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent">

                    <CheckBox
                        android:id="@+id/enable_settings_lockout"
                        style="@style/GeneralEngineeringCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/enable_settings_lockout_tc"
                        app:layout_constraintTop_toTopOf="@id/custom_passcode_checkbox_and_description"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@id/settings_lockout_description"
                        app:layout_constraintBottom_toBottomOf="@id/custom_passcode_checkbox_and_description"
                        />

                    <TextView
                        android:id="@+id/settings_lockout_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/GeneralEngineeringTextValue"
                        android:text="@string/settings_lockout_description_pg"
                        android:textSize="20sp"
                        android:layout_marginLeft="20dp"
                        android:singleLine="false"
                        app:layout_constraintTop_toTopOf="@id/custom_passcode_checkbox_and_description"
                        app:layout_constraintBottom_toBottomOf="@id/custom_passcode_checkbox_and_description"
                        app:layout_constraintLeft_toRightOf="@id/enable_settings_lockout"
                        app:layout_constraintRight_toRightOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/custom_passcode_entry_and_confirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="20dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/custom_passcode_checkbox_and_description">

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/enter_custom_passcode"
                        style="@style/GeneralEditTextStringEngineering"
                        android:layout_width="0dp"
                        android:layout_marginTop="20dp"
                        android:imeOptions="actionDone"
                        app:label="@string/enter_custom_passcode_tc"
                        app:layout_constraintLeft_toLeftOf="@id/custom_passcode_entry_and_confirmation"
                        app:layout_constraintTop_toTopOf="@id/custom_passcode_entry_and_confirmation"
                        app:layout_constraintWidth_percent="0.45" />

                    <com.jht.androiduiwidgets.edittext.UserTextInput
                        android:id="@+id/confirm_custom_passcode"
                        style="@style/GeneralEditTextStringEngineering"
                        android:layout_width="0dp"
                        android:layout_marginTop="20dp"
                        android:imeOptions="actionDone"
                        app:label="@string/confirm_custom_passcode_tc"
                        app:layout_constraintLeft_toRightOf="@id/enter_custom_passcode"
                        app:layout_constraintTop_toTopOf="@id/custom_passcode_entry_and_confirmation"
                        app:layout_constraintWidth_percent="0.45" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <Button
                    android:id="@+id/apply_passcode"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="@string/apply_passcode_tc"
                    app:layout_constraintLeft_toLeftOf="@id/custom_passcode_checkbox_and_description"
                    app:layout_constraintTop_toBottomOf="@id/custom_passcode_entry_and_confirmation"
                    tools:ignore="RtlHardcoded" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:id="@+id/passcode_line_break"
                style="@style/engineering_line_break"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/custom_passcode_layout"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/passcode_line_break" >

                <CheckBox
                    android:id="@+id/crash_monitoring"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crash Monitoring"
                    android:layout_marginTop="20dp"/>


                <CheckBox
                    android:id="@+id/persistent_logs"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Persistent Logs"
                    android:layout_marginTop="20dp"/>

                <CheckBox
                    android:id="@+id/DATA_POWER_LIMITING_BOOL"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Power Limit Check (reboot required)"
                    android:layout_marginTop="20dp" />

                <CheckBox
                    android:id="@+id/DATA_ADB_VIA_NETWORK_BOOL"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/network_adb_tc"
                    android:layout_marginTop="20dp"/>

                <CheckBox
                    android:id="@+id/eng_nightly_updates"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_for_nightly_updates_tc"
                    android:layout_marginTop="20dp"/>

                <CheckBox
                    android:id="@+id/force_hide_ifit"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Force hide ifit"
                    android:layout_marginTop="20dp"/>

                <Button
                    android:id="@+id/eng_remove_iFit_marker"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="200dp"
                    android:layout_marginVertical="20dp"
                    android:text="@string/remove_ifit_marker_tc"
                    android:visibility="gone"/>

                <com.jht.androiduiwidgets.selector.OptionSelectorItem
                    android:id="@+id/workout_snapshot_selector"
                    style="@style/GeneralEngineeringOptionSelector"
                    android:layout_width="400dp"
                    app:label="@string/workout_snapshots_tc"
                    app:option_popup_width="400dp" />

                <com.jht.androiduiwidgets.edittext.UserTextInput
                    android:id="@+id/eng_gen_club_id"
                    style="@style/GeneralEditTextIntEngineering"
                    android:layout_width="400dp"
                    android:imeOptions="actionDone"
                    app:label="@string/club_id_tc"
                    app:max_chars="5"
                    app:max_value="65535"
                    app:min_value="0" />

                <com.jht.androiduiwidgets.selector.OptionSelectorItem
                    android:id="@+id/eng_dapi_env"
                    style="@style/GeneralEngineeringOptionSelector"
                    android:layout_width="wrap_content"
                    app:label="@string/dapi_env_tc"
                    app:option_popup_width="400dp" />


                <com.jht.androiduiwidgets.selector.OptionSelectorItem
                    android:id="@+id/chameleon"
                    style="@style/GeneralEngineeringOptionSelector"
                    android:layout_width="wrap_content"
                    app:label="UI System (some features may need reboot)"
                    app:option_popup_width="400dp" />
                <CheckBox
                    android:id="@+id/chameleon_autohide"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use Autohide Panels with non-Legacy UI" />

                <com.jht.androiduiwidgets.selector.OptionSelectorItem
                    android:id="@+id/eng_upload_theme"
                    style="@style/GeneralEngineeringOptionSelector"
                    android:layout_width="wrap_content"
                    app:label="Dynamic Theme"
                    app:option_popup_width="400dp" />

                <CheckBox
                    android:id="@+id/enable_stb_streaming"
                    style="@style/GeneralEngineeringCheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Use LG750E for streaming apps" />

                <TextView
                    android:id="@+id/build_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="16dp"
                    tools:ignore="SpUsage" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <TextView
        android:id="@+id/text_lcb_type"
        style="@style/GeneralEngineeringTextHeading"
        android:layout_marginEnd="30dp"
        android:layout_width="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
