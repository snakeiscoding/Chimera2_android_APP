<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/egym_root_layout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/welcome_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:adjustViewBounds="true"
        android:cropToPadding="false"
        android:scaleType="fitXY"/>

    <ImageView
        android:id="@+id/welcome_background2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:adjustViewBounds="true"
        android:cropToPadding="false"
        android:scaleType="fitXY"/>

    <ImageView
        android:id="@+id/egym_touch_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:visibility="invisible"
        android:background="#80000000"
        android:src="@drawable/hand_icon"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="30dp"

        />

    <LinearLayout
        android:id="@+id/egym_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/mx14_generations_splash_bg"
        android:visibility="gone"
        tools:visibility="visible">

        <include
            layout="@layout/top_bar_widget"
            android:layout_width="0dp"
            android:layout_height="@dimen/top_bar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_icon_wifi_disconnected" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <TextView
                style="@style/GeneralEngineeringTextHeading"
                android:layout_gravity="center_vertical"
                android:text="@string/no_network_pg"
                android:textSize="30dp" />

            <TextView
                style="@style/GeneralEngineeringTextHeading"
                android:layout_gravity="center_vertical"
                android:text="@string/check_router_console_settings_tc"
                android:textSize="24dp" />

            <Button
                android:id="@+id/btn_refesh"
                android:layout_width="325dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/default_button_selector1"
                android:drawableLeft="@drawable/ic_icon_reload"
                android:drawablePadding="15dp"
                android:gravity="left|center_vertical"
                android:paddingLeft="100dp"
                android:text="@string/refresh_tc"
                android:textAllCaps="false"
                android:textColor="#020303"
                android:textSize="22dp"
                android:textStyle="bold"
                app:backgroundTint="#FFE6E6E6" />

            <Button
                android:id="@+id/btn_matrix"
                android:layout_width="325dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:background="@drawable/default_button_selector1"
                android:drawableLeft="@drawable/ic_logo_matrix_inverted"
                android:drawablePadding="15dp"
                android:gravity="left|center_vertical"
                android:paddingLeft="60dp"
                android:contentDescription="matrix button"
                android:textAllCaps="false"
                android:textColor="#020303"
                android:textSize="22dp"
                android:textStyle="bold"
                app:backgroundTint="#FFE6E6E6" />


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



</RelativeLayout>