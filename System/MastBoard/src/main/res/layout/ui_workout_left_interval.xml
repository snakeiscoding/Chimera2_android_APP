<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ui_workout_left_interval"
    android:layout_width="240dp"
    android:layout_height="320dp"
    android:background="@android:color/black">

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/arrow_up"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintDimensionRatio="1:1"
        app:srcCompat="@drawable/ic_plus_yellow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.02"
        app:layout_constraintTop_toTopOf="parent" />

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/arrow_down"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintDimensionRatio="1:1"
        app:srcCompat="@drawable/ic_minus_yellow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.98"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/lock_circle_background_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/lcd_background_interval_top"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintStart_toStartOf="@id/lock_circle"
        app:layout_constraintEnd_toEndOf="@id/lock_circle"
        app:layout_constraintTop_toTopOf="@id/lock_circle"
        app:layout_constraintBottom_toTopOf="@id/lock_circle_background_bottom"
        app:layout_constraintVertical_chainStyle="packed"

        />

    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatImageButton
        android:id="@+id/lock_circle_background_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/lcd_background_interval_bottom"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintStart_toStartOf="@id/lock_circle"
        app:layout_constraintEnd_toEndOf="@id/lock_circle"
        app:layout_constraintTop_toBottomOf="@id/lock_circle_background_top"
        app:layout_constraintBottom_toBottomOf="@id/lock_circle"
        app:layout_constraintVertical_chainStyle="packed"

        />

    <ProgressBar
        android:id="@+id/lock_circle"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:max="2000"
        android:progress="0"
        android:progressDrawable="@drawable/ic_lock_circle" />

    <LinearLayout
        android:id="@+id/value_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="@id/lock_circle_background_top"
        app:layout_constraintEnd_toEndOf="@id/lock_circle_background_top"
        app:layout_constraintBottom_toBottomOf="@id/lock_circle_background_top"
        app:layout_constraintTop_toTopOf="@id/lock_circle_background_top">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon"
            android:layout_width="25dp"
            android:layout_height="19dp"
            android:layout_marginBottom="-5dp"
            app:srcCompat="@drawable/ic_incline_yellow" />

        <TextView
            android:id="@+id/value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginBottom="-5dp"
            android:text="0"
            android:textSize="40dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/previous_value_picker"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/lock_circle_background_bottom"
        app:layout_constraintEnd_toEndOf="@id/lock_circle_background_bottom"
        app:layout_constraintTop_toTopOf="@id/lock_circle_background_bottom"
        app:layout_constraintBottom_toBottomOf="@id/lock_circle_background_bottom"
        android:gravity="center_horizontal"
        android:orientation="horizontal" >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_previous"
            android:layout_width="28dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginEnd="15dp"
            app:srcCompat="@drawable/ic_return_yellow"/>

        <TextView
            android:id="@+id/value_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="--"
            android:textSize="35dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <View
        android:id="@+id/flash_ok_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_lock_screen"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@id/lock_circle"
        app:layout_constraintEnd_toEndOf="@id/lock_circle"
        app:layout_constraintTop_toTopOf="@id/lock_circle"
        app:layout_constraintBottom_toBottomOf="@id/lock_circle"
        android:visibility="invisible"
        />

    <LinearLayout
        android:id="@+id/flash_ok_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="@id/flash_ok_background"
        app:layout_constraintEnd_toEndOf="@id/flash_ok_background"
        app:layout_constraintTop_toTopOf="@id/flash_ok_background"
        app:layout_constraintBottom_toBottomOf="@id/flash_ok_background"
        android:gravity="center"
        android:visibility="invisible"
        >

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flash_ok_icon"
        android:layout_width="28dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        app:srcCompat="@drawable/ic_return_yellow"/>

    <TextView
        android:id="@+id/flash_ok_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_gravity="center"
        android:text="@string/ok_uc"
        android:textSize="35dp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />
    </LinearLayout>


    <com.jht.mastboard.ui.hapticwidgets.HapticAppCompatButton
        android:id="@+id/lock_circle_background_touch_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@id/lock_circle"
        app:layout_constraintEnd_toEndOf="@id/lock_circle"
        app:layout_constraintTop_toTopOf="@id/lock_circle"
        app:layout_constraintBottom_toBottomOf="@id/lock_circle"
        android:background="@android:color/transparent"

        />
</androidx.constraintlayout.widget.ConstraintLayout>