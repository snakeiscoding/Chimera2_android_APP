<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/key_test_key_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">


        <TextView
            android:id="@+id/eng_service_date"
            style="@style/GeneralEngineeringTextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start" />

        <TextView
            android:id="@+id/eng_service_type"
            style="@style/GeneralEngineeringTextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start" />

        <TextView
            android:id="@+id/eng_service_distance"
            style="@style/GeneralEngineeringTextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start" />

        <TextView
            android:id="@+id/eng_service_time"
            style="@style/GeneralEngineeringTextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="start" />

        <TextView
            android:id="@+id/eng_service_description"
            style="@style/GeneralEngineeringTextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:singleLine="false"
            android:gravity="start" />


    </LinearLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <Button
            android:id="@+id/eng_service_log_delete"
            style="@style/GeneralEngineeringButton"
            android:layout_width="200dp"
            android:layout_centerInParent="true"
            android:text="@string/delete_tc" />
    </RelativeLayout>
</LinearLayout>
