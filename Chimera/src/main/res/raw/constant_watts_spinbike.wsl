settings
    workout_id = 20
    allow_skip_warmup = 0
    allow_skip_workout = 1
    graph_future = 0
    allow_user_goal_changes = 0

input WATTS
input TIME_GOAL_START
input TARGET_WATTS_START
input TARGET_WATTS
input COOLDOWN_TIME_START

export RESISTANCE
export GOAL
export GOAL_TYPE
export TARGET_WATTS
export PREVENT_USER_GOAL_CHANGES
export ERG_MODE

stage "warmup"
    interval
        PREVENT_USER_GOAL_CHANGES = 1
        GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
        GOAL = 120000
        RESISTANCE = 1
        ERG_MODE = 0
        TARGET_WATTS = TARGET_WATTS_START
        when INTERVAL_TIME_MS >= 120000
            interval = interval + 1

stage "workout"
    interval
        ERG_MODE = 1
        GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
        GOAL = TIME_GOAL_START
        PREVENT_USER_GOAL_CHANGES = 0

        when INTERVAL_TIME_MS >= GOAL
            interval = interval + 1
        
stage "cooldown"
    interval
        ERG_MODE = 0
        GOAL = COOLDOWN_TIME_START
        GOAL_TYPE = GOAL_TYPE_TIME_STAGE_CONSTANT
        RESISTANCE = 1
        
        when INTERVAL_TIME_MS >= GOAL
            end