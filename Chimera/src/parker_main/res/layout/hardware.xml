<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hardware_main_container"
    style="@style/EngineeringPage">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="false"
        android:scrollbarAlwaysDrawVerticalTrack="true">

        <androidx.gridlayout.widget.GridLayout style="@style/EngineeringPageGridLayout">

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_rfid_tag"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/rfid_tag_type_tc"
                app:read_only="true" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_hardware_rfid_tag_value"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/GeneralEditTextStringEngineering"
                app:label="@string/rfid_tag_scanned_tc"
                app:read_only="true" />


            <RelativeLayout
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                app:layout_columnSpan="@integer/eng_cols_per_page">

                <Button
                    android:id="@+id/eng_hardware_rfid_disassociate"
                    style="@style/GeneralEngineeringButton"
                    android:layout_width="200dp"
                    android:layout_centerInParent="true"
                    android:text="@string/disassociate_rfid_tag_tc" />
            </RelativeLayout>

            <RelativeLayout
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                android:id="@+id/colorTemperature"
                app:columnCount="3"
                app:layout_columnSpan="3">
                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="300dp"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/color_temperature_tc" />

                <RelativeLayout
                    android:layout_width="600dp"
                    android:layout_height="30dp">
                    <SeekBar
                        android:id="@+id/eng_hardware_color_temp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="9500"
                        android:min="3500" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/colorThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />
            </androidx.gridlayout.widget.GridLayout>

            <androidx.gridlayout.widget.GridLayout
                style="@style/EngineeringPageGridLayout"
                app:columnCount="3"
                app:layout_columnSpan="3">

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="300dp"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/backlight_brightness_tc" />

                <RelativeLayout
                    android:layout_width="300dp"
                    android:layout_height="30dp">

                    <SeekBar
                        android:id="@+id/eng_hardware_backlight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="100"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/backlightThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/master_volume_tc" />

                <RelativeLayout
                    android:layout_width="300dp"
                    android:layout_height="30dp">

                    <SeekBar
                        android:id="@+id/eng_hardware_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="15"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/volumeThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

                <TextView
                    android:visibility="gone"
                    tools:visibility="visible"
                    style="@style/GeneralEngineeringTextHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/tv_volume_tc" />

                <RelativeLayout
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_width="300dp"
                    android:layout_height="30dp">

                    <SeekBar
                        android:id="@+id/eng_hardware_tv_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:max="100"
                        android:min="0" />
                </RelativeLayout>

                <TextView
                    android:visibility="gone"
                    tools:visibility="visible"
                    style="@style/GeneralEngineeringTextHeading"
                    android:id="@+id/tvVolumeThumbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

            </androidx.gridlayout.widget.GridLayout>

            <RelativeLayout
                android:id="@+id/headphone_count_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headphone_count_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="3">

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_a_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/eng_hardware_headphone_insert_b_label"
                    android:text="@string/console_headphone_count_tc" />

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_b_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/eng_hardware_headphone_insert_a_label"
                    app:layout_constraintRight_toLeftOf="@id/eng_hardware_usb_attach_count_label"
                    android:text="@string/frame_headphone_count_tc" />

                <TextView
                    android:id="@+id/eng_hardware_usb_attach_count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/eng_hardware_headphone_insert_b_label"
                    app:layout_constraintRight_toRightOf="parent"
                    android:text="@string/usb_insertions_tc" />

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_a_label"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_a_label"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_a_label" />

                <TextView
                    android:id="@+id/eng_hardware_headphone_insert_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_b_label"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_b_label"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_b_label" />

                <TextView
                    android:id="@+id/eng_hardware_usb_attach_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/edit_text_label_size"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_usb_attach_count_label"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_usb_attach_count_label"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_usb_attach_count_label" />

                <Button
                    android:id="@+id/eng_hardware_insert_a_reset"
                    style="@style/GeneralEngineeringButton"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_a"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_a"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_a"
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:text="@string/reset_tc" />

                <Button
                    android:id="@+id/eng_hardware_insert_b_reset"
                    style="@style/GeneralEngineeringButton"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_headphone_insert_b"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_headphone_insert_b"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_headphone_insert_b"
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:text="@string/reset_tc" />

                <Button
                    android:id="@+id/eng_hardware_usb_attach_reset"
                    style="@style/GeneralEngineeringButton"
                    app:layout_constraintLeft_toLeftOf="@id/eng_hardware_usb_attach_count"
                    app:layout_constraintRight_toRightOf="@id/eng_hardware_usb_attach_count"
                    app:layout_constraintTop_toBottomOf="@id/eng_hardware_usb_attach_count"
                    android:layout_marginTop="20dp"
                    android:layout_width="wrap_content"
                    android:text="@string/reset_tc" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:id="@+id/timeout_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                android:visibility="gone"
                tools:visibility="visible"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/timeout_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="3"
                android:visibility="gone"
                tools:visibility="visible"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:gravity="center_vertical"
                    >
                    <RadioGroup
                        android:id="@+id/timeout_selection"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        >
                        <RadioButton
                            android:id="@+id/hardware_energy_saver_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/energy_saver_tc"
                            android:textSize="21sp"
                            android:layout_marginBottom="15dp"
                            />
                        <RadioButton
                            android:id="@+id/hardware_screen_saver_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sleep_mode_tc"
                            android:textSize="21sp"
                            android:layout_marginBottom="15dp"
                            />
                        <RadioButton
                            android:id="@+id/hardware_demo_mode_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/demo_video_tc"
                            android:textSize="21sp"
                            />
                        <RadioButton
                            android:id="@+id/hardware_none_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/none_tc"
                            android:textSize="21sp"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:layout_marginTop="15dp"
                            />
                    </RadioGroup>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        >
                        <com.jht.androiduiwidgets.edittext.UserTextInput
                            android:id="@+id/demo_mode_input"
                            style="@style/GeneralEditTextStringEngineering"
                            android:imeOptions="actionDone"
                            app:input_type="integer_input"
                            app:label="@string/start_after_tc"
                            app:max_chars="2"
                            app:max_value="60"
                            app:min_value="1"
                            app:units="time_minutes"
                            android:visibility="invisible"
                            tools:visibility="visible"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                        <com.jht.androiduiwidgets.edittext.UserTextInput
                            android:id="@+id/energy_saver_input"
                            style="@style/GeneralEditTextStringEngineering"
                            android:imeOptions="actionDone"
                            app:input_type="integer_input"
                            app:label="@string/start_after_tc"
                            app:max_chars="2"
                            app:max_value="60"
                            app:min_value="1"
                            app:units="time_minutes"
                            android:visibility="invisible"
                            tools:visibility="visible"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginTop="-4dp"
                        >

                        <com.jht.androiduiwidgets.selector.OptionSelectorItem
                            android:id="@+id/eng_hardware_erp_type"
                            style="@style/GeneralEngineeringOptionSelector"
                            app:label="@string/options_uc"
                            app:option_popup_width="400dp" />
                        <Space
                            android:id="@+id/eng_hardware_erp_type_space1"
                            style="@style/GeneralEngineeringOptionSelector" />
                        <Space
                            android:id="@+id/eng_hardware_erp_type_space2"
                            style="@style/GeneralEngineeringOptionSelector" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/machine_settings_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_columnSpan="3"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >
                    <LinearLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        >
                        <CheckBox
                            android:id="@+id/eng_hardware_key_beeps"
                            style="@style/jht_checkbox"
                            android:text="@string/key_beep_tc"
                            />
                        <CheckBox
                            android:id="@+id/eng_ftms_enabled"
                            style="@style/jht_checkbox"
                            android:text="@string/enable_bt_ftms_tc"
                            />
                        <CheckBox
                            android:id="@+id/eng_hardware_countdown_beeps"
                            style="@style/jht_checkbox"
                            android:text="@string/workout_countdown_beep_tc"
                            />
                        <CheckBox
                            android:id="@+id/eng_hardware_ignore_incline_errors"
                            style="@style/jht_checkbox"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:text="@string/ignore_incline_errors_tc"
                            />
                        <CheckBox
                            android:id="@+id/eng_hardware_ignore_b_errors"
                            style="@style/jht_checkbox"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:text="@string/ignore_b_level_errors_tc"
                            />
                        <CheckBox
                            android:id="@+id/eng_hardware_pfc_mode"
                            style="@style/jht_checkbox"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:text="@string/pfc_mode_tc"
                            />
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_height="wrap_content"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        >
                        <com.jht.androiduiwidgets.edittext.UserTextInput
                            android:id="@+id/eng_ftms_name"
                            style="@style/GeneralEditTextStringEngineering"
                            android:imeOptions="actionDone"
                            app:label="@string/machine_name_tc"
                            app:max_chars="10"
                            app:min_chars="0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:id="@+id/energy_erp_demo_break"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_hardware_erp_mode"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="@string/energy_saver_tc"
                app:option_popup_width="400dp" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_erp_time"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/GeneralEditTextStringEngineering"
                android:layout_marginBottom="10dp"
                android:imeOptions="actionDone"
                app:input_type="time_clock"
                app:label="@string/erp_time_tc"
                app:picker_animation="@style/EngTimeHardwareDialogAnimation" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_erp_timeout"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:input_type="integer_input"
                app:label="@string/energy_savert_timeout_tc"
                app:max_value="60"
                app:min_value="1"
                app:max_chars="2"
                app:units="time_minutes" />

<!--            <CheckBox-->
<!--                android:id="@+id/eng_promotional_video"-->
<!--                style="@style/GeneralEngineeringCheckBox"-->
<!--                app:layout_gravity="center_vertical"-->
<!--                android:text="@string/demo_video_tc" />-->

<!--            <com.jht.androiduiwidgets.edittext.UserTextInput-->
<!--                android:id="@+id/eng_promotional_video_timeout"-->
<!--                style="@style/GeneralEditTextIntEngineering"-->
<!--                android:imeOptions="actionDone"-->
<!--                app:input_type="integer_input"-->
<!--                app:max_value="60"-->
<!--                app:min_value="1"-->
<!--                app:max_chars="2"-->
<!--                app:units="time_minutes" />-->

            <!-- Lube belt/chain stuff -->

            <LinearLayout
                android:id="@+id/belt_lube_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnSpan="3"
                android:visibility="visible"
                >

                <!-- For now, belt = treadmill = lube every X kilometers -->

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="20dp"
                    />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="#ffffff"
                    />

                    <TextView
                        android:id="@+id/accumulated_distance_since_lube_label"
                        style="@style/SettingsText"
                        android:layout_width="fill_parent"
                        android:text="@string/last_lube_distance_tc"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="right"
                        >

                        <TextView
                            android:id="@+id/accumulated_distance_since_lube_value"
                            style="@style/SettingsButtonEdit"
                            android:layout_width="300dp"
                            android:enabled="false" />

                        <Button
                            android:id="@+id/reset_lube_distance_button"
                            style="@style/SettingsButtonReset"
                            android:text="@string/reset_tc"
                            />
                    </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/chain_lube_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_columnSpan="3"
                android:visibility="visible"
                >

                <!-- For now, chain = climbmill = lube every X hours -->

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="20dp"
                    />

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1dp"
                    android:background="#ffffff"
                    />

                <TextView
                    android:id="@+id/accumulated_time_since_lube_label"
                    style="@style/SettingsText"
                    android:layout_width="fill_parent"
                    android:text="@string/last_lube_time_tc"
                    />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right">

                    <TextView
                        android:id="@+id/accumulated_time_since_lube_value"
                        style="@style/SettingsButtonEdit"
                        android:layout_width="300dp"
                        android:enabled="false" />

                    <Button
                        android:id="@+id/reset_lube_time_button"
                        style="@style/SettingsButtonReset"
                        android:text="@string/reset_tc"
                        />
                </LinearLayout>
            </LinearLayout>

            <RelativeLayout
                style="@style/engineering_line_break"
                android:visibility="gone"
                tools:visibility="visible"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <CheckBox
                android:id="@+id/eng_ant_plus_enabled"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_ant_plus_tc" />

            <com.jht.androiduiwidgets.edittext.UserTextInput
                android:id="@+id/eng_ant_plus_id"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/GeneralEditTextIntEngineering"
                android:imeOptions="actionDone"
                app:label="ANT+ Id"
                app:max_value="32767"
                app:min_value="1" />

<!--            <com.jht.androiduiwidgets.edittext.UserTextInput-->
<!--                android:id="@+id/eng_ant_plus_page"-->
<!--                style="@style/GeneralEditTextIntEngineering"-->
<!--                android:imeOptions="actionDone"-->
<!--                app:label="ANT+ Page"-->
<!--                app:max_value="2"-->
<!--                app:min_value="1" />-->
            <com.jht.androiduiwidgets.selector.OptionSelectorItem
                android:id="@+id/eng_ant_plus_page"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/GeneralEngineeringOptionSelector"
                app:label="ANT+ Protocol"
                app:option_popup_width="400dp" />

            <RelativeLayout
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <RelativeLayout
                android:id="@+id/engineering_line_break"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/engineering_line_break"
                app:layout_columnSpan="@integer/eng_cols_per_page" />

            <CheckBox
                android:id="@+id/eng_hardware_enable_oc"
                android:visibility="gone"
                tools:visibility="visible"
                style="@style/GeneralEngineeringCheckBox"
                android:text="@string/enable_over_current_protection_tc" />

            <RelativeLayout
                android:id="@+id/eng_hardware_motor_type_line"
                style="@style/engineering_line_break"
