<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/right_side_background"
    tools:context="com.jht.chimera.ui.mymedia.UsbLibraryFragment">

    <LinearLayout
        android:id="@+id/ll_usb_library_title"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/title_bar_background"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">

            <ImageButton
                android:id="@+id/ib_show_menu_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/menu_selector" />

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:text="JHT RD iPhone X"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="horizontal"
            android:gravity="end|bottom">

            <ImageView
                android:id="@+id/my_media_busy_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="20dp"
                app:srcCompat="@drawable/icon_spinner" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/ib_audio_tab"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:background="@drawable/tab_button_selector"
                app:tint="@color/tab_button_tint"
                app:srcCompat="@drawable/svg_ic_audio" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/ib_video_tab"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/tab_button_selector"
                app:tint="@color/tab_button_tint"
                app:srcCompat="@drawable/svg_ic_video" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_media_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/fl_audio_player_controller"
            android:name="com.jht.chimera.ui.mymedia.AudioPlayerController"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="FragmentTagUsage" />

        <fragment
            android:id="@+id/fl_video_player_controller"
            android:name="com.jht.chimera.ui.mymedia.VideoPlayerController"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:ignore="FragmentTagUsage" />

    </FrameLayout>

</LinearLayout>
