FEMALE_VALUES_2 = [705, 723, 784, 812, 842, 843, 896, 919, 946, 967, 992, 1015, 1042, 1074, 1103, 1138, 1181, 1236, 1335, 7200]
FEMALE_VALUES_3 = [719, 777, 819, 861, 892, 921, 946, 971, 998, 1025, 1051, 1075, 1085, 1099, 1159, 1193, 1241, 1311, 1408, 7200]
FEMALE_VALUES_4 = [739, 805, 843, 884, 914, 942, 981, 1003, 1030, 1058, 1086, 1112, 1143, 1180, 1210, 1247, 1287, 1347, 1443, 7200]
FEMALE_VALUES_5 = [775, 872, 903, 952, 987, 1014, 1037, 1056, 1080, 1098, 1125, 1150, 1175, 1200, 1230, 1272, 1323, 1391, 1515, 7200]
FEMALE_VALUES_6 = [849, 932, 981, 1003, 1029, 1054, 1101, 1125, 1144, 1158, 1178, 1197, 1226, 1252, 1269, 1317, 1348, 1428, 1500, 7200]
FEMALE_VALUES_7 = [922, 999, 1056, 1119, 1152, 1168, 1185, 1227, 1250, 1251, 1276, 1328, 1356, 1382, 1389, 1440, 1482, 1586, 1686, 7200]

SCORES = [95.0, 90.0, 85.0, 80.0, 75.0, 70.0, 65.0, 60.0, 55.0, 50.0, 45.0, 40.0, 35.0, 30.0, 25.0, 20.0, 15.0, 10.0, 5.0, 0.0]

onStop
    if workoutCompleteTime > 0
        workoutTimeSec = workoutCompleteTime / 1000
        if AGE >= 0 && AGE <= 24
            i = 0  
            lookup_value = MALE_VALUES_1[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_1[i]
        else if AGE >= 25 && AGE <= 29
            i = 0  
            lookup_value = MALE_VALUES_2[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_2[i]
    
        else if AGE >= 30 && AGE <= 34
            i = 0  
            lookup_value = MALE_VALUES_3[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_3[i]
    
        else if AGE >= 35 && AGE <= 39
            i = 0  
            lookup_value = MALE_VALUES_4[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_4[i]
    
        else if AGE >= 40 && AGE <= 44
            i = 0  
            lookup_value = MALE_VALUES_5[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_5[i]
    
        else if AGE >= 45 && AGE <= 49
            i = 0  
            lookup_value = MALE_VALUES_6[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_6[i]
    
        else if AGE >= 50 && AGE <= 54
            i = 0  
            lookup_value = MALE_VALUES_7[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_7[i]
    
        else if AGE >= 55 && AGE <= 59
            i = 0  
            lookup_value = MALE_VALUES_8[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_8[i]
    
        else if AGE >= 60 && AGE <= 100
            i = 0  
            lookup_value = MALE_VALUES_9[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = MALE_VALUES_9[i]

        TEST_SCORE_MALE = temp_score

    // Female Scoring
        if AGE >= 0 && AGE <= 24
            i = 0  
            lookup_value = FEMALE_VALUES_1[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = FEMALE_VALUES_1[i]
    
        else if AGE >= 25 && AGE <= 29
            i = 0  
            lookup_value = FEMALE_VALUES_2[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = FEMALE_VALUES_2[i]
    
        else if AGE >= 30 && AGE <= 34
            i = 0  
            lookup_value = FEMALE_VALUES_3[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = FEMALE_VALUES_3[i]
    
        else if AGE >= 35 && AGE <= 39
            i = 0  
            lookup_value = FEMALE_VALUES_4[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = FEMALE_VALUES_4[i]
    
        else if AGE >= 40 && AGE <= 44
            i = 0  
            lookup_value = FEMALE_VALUES_5[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = FEMALE_VALUES_5[i]
    
        else if AGE >= 45 && AGE <= 49
            i = 0  
            lookup_value = FEMALE_VALUES_6[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = FEMALE_VALUES_6[i]
    
        else if AGE >= 50 && AGE <= 100
            i = 0  
            lookup_value = FEMALE_VALUES_7[i]
            temp_score = SCORES[i]
            while  workoutTimeSec > lookup_value 
                temp_score = SCORES[i]
                i = i + 1  
                lookup_value = FEMALE_VALUES_7[i]

        TEST_SCORE_FEMALE = temp_score

    else
        TEST_SCORE_MALE = 0
        TEST_SCORE_FEMALE = 0

