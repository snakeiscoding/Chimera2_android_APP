<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="#C0262626"
    tools:showIn="@layout/engineering_screen">

    <com.jht.chimera.lib.widget.button.HomeButton
        android:id="@+id/eng_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@android:color/transparent"
        android:layout_width="@dimen/side_bar_button_width"
        android:layout_height="@dimen/top_bar_height" />


    <TextView
        android:id="@+id/machine_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="42dp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:layout_centerInParent="true"
        android:text="@string/machine_settings_tc"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:gravity="center" />

    <com.jht.chimera.lib.widget.indicator.TopBarWifiIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginEnd="10dp" />
</androidx.constraintlayout.widget.ConstraintLayout>