<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp" android:layout_height="150dp"
    android:gravity="top"
    android:orientation="vertical">


    <!-- Note MES equivalent is active_app_item.xml/inactive_app_item.xml -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/appIconImage"
        android:layout_width="@dimen/gridview_icon_size"
        android:layout_height="@dimen/gridview_icon_size"
        android:src="@drawable/app_icon_overlay"
        android:layout_gravity="center"
        app:shapeAppearanceOverlay="@style/AppIconRoundedCorners"
        app:strokeWidth="1dp"
        app:strokeColor="#4C4C4C"
        />


    <TextView
        android:id="@+id/appIconText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="5dp"
        android:gravity="center_horizontal"
        android:textColor="@color/workout_app_name_color_selector"
        android:maxLines="2"
        android:ellipsize="end"/>
</LinearLayout>
